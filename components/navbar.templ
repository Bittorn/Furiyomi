package components

templ css() {
	<style>
        .nav__cont {
            position: fixed;
            width: 60px;
            top: 2vh;
            left: 1rem;
            height: 94vh;
            z-index: 100;
            background-color: var(--header-bg-color);
            overflow: hidden;
            box-shadow: 0 2px 10px var(--shadow-color);
            border-radius: 16px;
            backdrop-filter: blur(8px);
        }
        .nav__cont .nav {
            list-style-type: none;
            display: flexbox;
        }
        .nav__cont .nav li {
            margin-left: 24px;
            padding-top: 1rem;
            padding-bottom: 1rem;
        }
        .nav__cont .nav li span {
            display: none;
        }
        .nav__cont .nav li:first-child {
            margin-bottom: 1.5rem;
        }
        .nav__cont .nav li:first-child a {
            color: var(--button-color);
            font-weight: 700;
            font-size: large;
        }
        .nav__cont .nav li:first-child a:hover {
            color: var(--button-hover-color);
        }
        .nav__cont .nav li:last-child {
            position: absolute;
            bottom: 2.5rem;
        }
        .nav__cont .nav svg {
            width: 32px;
            height: 32px;
            right: 49.5px;
            top: 11px;
            position: relative;
            padding-right: 4px;
        }
        .nav__cont:hover {
            width: 160px;
            text-align: left;
        }
        .nav__cont:hover .nav {
            padding-left: 0;
        }
        .nav__cont:hover .nav li {
            margin-right: 24px;
            margin-left: 14.5px;
        }
        .nav__cont:hover .nav li span {
            display: inline;
        }
        .nav__cont:hover .nav svg {
            right: 0;
        }
    </style>
}

templ navlink(href string) {
	// TODO implement checking whether we are selected
	<li>
		<a href={ templ.URL(href) }>
			{ children... }
		</a>
	</li>
}

templ Navbar() {
	@css()
	<nav class="nav__cont">
		<ul class="nav">
			@navlink("/") {
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
					<path
						fill="currentColor"
						d="M4 3a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-9.303l2.021 9.51a1 1 0 0 0 1.186.77l2.935-.623a1 1 0 0 0 .77-1.186l-2.91-13.694a1 1 0 0 0-1.187-.77L15 5.302V5a1 1 0 0 0-1-1H9a1 1 0 0 0-1-1zm5 3h4v8H9zm4 10v3H9v-3zm-6 1v2H5v-2zm11.77 1.814l-.416-1.956l.978-.208l.416 1.956z"
					></path>
				</svg>
				<span>Furiyomi</span>
			}
			@navlink("/titles") {
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
					<path
						fill="currentColor"
						d="M13 21v2h-2v-2H3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h6a4 4 0 0 1 3 1.354A4 4 0 0 1 15 3h6a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1zm7-2V5h-5a2 2 0 0 0-2 2v12zm-9 0V7a2 2 0 0 0-2-2H4v14z"
					></path>
				</svg>
				<span>Titles</span>
			}
			@navlink("/upload") {
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
					<path
						fill="currentColor"
						d="m12 12.586l4.243 4.242l-1.415 1.415L13 16.415V22h-2v-5.587l-1.828 1.83l-1.415-1.415zM12 2a7 7 0 0 1 6.954 6.194A5.5 5.5 0 0 1 18 18.978v-2.014a3.5 3.5 0 1 0-1.111-6.91a5 5 0 1 0-9.777 0a3.5 3.5 0 0 0-1.292 6.88l.18.03v2.014a5.5 5.5 0 0 1-.954-10.784A7 7 0 0 1 12 2"
					></path>
				</svg>
				<span>Upload</span>
			}
			@navlink("/about") {
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
					<path
						fill="currentColor"
						d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10s-4.477 10-10 10m0-2a8 8 0 1 0 0-16a8 8 0 0 0 0 16M11 7h2v2h-2zm0 4h2v6h-2z"
					></path>
				</svg>
				<span>About</span>
			}
			@navlink("/dashboard") {
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
					<path
						fill="currentColor"
						d="M3 10a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1zm8 10a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1h-8a1 1 0 0 0-1 1zm2-5h6v4h-6zM3 20a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1zm2-1v-4h2v4zM5 9V5h6v4zm15 2a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1zm-1-2h-2V5h2z"
					></path>
				</svg>
				<span>Dashboard</span>
			}
		</ul>
	</nav>
}
