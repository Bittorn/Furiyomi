package components

templ Base(title string) {
    <!DOCTYPE html>
    <html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="author" content="Wind Tempos" />
		<meta name="google" content="notranslate" />
		<title>{title}</title>
	</head>
	<body>
		{children...}
	</body>
</html>
}