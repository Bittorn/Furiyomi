{"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [594, 194, 755, 562], "vertical": true, "font_size": 28, "lines_coords": [[[726.0, 196.0], [754.0, 196.0], [754.0, 488.0], [726.0, 488.0]], [[688.0, 198.0], [716.0, 198.0], [716.0, 426.0], [688.0, 426.0]], [[656.0, 196.0], [684.0, 196.0], [684.0, 540.0], [656.0, 540.0]], [[622.0, 194.0], [650.0, 194.0], [652.0, 562.0], [624.0, 562.0]], [[594.0, 196.0], [620.0, 196.0], [620.0, 410.0], [594.0, 410.0]]], "lines": ["先日、私のアシスタントを", "してくれている方が", "「登場人物が自分の描く背景で", "楽しそうにしているのが嬉しい」", "と言っていました。"]}, {"box": [74, 194, 136, 474], "vertical": true, "font_size": 26, "lines_coords": [[[108.0, 194.0], [134.0, 194.0], [134.0, 474.0], [108.0, 474.0]], [[74.0, 194.0], [100.0, 194.0], [100.0, 460.0], [74.0, 460.0]]], "lines": ["そこで改めて考えてみて", "思ったことがあります。"]}, {"box": [1138, 622, 1288, 979], "vertical": true, "font_size": 31, "lines_coords": [[[1254.0, 626.0], [1288.0, 626.0], [1288.0, 890.0], [1254.0, 890.0]], [[1216.0, 622.0], [1244.0, 622.0], [1244.0, 976.0], [1216.0, 976.0]], [[1174.0, 622.0], [1208.0, 622.0], [1208.0, 902.0], [1174.0, 902.0]], [[1138.0, 622.0], [1166.0, 622.0], [1166.0, 808.0], [1138.0, 808.0]]], "lines": ["『ロンリーガールに", "逆らえない。５巻を読んで", "いただきありがとう", "ございます！"]}, {"box": [578, 650, 740, 1094], "vertical": true, "font_size": 26, "lines_coords": [[[710.0, 652.0], [738.0, 652.0], [738.0, 1094.0], [710.0, 1094.0]], [[670.0, 652.0], [698.0, 652.0], [698.0, 1058.0], [670.0, 1058.0]], [[640.0, 652.0], [666.0, 652.0], [666.0, 1072.0], [640.0, 1072.0]], [[608.0, 650.0], [636.0, 650.0], [634.0, 1034.0], [606.0, 1034.0]], [[580.0, 654.0], [602.0, 654.0], [602.0, 790.0], [580.0, 790.0]]], "lines": ["当たり前ですが、私が物語を描くことで", "「本田空」や「桜井彩花」という人物が", "生まれますが、読みんでくれる人がいて、", "初めて登場人物が「生きる」のだと", "思いました。"]}, {"box": [545, 1208, 774, 1826], "vertical": true, "font_size": 31, "lines_coords": [[[736.0, 1208.0], [770.0, 1208.0], [770.0, 1556.0], [736.0, 1556.0]], [[698.0, 1208.0], [732.0, 1208.0], [730.0, 1826.0], [696.0, 1826.0]], [[660.0, 1208.0], [688.0, 1208.0], [688.0, 1702.0], [660.0, 1702.0]], [[624.0, 1210.0], [652.0, 1210.0], [652.0, 1778.0], [624.0, 1778.0]], [[580.0, 1208.0], [614.0, 1208.0], [616.0, 1642.0], [582.0, 1642.0]], [[546.0, 1208.0], [574.0, 1208.0], [574.0, 1578.0], [546.0, 1578.0]]], "lines": ["なのでロンガルを読んで、", "二人や周りの人物たちの世界を広げて下さる", "読者の皆様にはそうういった意味でも", "とっても感謝だなぁ〜！と思いました！！", "いつもありがとうございます！", "次巻もお楽しみに～～～！！"]}, {"box": [132, 1170, 457, 1388], "vertical": false, "font_size": 82, "lines_coords": [[[158.0, 1208.0], [414.0, 1204.0], [416.0, 1290.0], [160.0, 1294.0]], [[148.0, 1310.0], [426.0, 1290.0], [432.0, 1368.0], [154.0, 1388.0]]], "lines": ["Ｐｅｃｉａ", "Ｔｈａｎｋｓ．"]}, {"box": [106, 1478, 470, 1602], "vertical": false, "font_size": 51.0, "lines_coords": [[[114.0, 1484.0], [438.0, 1478.0], [438.0, 1526.0], [114.0, 1532.0]], [[106.0, 1548.0], [470.0, 1540.0], [470.0, 1594.0], [106.0, 1602.0]]], "lines": ["☆担当の内藤様", "☆デザインの菅原様"]}, {"box": [122, 1652, 484, 1852], "vertical": false, "font_size": 54.666666666666664, "lines_coords": [[[122.0, 1658.0], [484.0, 1652.0], [484.0, 1712.0], [122.0, 1718.0]], [[122.0, 1738.0], [430.0, 1738.0], [430.0, 1794.0], [122.0, 1794.0]], [[132.0, 1804.0], [352.0, 1800.0], [352.0, 1848.0], [132.0, 1852.0]]], "lines": ["ミアシスタントの方へと", "☆サクタローさん", "銀水野さん"]}, {"box": [134, 1866, 332, 1908], "vertical": false, "font_size": 42, "lines_coords": [[[134.0, 1866.0], [332.0, 1866.0], [332.0, 1908.0], [134.0, 1908.0]]], "lines": ["おざーさん"]}]}