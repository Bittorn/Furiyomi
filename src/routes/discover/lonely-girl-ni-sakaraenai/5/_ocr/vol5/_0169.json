{"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [551, 63, 888, 141], "vertical": false, "font_size": 59, "lines_coords": [[[564.0, 71.0], [872.0, 67.0], [872.0, 131.0], [564.0, 135.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [217, 713, 484, 761], "vertical": false, "font_size": 30, "lines_coords": [[[226.0, 718.0], [468.0, 720.0], [468.0, 750.0], [226.0, 748.0]]], "lines": ["．．．．．"]}, {"box": [186, 814, 780, 906], "vertical": false, "font_size": 22.0, "lines_coords": [[[188.0, 814.0], [408.0, 814.0], [408.0, 834.0], [188.0, 834.0]], [[190.0, 848.0], [510.0, 848.0], [510.0, 868.0], [190.0, 868.0]], [[186.0, 878.0], [780.0, 880.0], [780.0, 906.0], [186.0, 904.0]]], "lines": ["「空が転校してしまう．．．」", "一時はあきらめかけた彩花だったが、", "兄とクラスメイトに背中を押され、空の母親へ直談判することに。"]}, {"box": [184, 948, 882, 1042], "vertical": false, "font_size": 26.666666666666668, "lines_coords": [[[186.0, 948.0], [882.0, 948.0], [882.0, 974.0], [186.0, 974.0]], [[184.0, 978.0], [838.0, 980.0], [838.0, 1008.0], [184.0, 1006.0]], [[186.0, 1016.0], [638.0, 1016.0], [638.0, 1042.0], [186.0, 1042.0]]], "lines": ["ただのクラスメイトのワガママかもしれない、それでも空と離れたくない．．。", "自分の想いを素直にぶつけた彩花を見て、、空も自分の本心を吐露すると、", "空の母親は「勝手になさい」と諦めて去っていく。"]}, {"box": [186, 1052, 736, 1072], "vertical": false, "font_size": 20, "lines_coords": [[[186.0, 1052.0], [736.0, 1052.0], [736.0, 1072.0], [186.0, 1072.0]]], "lines": ["二人は互いに想いを伝え合い、晴れて恋人になったのだった。"]}, {"box": [188, 1332, 564, 1388], "vertical": false, "font_size": 23.0, "lines_coords": [[[188.0, 1332.0], [564.0, 1332.0], [564.0, 1358.0], [188.0, 1358.0]], [[188.0, 1368.0], [484.0, 1368.0], [484.0, 1388.0], [188.0, 1388.0]]], "lines": ["うかつな委員長とアンニユイ問題児（？）、", "二人の秘密な青春ラブコメディ！"]}, {"box": [184, 1118, 836, 1288], "vertical": false, "font_size": 25.6, "lines_coords": [[[184.0, 1118.0], [614.0, 1118.0], [614.0, 1144.0], [184.0, 1144.0]], [[184.0, 1150.0], [836.0, 1154.0], [836.0, 1180.0], [184.0, 1176.0]], [[186.0, 1188.0], [596.0, 1190.0], [596.0, 1218.0], [186.0, 1216.0]], [[186.0, 1230.0], [544.0, 1230.0], [544.0, 1256.0], [186.0, 1256.0]], [[188.0, 1264.0], [536.0, 1266.0], [536.0, 1288.0], [188.0, 1286.0]]], "lines": ["穏やかな恋人としての生活を続けていたある日、", "本番で緊張してしまう彩花の体質をお客するため、空が言いだしたのは", "「模試で目標点行かなかったら、", "１ヵ月わたしに触るの禁止」", "という彩花にとっては過酷な内容で．．．。"]}, {"box": [678, 1932, 840, 1966], "vertical": false, "font_size": 34, "lines_coords": [[[678.0, 1932.0], [840.0, 1932.0], [840.0, 1966.0], [678.0, 1966.0]]], "lines": ["一・裏表紙"]}, {"box": [480, 1992, 946, 2018], "vertical": false, "font_size": 26, "lines_coords": [[[480.0, 1992.0], [946.0, 1992.0], [946.0, 2018.0], [480.0, 2018.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}]}