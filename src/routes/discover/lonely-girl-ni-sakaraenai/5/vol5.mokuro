4, "lines_coords": [[[1056.0, 508.0], [1154.0, 508.0], [1154.0, 544.0], [1056.0, 544.0]]], "lines": ["樫"]}, {"box": [988, 596, 1220, 718], "vertical": false, "font_size": 24, "lines_coords": [[[1016.0, 596.0], [1192.0, 600.0], [1192.0, 620.0], [1016.0, 616.0]], [[1032.0, 630.0], [1176.0, 630.0], [1176.0, 652.0], [1032.0, 652.0]], [[1020.0, 664.0], [1192.0, 664.0], [1192.0, 684.0], [1020.0, 684.0]], [[988.0, 696.0], [1220.0, 694.0], [1220.0, 716.0], [988.0, 718.0]]], "lines": ["最近家で運動するために", "アイドルのダンスを", "一心不乱に踊っています", "楽しく汗がかけておススメです。"]}, {"box": [216, 377, 701, 1715], "vertical": false, "font_size": 24, "lines_coords": [[[646.0, 446.0], [690.0, 446.0], [690.0, 474.0], [646.0, 474.0]], [[612.0, 516.0], [690.0, 516.0], [690.0, 534.0], [612.0, 534.0]], [[218.0, 514.0], [356.0, 514.0], [356.0, 538.0], [218.0, 538.0]], [[220.0, 548.0], [402.0, 548.0], [402.0, 572.0], [220.0, 572.0]], [[586.0, 552.0], [692.0, 552.0], [692.0, 576.0], [586.0, 576.0]], [[602.0, 586.0], [692.0, 586.0], [692.0, 612.0], [602.0, 612.0]], [[220.0, 588.0], [434.0, 588.0], [434.0, 612.0], [220.0, 612.0]], [[218.0, 624.0], [464.0, 624.0], [464.0, 648.0], [218.0, 648.0]], [[218.0, 658.0], [454.0, 658.0], [454.0, 688.0], [218.0, 688.0]], [[218.0, 696.0], [610.0, 698.0], [610.0, 724.0], [218.0, 722.0]], [[218.0, 732.0], [516.0, 734.0], [516.0, 764.0], [218.0, 762.0]], [[590.0, 736.0], [694.0, 732.0], [694.0, 764.0], [590.0, 768.0]], [[218.0, 774.0], [596.0, 774.0], [596.0, 798.0], [218.0, 798.0]], [[216.0, 808.0], [532.0, 808.0], [532.0, 838.0], [216.0, 838.0]], [[602.0, 810.0], [694.0, 810.0], [694.0, 836.0], [602.0, 836.0]], [[216.0, 846.0], [696.0, 846.0], [696.0, 876.0], [216.0, 876.0]], [[218.0, 882.0], [696.0, 882.0], [696.0, 912.0], [218.0, 912.0]], [[216.0, 920.0], [692.0, 918.0], [692.0, 948.0], [216.0, 950.0]], [[218.0, 960.0], [468.0, 960.0], [468.0, 984.0], [218.0, 984.0]], [[624.0, 960.0], [694.0, 960.0], [694.0, 984.0], [624.0, 984.0]], [[220.0, 998.0], [694.0, 998.0], [694.0, 1022.0], [