"だと", "良いな．．．"]}, {"box": [166, 350, 208, 460], "vertical": true, "font_size": 42, "lines_coords": [[[166.0, 350.0], [208.0, 350.0], [208.0, 460.0], [166.0, 460.0]]], "lines": ["空は？"]}, {"box": [1190, 778, 1281, 1018], "vertical": true, "font_size": 40, "lines_coords": [[[1240.0, 778.0], [1280.0, 778.0], [1280.0, 1018.0], [1240.0, 1018.0]], [[1190.0, 778.0], [1230.0, 778.0], [1230.0, 982.0], [1190.0, 982.0]]], "lines": ["今の彩花なら", "大丈夫だよ"]}, {"box": [620, 644, 732, 964], "vertical": true, "font_size": 32, "lines_coords": [[[698.0, 644.0], [732.0, 644.0], [732.0, 872.0], [698.0, 872.0]], [[656.0, 644.0], [690.0, 644.0], [692.0, 964.0], [658.0, 964.0]], [[620.0, 646.0], [648.0, 646.0], [648.0, 936.0], [620.0, 936.0]]], "lines": ["．．．わたしも彩花", "みたいにやりたいこと", "見つかるようにと．．．"]}, {"box": [1114, 1286, 1245, 1614], "vertical": true, "font_size": 39, "lines_coords": [[[1206.0, 1288.0], [1242.0, 1288.0], [1242.0, 1468.0], [1206.0, 1468.0]], [[1158.0, 1288.0], [1198.0, 1288.0], [1198.0, 1614.0], [1158.0, 1614.0]], [[1114.0, 1286.0], [1154.0, 1286.0], [1154.0, 1508.0], [1114.0, 1508.0]]], "lines": ["２年生でも", "同じクラスになれる", "ように．．．かな"]}, {"box": [774, 1406, 932, 1462], "vertical": false, "font_size": 56, "lines_coords": [[[774.0, 1406.0], [932.0, 1406.0], [932.0, 1462.0], [774.0, 1462.0]]], "lines": ["心配．"]}, {"box": [204, 1351, 252, 1466], "vertical": true, "font_size": 48, "lines_coords": [[[204.0, 1390.0], [252.0, 1390.0], [252.0, 1466.0], [204.0, 1466.0]]], "lines": ["！"]}], "img_path": "_0161.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [568, 94, 850, 128], "vertical": false, "font_size": 34, "lines_coords": [[[568.0, 94.0], [850.0, 94.0], [850.0, 128.0], [568.0, 128.0]]], "lines": ["おまけ『１０月１５日"]}, {"box": [422, 170, 641, 260], "vertical": false, "font_size": 32, "lines_coords": [[[438.0, 170.0], [634.0, 204.0], [628.0, 232.0], [432.0, 198.0]], [[428.0, 192.0], [610.0, 226.0], [604.0, 260.0], [422.0, 226.0]]], "lines": ["ごめん今日朝先生に", "呼び出されてて．．．"]}, {"box": [388, 276, 623, 382], "vertical": false, "font_size": 33, "lines_coords": [[[400.0, 278.0], [602.0, 316.0], [596.0, 346.0], [394.0, 308.0]], [[394.0, 304.0], [618.0, 348.0], [612.0, 382.0], [388.0, 338.0]]], "lines": ["結構早い時間だから", "先に学校行ってるね！"]}, {"box": [540, 434, 645, 488], "vertical": false, "font_size": 36, "lines_coords": [[[546.0, 434.0], [644.0, 452.0], [638.0, 488.0], [540.0, 470.0]]], "lines": ["分かった"]}, {"box": [596, 806, 679, 1056], "vertical": true, "font_size": 34, "lines_coords": [[[642.0, 810.0], [676.0, 810.0], [676.0, 1056.0], [642.0, 1056.0]], [[596.0, 806.0], [630.0, 806.0], [630.0, 966.0], [596.0, 966.0]]], "lines": ["一人で登校するの", "久々かも．．．"]}], "img_path": "_0162.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [746, 170, 822, 358], "vertical": true, "font_size": 35, "lines_coords": [[[780.0, 170.0], [822.0, 170.0], [822.0, 302.0], [780.0, 302.0]], [[746.0, 174.0], [774.0, 174.0], [774.0, 356.0], [746.0, 356.0]]], "lines": ["テープが", "多すぎたわね"]}, {"box": [480, 160, 592, 410], "vertical": true, "font_size": 32, "lines_coords": [[[556.0, 162.0], [590.0, 162.0], [590.0, 378.0], [556.0, 378.0]], [[518.0, 162.0], [552.0, 162.0], [552.0, 410.0], [518.0, 410.0]], [[484.0, 160.0], [512.0, 160.0], [508.0, 346.0], [480.0, 346.0]]], "lines": ["だから音だけの", "やつにしようって", "言ったじゃん"]}, {"box": [154, 188, 277, 350], "vertical": true, "font_size": 37, "lines_coords": [[[230.0, 192.0], [264.0, 192.0], [264.0, 350.0], [230.0, 350.0]], [[186.0, 188.0], [230.0, 188.0], [230.0, 292.0], [186.0, 292.0]], [[154.0, 190.0], [188.0, 190.0], [188.0, 346.0], [154.0, 346.0]]], "lines": ["千鶴も賛成", "してた", "くせにー！"]}, {"box": [1018, 604, 1056, 674], "vertical": true, "font_size": 38, "lines_coords": [[[1018.0, 604.0], [1056.0, 604.0], [1056.0, 674.0], [1018.0, 674.0]]], "lines": ["あ．．．"]}, {"box": [149, 852, 230, 994], "vertical": true, "font_size": 38, "lines_coords": [[[182.0, 852.0], [230.0, 852.0], [230.0, 936.0], [182.0, 936.0]], [[150.0, 862.0], [178.0, 862.0], [178.0, 994.0], [150.0, 994.0]]], "lines": ["．．．？", "なにこれ"]}, {"box": [1230, 1382, 1282, 1522], "vertical": true, "font_size": 42, "lines_coords": [[[1230.0, 1382.0], [1272.0, 1382.0], [1272.0, 1522.0], [1230.0, 1522.0]]], "lines": ["何って．．．"]}, {"box": [668, 1478, 758, 1642], "vertical": true, "font_size": 42, "lines_coords": [[[714.0, 1478.0], [756.0, 1478.0], [756.0, 1636.0], [714.0, 1636.0]], [[668.0, 1478.0], [710.0, 1478.0], [710.0, 1642.0], [668.0, 1642.0]]], "lines": ["お誕生日", "でしょ？"]}], "img_path": "_0163.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [500, 140, 600, 392], "vertical": true, "font_size": 55, "lines_coords": [[[548.0, 142.0], [600.0, 142.0], [600.0, 278.0], [548.0, 278.0]], [[500.0, 140.0], [542.0, 140.0], [542.0, 392.0], [500.0, 392.0]]], "lines": ["誕生日", "おめでとう！"]}, {"box": [372, 416, 442, 534], "vertical": true, "font_size": 55, "lines_coords": [[[372.0, 416.0], [442.0, 416.0], [442.0, 534.0], [372.0, 534.0]]], "lines": ["空！"]}, {"box": [750, 872, 796, 952], "vertical": true, "font_size": 46, "lines_coords": [[[750.0, 872.0], [796.0, 872.0], [796.0, 952.0], [750.0, 952.0]]], "lines": ["あ．．．"]}, {"box": [343, 839, 576, 1105], "vertical": true, "font_size": 233, "lines_coords": [[[343.0, 839.0], [576.0, 839.0], [576.0, 1105.0], [343.0, 1105.0]]], "lines": ["！！！"]}, {"box": [1226, 1192, 1266, 1392], "vertical": true, "font_size": 38, "lines_coords": [[[1226.0, 1194.0], [1264.0, 1194.0], [1264.0, 1392.0], [1226.0, 1392.0]]], "lines": ["ありがと．．"]}, {"box": [112, 1080, 220, 1244], "vertical": false, "font_size": 54, "lines_coords": [[[162.0, 1080.0], [220.0, 1224.0], [170.0, 1244.0], [112.0, 1100.0]]], "lines": ["いや無理"]}, {"box": [132, 1242, 226, 1382], "vertical": false, "font_size": 38, "lines_coords": [[[166.0, 1242.0], [226.0, 1364.0], [192.0, 1382.0], [132.0, 1260.0]]], "lines": ["やっとね．．．"]}], "img_path": "_0164.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [594, 194, 755, 562], "vertical": true, "font_size": 28, "lines_coords": [[[726.0, 196.0], [754.0, 196.0], [754.0, 488.0], [726.0, 488.0]], [[688.0, 198.0], [716.0, 198.0], [716.0, 426.0], [688.0, 426.0]], [[656.0, 196.0], [684.0, 196.0], [684.0, 540.0], [656.0, 540.0]], [[622.0, 194.0], [650.0, 194.0], [652.0, 562.0], [624.0, 562.0]], [[594.0, 196.0], [620.0, 196.0], [620.0, 410.0], [594.0, 410.0]]], "lines": ["先日、私のアシスタントを", "してくれている方が", "「登場人物が自分の描く背景で", "楽しそうにしているのが嬉しい」", "と言っていました。"]}, {"box": [74, 194, 136, 474], "vertical": true, "font_size": 26, "lines_coords": [[[108.0, 194.0], [134.0, 194.0], [134.0, 474.0], [108.0, 474.0]], [[74.0, 194.0], [100.0, 194.0], [100.0, 460.0], [74.0, 460.0]]], "lines": ["そこで改めて考えてみて", "思ったことがあります。"]}, {"box": [1138, 622, 1288, 979], "vertical": true, "font_size": 31, "lines_coords": [[[1254.0, 626.0], [1288.0, 626.0], [1288.0, 890.0], [1254.0, 890.0]], [[1216.0, 622.0], [1244.0, 622.0], [1244.0, 976.0], [1216.0, 976.0]], [[1174.0, 622.0], [1208.0, 622.0], [1208.0, 902.0], [1174.0, 902.0]], [[1138.0, 622.0], [1166.0, 622.0], [1166.0, 808.0], [1138.0, 808.0]]], "lines": ["『ロンリーガールに", "逆らえない。５巻を読んで", "いただきありがとう", "ございます！"]}, {"box": [578, 650, 740, 1094], "vertical": true, "font_size": 26, "lines_coords": [[[710.0, 652.0], [738.0, 652.0], [738.0, 1094.0], [710.0, 1094.0]], [[670.0, 652.0], [698.0, 652.0], [698.0, 1058.0], [670.0, 1058.0]], [[640.0, 652.0], [666.0, 652.0], [666.0, 1072.0], [640.0, 1072.0]], [[608.0, 650.0], [636.0, 650.0], [634.0, 1034.0], [606.0, 1034.0]], [[580.0, 654.0], [602.0, 654.0], [602.0, 790.0], [580.0, 790.0]]], "lines": ["当たり前ですが、私が物語を描くことで", "「本田空」や「桜井彩花」という人物が", "生まれますが、読みんでくれる人がいて、", "初めて登場人物が「生きる」のだと", "思いました。"]}, {"box": [545, 1208, 774, 1826], "vertical": true, "font_size": 31, "lines_coords": [[[736.0, 1208.0], [770.0, 1208.0], [770.0, 1556.0], [736.0, 1556.0]], [[698.0, 1208.0], [732.0, 1208.0], [730.0, 1826.0], [696.0, 1826.0]], [[660.0, 1208.0], [688.0, 1208.0], [688.0, 1702.0], [660.0, 1702.0]], [[624.0, 1210.0], [652.0, 1210.0], [652.0, 1778.0], [624.0, 1778.0]], [[580.0, 1208.0], [614.0, 1208.0], [616.0, 1642.0], [582.0, 1642.0]], [[546.0, 1208.0], [574.0, 1208.0], [574.0, 1578.0], [546.0, 1578.0]]], "lines": ["なのでロンガルを読んで、", "二人や周りの人物たちの世界を広げて下さる", "読者の皆様にはそうういった意味でも", "とっても感謝だなぁ〜！と思いました！！", "いつもありがとうございます！", "次巻もお楽しみに～～～！！"]}, {"box": [132, 1170, 457, 1388], "vertical": false, "font_size": 82, "lines_coords": [[[158.0, 1208.0], [414.0, 1204.0], [416.0, 1290.0], [160.0, 1294.0]], [[148.0, 1310.0], [426.0, 1290.0], [432.0, 1368.0], [154.0, 1388.0]]], "lines": ["Ｐｅｃｉａ", "Ｔｈａｎｋｓ．"]}, {"box": [106, 1478, 470, 1602], "vertical": false, "font_size": 51.0, "lines_coords": [[[114.0, 1484.0], [438.0, 1478.0], [438.0, 1526.0], [114.0, 1532.0]], [[106.0, 1548.0], [470.0, 1540.0], [470.0, 1594.0], [106.0, 1602.0]]], "lines": ["☆担当の内藤様", "☆デザインの菅原様"]}, {"box": [122, 1652, 484, 1852], "vertical": false, "font_size": 54.666666666666664, "lines_coords": [[[122.0, 1658.0], [484.0, 1652.0], [484.0, 1712.0], [122.0, 1718.0]], [[122.0, 1738.0], [430.0, 1738.0], [430.0, 1794.0], [122.0, 1794.0]], [[132.0, 1804.0], [352.0, 1800.0], [352.0, 1848.0], [132.0, 1852.0]]], "lines": ["ミアシスタントの方へと", "☆サクタローさん", "銀水野さん"]}, {"box": [134, 1866, 332, 1908], "vertical": false, "font_size": 42, "lines_coords": [[[134.0, 1866.0], [332.0, 1866.0], [332.0, 1908.0], [134.0, 1908.0]]], "lines": ["おざーさん"]}], "img_path": "_0165.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [214, 242, 908, 294], "vertical": false, "font_size": 46, "lines_coords": [[[214.0, 248.0], [908.0, 242.0], [908.0, 288.0], [214.0, 294.0]]], "lines": ["ロシリーガールに逆らえない。"]}, {"box": [555, 67, 887, 141], "vertical": false, "font_size": 59, "lines_coords": [[[564.0, 71.0], [872.0, 67.0], [872.0, 131.0], [564.0, 135.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [864, 414, 960, 452], "vertical": false, "font_size": 38, "lines_coords": [[[864.0, 414.0], [960.0, 414.0], [960.0,