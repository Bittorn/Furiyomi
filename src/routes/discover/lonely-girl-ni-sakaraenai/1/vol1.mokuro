134.0, 980.0]]], "lines": ["はじめまして樫風と申します。", "ここまで続んで頂きあリガそうございます。"]}, {"box": [843, 528, 879, 933], "vertical": true, "font_size": 28, "lines_coords": [[[843.0, 528.0], [873.0, 528.0], [879.0, 933.0], [849.0, 933.0]]], "lines": ["空様のおかげで「シャル」第１巻！！！"]}, {"box": [787, 528, 813, 922], "vertical": true, "font_size": 28, "lines_coords": [[[787.0, 528.0], [813.0, 528.0], [813.0, 922.0], [787.0, 922.0]]], "lines": ["出ちゃいました！人生私の早行本"]}, {"box": [607, 536, 734, 976], "vertical": true, "font_size": 31, "lines_coords": [[[697.0, 538.0], [729.0, 538.0], [733.0, 976.0], [701.0, 976.0]], [[652.0, 540.0], [680.0, 540.0], [678.0, 885.0], [650.0, 885.0]], [[611.0, 536.0], [643.0, 536.0], [639.0, 830.0], [607.0, 830.0]]], "lines": ["元々漫画の描き方と表示人から", "スタートしたので右も左も", "分かりませんでしたが、"]}, {"box": [446, 662, 476, 765], "vertical": true, "font_size": 26, "lines_coords": [[[446.0, 663.0], [472.0, 663.0], [476.0, 765.0], [450.0, 765.0]]], "lines": ["某人気漫画の"]}, {"box": [325, 524, 487, 565], "vertical": false, "font_size": 41, "lines_coords": [[[325.0, 524.0], [487.0, 524.0], [487.0, 565.0], [325.0, 565.0]]], "lines": ["特に色々教えてくんだ神の英雄"]}, {"box": [358, 661, 384, 758], "vertical": true, "font_size": 22, "lines_coords": [[[358.0, 665.0], [380.0, 665.0], [384.0, 755.0], [361.0, 755.0]]], "lines": ["マシスタント"]}, {"box": [131, 525, 250, 972], "vertical": true, "font_size": 28, "lines_coords": [[[217.0, 530.0], [243.0, 530.0], [247.0, 956.0], [221.0, 956.0]], [[174.0, 530.0], [206.0, 530.0], [206.0, 967.0], [174.0, 967.0]], [[131.0, 534.0], [157.0, 534.0], [157.0, 886.0], [131.0, 886.0]]], "lines": ["周りのいろんな方ヒアドバイスを", "頂き、試行錯誤しながらなんとか", "ここまでやって分かりました。"]}, {"box": [1147, 1025, 1179, 1479], "vertical": true, "font_size": 32, "lines_coords": [[[1147.0, 1025.0], [1179.0, 1025.0], [1179.0, 1479.0], [1147.0, 1479.0]]], "lines": ["またまた駆け出しではありますが、"]}, {"box": [1074, 1027, 1110, 1586], "vertical": true, "font_size": 32, "lines_coords": [[[1074.0, 1027.0], [1106.0, 1027.0], [1110.0, 1586.0], [1078.0, 1586.0]]], "lines": ["今後も目々精進しながら３頑張ります！"]}, {"box": [103, 1098, 401, 1436], "vertical": false, "font_size": 51.2, "lines_coords": [[[163.0, 1098.0], [335.0, 1098.0], [335.0, 1151.0], [163.0, 1151.0]], [[103.0, 1181.0], [361.0, 1170.0], [363.0, 1222.0], [105.0, 1233.0]], [[105.0, 1275.0], [397.0, 1254.0], [401.0, 1308.0], [108.0, 1327.0]], [[108.0, 1348.0], [330.0, 1340.0], [331.0, 1391.0], [110.0, 1398.0]], [[195.0, 1389.0], [346.0, 1383.0], [348.0, 1430.0], [196.0, 1436.0]]], "lines": ["そういえば、", "★担当の内藤様、", "★デザインの菅原様", "水に援して下さる", "美しくへこの読者の皆様"]}, {"box": [487, 1571, 551, 1736], "vertical": false, "font_size": 32, "lines_coords": [[[519.0, 1571.0], [551.0, 1730.0], [519.0, 1736.0], [487.0, 1576.0]]], "lines": ["リギル地地に"]}, {"box": [255, 1473, 425, 1507], "vertical": false, "font_size": 26, "lines_coords": [[[255.0, 1481.0], [425.0, 1473.0], [425.0, 1500.0], [255.0, 1507.0]]], "lines": ["くれるお母さん"]}, {"box": [108, 1440, 431, 1488], "vertical": false, "font_size": 32, "lines_coords": [[[108.0, 1456.0], [429.0, 1440.0], [431.0, 1471.0], [110.0, 1488.0]]], "lines": ["来たまたごはん食べさせて"]}, {"box": [232, 1548, 425, 1586], "vertical": false, "font_size": 27, "lines_coords": [[[232.0, 1560.0], [423.0, 1548.0], [425.0, 1575.0], [234.0, 1586.0]]], "lines": ["送ってくれるお父さん"]}, {"box": [110, 1515, 382, 1561], "vertical": false, "font_size": 33, "lines_coords": [[[110.0, 1528.0], [380.0, 1515.0], [382.0, 1548.0], [112.0, 1561.0]]], "lines": ["お支払い方法の登校の写真に"]}], "img_path": "00165.jpeg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [209, 345, 513, 561], "vertical": false, "font_size": 29, "lines_coords": [[[217.0, 397.0], [382.0, 397.0], [382.0, 427.0], [217.0, 427.0]], [[217.0, 440.0], [281.0, 440.0], [281.0, 472.0], [217.0, 472.0]], [[215.0, 481.0], [305.0, 481.0], [305.0, 513.0], [215.0, 513.0]], [[225.0, 526.0], [500.0, 526.0], [500.0, 557.0], [225.0, 557.0]]], "lines": ["・４月１０日生まれ", "・Ａ型", "・「５７ｃｍ」", "夢は私よこに選まれる事（）"]}, {"box": [515, 63, 833, 132], "vertical": false, "font_size": 55, "lines_coords": [[[528.0, 66.0], [815.0, 62.0], [815.0, 123.0], [528.0, 126.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [408, 225, 997, 262], "vertical": false, "font_size": 37, "lines_coords": [[[408.0, 225.0], [997.0, 225.0], [997.0, 262.0], [408.0, 262.0]]], "lines": ["シリーガールに逆らえない、"]}, {"box": [736, 391, 843, 436], "vertical": false, "font_size": 42, "lines_coords": [[[736.0, 395.0], [841.0, 391.0], [843.0, 433.0], [738.0, 436.0]]], "lines": ["一本田空"]}, {"box": [729, 309, 1048, 358], "vertical": false, "font_size": 45, "lines_coords": [[[729.0, 309.0], [1048.0, 313.0], [1048.0, 358.0], [729.0, 354.0]]], "lines": ["こんなわからなければ"]}, {"box": [736, 451, 905, 588], "vertical": false, "font_size": 27.75, "lines_coords": [[[742.0, 451.0], [905.0, 451.0], [905.0, 476.0], [742.0, 476.0]], [[738.0, 485.0], [819.0, 485.0], [819.0, 513.0], [738.0, 513.0]], [[736.0, 521.0], [823.0, 521.0], [823.0, 555.0], [736.0, 555.0]], [[738.0, 564.0], [905.0, 564.0], [905.0, 588.0], [738.0, 588.0]]], "lines": ["・１０月１５日生まれ", "・ＡＢ型", "・１５４ｃｈ", "・トマトが苦手でご"]}, {"box": [721, 1130, 873, 1153], "vertical": false, "font_size": 21, "lines_coords": [[[721.0, 1130.0], [873.0, 1132.0], [873.0, 1153.0], [721.0, 1151.0]]], "lines": ["ひよニまんじょう"]}, {"box": [805, 1313, 1071, 1561], "vertical": false, "font_size": 28, "lines_coords": [[[811.0, 1469.0], [890.0, 1469.0], [890.0, 1500.0], [811.0, 1500.0]], [[810.0, 1501.0], [1063.0, 1501.0], [1063.0, 1530.0], [810.0, 1530.0]], [[825.0, 1531.0], [1044.0, 1531.0], [1044.0, 1560.0], [825.0, 1560.0]]], "lines": ["・１７０ｃｍ", "・「．．．。「ミッチィ」というバドルネスで", "オンラインゲームに巻いている。"]}, {"box": [588, 1809, 757, 1841], "vertical": false, "font_size": 32, "lines_coords": [[[588.0, 1809.0], [757.0, 1809.0], [757.0, 1841.0], [588.0, 1841.0]]], "lines": ["本体・表紙"]}, {"box": [450, 1867, 888, 1891], "vertical": false, "font_size": 24, "lines_coords": [[[450.0, 1867.0], [888.0, 1867.0], [888.0, 1891.0], [450.0, 1891.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}, {"box": [1086, 1645, 1200, 1713], "vertical": false, "font_size": 74, "lines_coords": [[[1086.0, 1639.0], [1200.0, 1639.0], [1200.0, 1719.0], [1086.0, 1719.0]]], "lines": ["風呂屋"]}], "img_path": "00166.jpeg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [520, 61, 830, 133], "vertical": false, "font_size": 57, "lines_coords": [[[530.0, 66.0], [815.0, 62.0], [815.0, 125.0], [530.0, 128.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [283, 757, 578, 1110], "vertical": false, "font_size": 30, "lines_coords": [[[318.0, 761.0], [440.0, 757.0], [440.0, 778.0], [318.0, 781.0]], [[288.0, 785.0], [451.0, 781.0], [451.0, 813.0], [288.0, 817.0]], [[292.0, 832.0], [451.0, 832.0], [451.0, 858.0], [292.0, 858.0]], [[290.0, 875.0], [367.0, 875.0], [367.0, 909.0], [290.0, 909.0]], [[286.0, 911.0], [395.0, 911.0], [395.0, 950.0], [286.0, 950.0]], [[286.0, 958.0], [466.0, 954.0], [466.0, 986.0], [286.0, 990.0]], [[305.0, 999.0], [515.0, 999.0], [515.0, 1031.0], [305.0, 1031.0]], [[309.0, 1036.0], [570.0, 1036.0], [570.0, 1068.0], [309.0, 1068.0]], [[313.0, 1080.0], [493.0, 1080.0], [493.0, 1106.0], [313.0, 1106.0]]], "lines": ["こいけっくっ。", "一小池千宿島", "・９月２日生まれ", "Ａ型", "．．．", "・バレーボールお", "運動全般例きで、", "高校入学後、穏波とは", "すぐ仲良くなった。"]}, {"box": [783, 344, 1068, 665], "vertical": false, "font_size": 33, "lines_coords": [[[806.0, 353.0], [941.0, 351.0], [941.0, 391.0], [806.0, 393.0]], [[787.0, 400.0], [950.0, 400.0], [950.0, 438.0], [787.0, 438.0]], [[787.0, 447.0], [853.0, 447.0], [853.0, 481.0], [787.0, 481.0]], [[787.0, 488.0], [875.0, 488.0], [875.0, 522.0], [787.0, 522.0]], [[789.0, 520.0], [1065.0, 518.0], [1065.0, 558.0], [789.0, 559.0]], [[798.0, 561.0], [988.0, 555.0], [988.0, 593.0], [798.0, 599.0]], [[800.0, 600.0], [1044.0, 595.0], [1044.0, 625.0], [800.0, 631.0]], [[798.0, 632.0], [958.0, 627.0], [958.0, 659.0], [798.0, 664.0]]], "lines": ["坂上穂波", "・７月８日生まれ", "・Ｏ型", "・１４５ｃｈ", "・中学生の中学の頃から陸上部で", "走るのが大好き。", "あたしこへ子は結果に", "教えてもらった。"]}, {"box": [715, 1284, 1042, 1591], "vertical": false, "font_size": 29, "lines_coords": [[[849.0, 1299.0], [903.0, 1299.0], [903.0, 1322.0], [849.0, 1322.0]], [[718.0, 1402.0], [800.0, 1402.0], [800.0, 1434.0], [718.0, 1434.0]], [[725.0, 1445.0], [1040.0, 1441.0], [1040.0, 1475.0], [725.0, 1479.0]], [[733.0, 1483.0], [1033.0, 1477.0], [1033.0, 1507.0], [733.0, 1513.0]], [[729.0, 1513.0], [971.0, 1511.0], [971.0, 1548.0], [729.0, 1550.0]], [[735.0, 1558.0], [991.0, 1558.0], [991.0, 1588.0], [735.0, 1588.0]]], "lines": ["生まれ", "・１５４ｃｍ", "オフィレや流行ものか大切さ。", "ヘアタレンジやスッジン系を", "定期購読している。", "部活には入っていない。"]}, {"box": [570, 1809, 772, 1841], "vertical": false, "font_size": 32, "lines_coords": [[[570.0, 1809.0], [772.0, 1809.0], [772.0, 1841.0], [570.0, 1841.0]]], "lines": ["本体・裏表紙"]}, {"box": [450, 1867, 890, 1891], "vertical": false, "font_size": 24, "lines_coords": [[[450.0, 1867.0], [890.0, 1867.0], [890.0, 1891.0], [450.0, 1891.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}], "img_path": "00167.jpeg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [520, 59, 831, 135], "vertical": false, "font_size": 57, "lines_coords": [[[530.0, 66.0], [815.0, 62.0], [815.0, 125.0], [530.0, 128.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [60, 519, 80, 577], "vertical": true, "font_size": 20, "lines_coords": [[[60.0, 519.0], [80.0, 519.0], [80.0, 577.0], [60.0, 577.0]]], "lines": ["！！"]}, {"box": [52, 813, 90, 990], "vertical": true, "font_size": 32, "lines_coords": [[[58.0, 813.0], [90.0, 813.0], [84.0, 990.0], [52.0, 990.0]]], "lines": ["．．．え"]}, {"box": [200, 278, 656, 1586], "vertical": false, "font_size": 23, "lines_coords": [[[204.0, 359.0], [536.0, 359.0], [536.0, 388.0], [204.0, 388.0]], [[204.0, 399.0], [410.0, 403.0], [410.0, 431.0], [204.0, 427.0]], [[605.0, 418.0], [646.0, 418.0], [646.0, 444.0], [605.0, 444.0]], [[564.0, 479.0], [648.0, 479.0], [648.0, 502.0], [564.0, 502.0]], [[204.0, 481.0], [330.0, 481.0], [330.0, 504.0], [204.0, 504.0]], [[206.0, 515.0], [348.0, 515.0], [348.0, 538.0], [20