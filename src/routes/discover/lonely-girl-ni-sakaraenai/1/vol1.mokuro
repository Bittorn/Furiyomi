, [588.0, 1237.0], [588.0, 1505.0], [556.0, 1505.0]]], "lines": ["筆記用具以外は", "カバンにしまって"]}, {"box": [151, 1633, 191, 1751], "vertical": true, "font_size": 40, "lines_coords": [[[151.0, 1633.0], [191.0, 1633.0], [191.0, 1751.0], [151.0, 1751.0]]], "lines": ["うっ．．．"]}], "img_path": "00008.jpeg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [922, 717, 1032, 980], "vertical": true, "font_size": 40, "lines_coords": [[[978.0, 718.0], [1018.0, 718.0], [1018.0, 980.0], [978.0, 980.0]], [[922.0, 718.0], [961.0, 718.0], [961.0, 978.0], [922.0, 978.0]]], "lines": ["お腹が痛い．．．！", "視界が霞む．．．！"]}, {"box": [178, 718, 238, 853], "vertical": true, "font_size": 27, "lines_coords": [[[210.0, 718.0], [238.0, 718.0], [234.0, 853.0], [206.0, 853.0]], [[178.0, 718.0], [204.0, 718.0], [204.0, 853.0], [178.0, 853.0]]], "lines": ["では試験を", "開始します"]}, {"box": [181, 1087, 268, 1316], "vertical": true, "font_size": 39, "lines_coords": [[[228.0, 1087.0], [268.0, 1087.0], [268.0, 1314.0], [228.0, 1314.0]], [[181.0, 1087.0], [219.0, 1087.0], [219.0, 1316.0], [181.0, 1316.0]]], "lines": ["本番にとても", "弱いのである"]}], "img_path": "00009.jpeg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [937, 149, 971, 265], "vertical": true, "font_size": 34, "lines_coords": [[[937.0, 150.0], [971.0, 150.0], [971.0, 262.0], [937.0, 262.0]]], "lines": ["で結局"]}, {"box": [709, 150, 970, 621], "vertical": true, "font_size": 27, "lines_coords": [[[798.0, 315.0], [825.0, 315.0], [825.0, 616.0], [798.0, 616.0]], [[753.0, 316.0], [780.0, 316.0], [780.0, 616.0], [753.0, 616.0]], [[716.0, 316.0], [742.0, 316.0], [742.0, 466.0], [716.0, 466.0]]], "lines": ["この春から通うことに", "なったのは滑り止めで", "受けた高校"]}, {"box": [715, 316, 831, 616], "vertical": true, "font_size": 116, "lines_coords": [[[715.0, 316.0], [831.0, 316.0], [831.0, 616.0], [715.0, 616.0]]], "lines": ["この春から通うことになったのは滑り止めて受けた高校"]}, {"box": [185, 438, 236, 525], "vertical": true, "font_size": 51, "lines_coords": [[[185.0, 438.0], [236.0, 438.0], [236.0, 525.0], [185.0, 525.0]]], "lines": ["はぁ"]}, {"box": [785, 1401, 863, 1775], "vertical": true, "font_size": 32, "lines_coords": [[[828.0, 1404.0], [860.0, 1404.0], [860.0, 1741.0], [828.0, 1741.0]], [[785.0, 1404.0], [817.0, 1404.0], [817.0, 1775.0], [785.0, 1775.0]]], "lines": ["お父さんもお母さん、も", "期待してくれてたのにな"]}], "img_path": "00010.jpeg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [1143, 155, 1220, 476], "vertical": true, "font_size": 53, "lines_coords": [[[1147.0, 155.0], [1200.0, 155.0], [1196.0, 476.0], [1143.0, 476.0]]], "lines": ["桜井彩花さん．．．"]}, {"box": [1166, 819, 1200, 958], "vertical": true, "font_size": 34, "lines_coords": [[[1166.0, 819.0], [1200.0, 819.0], [1200.0, 958.0], [1166.0, 958.0]]], "lines": ["あ．．．え．．．"]}, {"box": [198, 337, 301, 639], "vertical": true, "font_size": 87, "lines_coords": [[[198.0, 343.0], [285.0, 337.0], [301.0, 633.0], [215.0, 639.0]]], "lines": ["ひっ．．．！！"]}, {"box": [329, 1136, 407, 1348], "vertical": true, "font_size": 30, "lines_coords": [[[363.0, 1136.0], [397.0, 1136.0], [397.0, 1261.0], [363.0, 1261.0]], [[330.0, 1140.0], [356.0, 1140.0], [356.0, 1348.0], [330.0, 1348.0]]], "lines": ["驚かせて", "ごめんなさいね"]}, {"box": [1096, 1447, 1173, 1738], "vertical": true, "font_size": 64, "lines_coords": [[[1096.0, 1447.0], [1160.0, 1447.0], [1160.0, 1738.0], [1096.0, 1738.0]]], "lines": ["江川先生！？"]}], "img_path": "00011.jpeg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [875, 142, 975, 401], "vertical": true, "font_size": 28, "lines_coords": [[[945.0, 146.0], [971.0, 146.0], [971.0, 399.0], [945.0, 399.0]], [[907.0, 142.0], [939.0, 142.0], [939.0, 401.0], [907.0, 401.0]], [[875.0, 144.0], [901.0, 144.0], [901.0, 260.0], [875.0, 260.0]]], "lines": ["あなたクラス委員に", "立候補してくれてた", "わよね？"]}, {"box": [645, 203, 723, 440], "vertical": true, "font_size": 32, "lines_coords": [[[688.0, 204.0], [720.0, 204.0], [720.0, 440.0], [688.0, 440.0]], [[645.0, 206.0], [676.0, 206.0], [676.0, 373.0], [645.0, 373.0]]], "lines": ["他に立候補者が", "いないから"]}, {"box": [1239, 911, 1291, 991], "vertical": true, "font_size": 52, "lines_coords": [[[1239.0, 911.0], [1291.0, 911.0], [1291.0, 991.0], [1239.0, 991.0]]], "lines": ["はい"]}, {"box": [630, 755, 733, 1029], "vertical": true, "font_size": 28, "lines_coords": [[[693.0, 755.0], [725.0, 755.0], [725.0, 1029.0], [693.0, 1029.0]], [[661.0, 757.0], [688.0, 757.0], [688.0, 1003.0], [661.0, 1003.0]], [[630.0, 757.0], [656.0, 757.0], [656.0, 868.0], [630.0, 868.0]]], "lines": ["早速クラス委員として", "お願いしたいことが", "あるのよ"]}, {"box": [151, 420, 228, 693], "vertical": true, "font_size": 32, "lines_coords": [[[193.0, 420.0], [225.0, 420.0], [225.0, 660.0], [193.0, 660.0]], [[151.0, 420.0], [183.0, 420.0], [183.0, 693.0], [151.0, 693.0]]], "lines": ["もう桜井さんで", "決定なんだけど．．．"]}, {"box": [847, 918, 939, 1160], "vertical": true, "font_size": 42, "lines_coords": [[[892.0, 918.0], [939.0, 918.0], [939.0, 1031.0], [892.0, 1031.0]], [[847.0, 920.0], [885.0, 920.0], [885.0, 1160.0], [847.0, 1160.0]]], "lines": ["なんで", "植え込みから．．"]}, {"box": [185, 939, 219, 1023], "vertical": true, "font_size": 34, "lines_coords": [[[185.0, 939.0], [219.0, 939.0], [219.0, 1023.0], [185.0, 1023.0]]], "lines": ["はあ．．．"]}, {"box": [1053, 1291, 1159, 1625], "vertical": true, "font_size": 29, "lines_coords": [[[1126.0, 1291.0], [1153.0, 1291.0], [1153.0, 1621.0], [1126.0, 1621.0]], [[1085.0, 1291.0], [1119.0, 1291.0], [1121.0, 1623.0], [1087.0, 1623.0]], [[1053.0, 1295.0], [1080.0, 1295.0], [1080.0, 1501.0], [1053.0, 1501.0]]], "lines": ["この春から入学した子が", "ウチのクラスにもう一人", "いるんだけどね"]}, {"box": [161, 1464, 233, 1740], "vertical": true, "font_size": 32, "lines_coords": [[[200.0, 1468.0], [232.0, 1468.0], [232.0, 1711.0], [200.0, 1711.0]], [[163.0, 1464.0], [195.0, 1464.0], [193.0, 1740.0], [161.0, 1740.0]]], "lines": ["その子まだ一度も", "学校に来てないのよ"]}], "img_path": "00012.jpeg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": 