8.0], [451.0, 1271.0], [206.0, 1271.0]], [[208.0, 1282.0], [333.0, 1282.0], [333.0, 1307.0], [208.0, 1307.0]], [[204.0, 1318.0], [378.0, 1318.0], [378.0, 1340.0], [204.0, 1340.0]], [[200.0, 1346.0], [645.0, 1348.0], [645.0, 1383.0], [200.0, 1382.0]], [[208.0, 1389.0], [421.0, 1389.0], [421.0, 1406.0], [208.0, 1406.0]], [[534.0, 1387.0], [641.0, 1387.0], [641.0, 1412.0], [534.0, 1412.0]], [[208.0, 1424.0], [457.0, 1424.0], [457.0, 1442.0], [208.0, 1442.0]], [[202.0, 1454.0], [466.0, 1456.0], [466.0, 1481.0], [202.0, 1479.0]], [[594.0, 1490.0], [648.0, 1490.0], [648.0, 1515.0], [594.0, 1515.0]], [[204.0, 1490.0], [410.0, 1490.0], [410.0, 1518.0], [204.0, 1518.0]], [[594.0, 1526.0], [648.0, 1526.0], [648.0, 1548.0], [594.0, 1548.0]], [[206.0, 1528.0], [412.0, 1528.0], [412.0, 1550.0], [206.0, 1550.0]], [[204.0, 1563.0], [468.0, 1563.0], [468.0, 1586.0], [204.0, 1586.0]], [[579.0, 1563.0], [648.0, 1563.0], [648.0, 1588.0], [579.0, 1588.0]]], "lines": ["ＹＵＲＩＨＩＭＥＣＯＭＩＣＳ", "既刊好評発売中", "ＹＵＲＩＨＩＭＥＣＯＭＩＣＳ", "．．．サブロウタ", "ｃｔｒｕｓ全®巻．．．", "ｏｔｒｕｓ＋（Ｃ）巻．．．", "．．．．．．サブロウタ", "ロンリーガールに逆らえない『』．．．", "セメルバルスｓｓａｍｅｐａｒｏｕｓｅｒ．．．", "ぼちゃクライム！Ｃ巻．．．", "・みんたろう", "きたない君がいちばんかわいいですか", "ゆめぐりゆりめぐリ○〜２巻．．．", "割り切った関係ですから。○○○巻、．．．．．．ＦＬＯＷＥＲＯＨＬＤ", "ささやくように恋を唄うのへえっき．．．", "．．．いや、竹嶋えく", "ヒーローさんと元気幹部さん○〜の港．．．", "きみが死ぬまで恋をしたい○○巻．．．．．．．．", "羽山先生と寺野先生は付き合っている○〜２巻．．．黄井びかち", "．．．玉崎たま", "行進子犬に恋文を○〜９巻．．．", "モデルちゃんと地球マネさん全て港．．．いい．．", "私の百合はお仕事です！Ｏ＾６巻．．．", "．．．未幡", "．．．ｔｈｏｎＲ", "たとえとどかぬ糸だとしでも、『〜＠巻．．．", "私に天使が舞い降りた！○〜の巻。．．．．．．．．", "月が綺麗ですね全６巻．．．", "．．．伊藤ハチ", "２ＤＫ、Ｇペン、目覚まし時計。全®巻．．．はい．．", "ハローメランコリックしていた．．．", "．．．．．．．大沢やよい", "．．．コダマナオコ", "海猫荘は８０〜２０巻．．．", "立花館市にはあんぐる○○○巻．．．", "ゆるゆり『この巻．．．．．．．．", "ゆりゆり２．．．．．．", "大室家『〜〜〜』．．．", "ゆるゆりアンソロジー１０周年記念：００「．．．．．", "双子百合えっちアンソロジー．．", "．．．アンソロジー", "レズ優俗アンソロジーリビーター・", "欠けた月とドーナッツ『巻．．．！！", "．．．雨水汐", "きみのために世界はある．．．", "くるくる姫", "それは、春の嵐のように○巻・", "月と恋は満ちれば欠ける。『巻』．．．", "．．．トクラッム"]}, {"box": [925, 472, 1146, 703], "vertical": false, "font_size": 23, "lines_coords": [[[988.0, 472.0], [1081.0, 472.0], [1081.0, 515.0], [988.0, 515.0]], [[995.0, 513.0], [1046.0, 517.0], [1044.0, 538.0], [993.0, 534.0]], [[948.0, 562.0], [1123.0, 562.0], [1123.0, 581.0], [948.0, 581.0]], [[950.0, 588.0], [1119.0, 588.0], [1119.0, 607.0], [950.0, 607.0]], [[930.0, 622.0], [1141.0, 622.0], [1141.0, 641.0], [930.0, 641.0]], [[984.0, 652.0], [1085.0, 652.0], [1085.0, 673.0], [984.0, 673.0]], [[978.0, 682.0], [1087.0, 682.0], [1087.0, 703.0], [978.0, 703.0]]], "lines": ["樫風", "Ｋａｓｈｉ", "ロンガル１巻発売を祝して", "焼き肉を食べに行きたい", "桜井さんと本田さん２人の青春", "どうぞ見守って", "あげてください"]}, {"box": [41, 1398, 85, 1496], "vertical": true, "font_size": 43, "lines_coords": [[[41.0, 1398.0], [84.0, 1398.0], [84.0, 1494.0], [41.0, 1494.0]]], "lines": ["樫風"]}, {"box": [69, 1588, 91, 1616], "vertical": false, "font_size": 28, "lines_coords": [[[69.0, 1588.0], [91.0, 1588.0], [91.0, 1616.0], [69.0, 1616.0]]], "lines": ["社"]}, {"box": [204, 1599, 556, 1618], "vertical": false, "font_size": 19, "lines_coords": [[[204.0, 1599.0], [556.0, 1599.0], [556.0, 1618.0], [204.0, 1618.0]]], "lines": ["終電で帰さない、たった１つの方法『〜２巻．．．"]}, {"box": [564, 1599, 648, 1618], "vertical": false, "font_size": 19, "lines_coords": [[[564.0, 1599.0], [648.0, 1599.0], [648.0, 1618.0], [564.0, 1618.0]]], "lines": ["．．．トクラツム"]}, {"box": [487, 1805, 853, 1845], "vertical": false, "font_size": 40, "lines_coords": [[[487.0, 1805.0], [853.0, 1805.0], [853.0, 1845.0], [487.0, 1845.0]]], "lines": ["背表紙・カバー折り返し"]}, {"box": [450, 1867, 892, 1891], "vertical": false, "font_size": 24, "lines_coords": [[[450.0, 1867.0], [892.0, 1867.0], [892.0, 1891.0], [450.0, 1891.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}], "img_path": "00168.jpeg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [519, 60, 831, 134], "vertical": false, "font_size": 57, "lines_coords": [[[530.0, 66.0], [815.0, 62.0], [815.0, 125.0], [530.0, 128.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [172, 787, 425, 811], "vertical": false, "font_size": 24, "lines_coords": [[[172.0, 787.0], [425.0, 787.0], [425.0, 811.0], [172.0, 811.0]]], "lines": ["桜井彩花は文武両道な優等生。"]}, {"box": [178, 823, 806, 841], "vertical": false, "font_size": 18, "lines_coords": [[[178.0, 823.0], [806.0, 823.0], [806.0, 841.0], [178.0, 841.0]]], "lines": ["しかし、本番に弱いせいで高校受験に失敗、滑り止めの学校に行くことに。"]}, {"box": [170, 855, 746, 980], "vertical": false, "font_size": 24.25, "lines_coords": [[[172.0, 855.0], [523.0, 855.0], [523.0, 879.0], [172.0, 879.0]], [[174.0, 888.0], [590.0, 888.0], [590.0, 913.0], [174.0, 913.0]], [[170.0, 922.0], [663.0, 922.0], [663.0, 946.0], [170.0, 946.0]], [[176.0, 956.0], [746.0, 956.0], [746.0, 980.0], [176.0, 980.0]]], "lines": ["大学受験こそ失敗できないと悩む彩花は、", "担任の江川先生と「不登校の生徒を説得できたら、", "好きな進学先を推薦してもらう」という秘密の約束をする。", "．．．のだが、肝心の説得相手である本田空にその約束がバレてしまう。"]}, {"box": [172, 1029, 665, 1136], "vertical": false, "font_size": 26.0, "lines_coords": [[[174.0, 1029.0], [665.0, 1029.0], [665.0, 1055.0], [174.0, 1055.0]], [[174.0, 1068.0], [551.0, 1068.0], [551.0, 1095.0], [174.0, 1095.0]], [[172.0, 1111.0], [388.0, 1111.0], [388.0, 1136.0], [172.0, 1136.0]]], "lines": ["空は「毎日一つお願いを聞いてくれたら、", "黙って学校に来てあげる」と言い、", "突然彩花にキスをして．．．。"]}, {"box": [176, 1179, 480, 1237], "vertical": false, "font_size": 24.0, "lines_coords": [[[176.0, 1179.0], [480.0, 1179.0], [480.0, 1203.0], [176.0, 1203.0]], [[176.0, 1213.0], [453.0, 1213.0], [453.0, 1237.0], [176.0, 1237.0]]], "lines": ["うかつな委員長とアンニュイ問題児、", "二人の秘密な青春ラブコメディ！"]}, {"box": [812, 962, 896, 982], "vertical": false, "font_size": 20, "lines_coords": [[[812.0, 962.0], [896.0, 962.0], [896.0, 982.0], [812.0, 982.0]]], "lines": ["．．．"]}, {"box": [984, 962, 1090, 986], "vertical": false, "font_size": 21, "lines_coords": [[[990.0, 965.0], [1085.0, 965.0], [1085.0, 986.0], [990.0, 986.0]]], "lines": ["．．．"]}, {"box": [637, 1813, 785, 1839], "vertical": false, "font_size": 26, "lines_coords": [[[637.0, 1813.0], [785.0, 1813.0], [785.0, 1839.0], [637.0, 1839.0]]], "lines": ["ー・裏表紙"]}, {"box": [450, 1867, 888, 1891], "vertical": false, "font_size": 24, "lines_coords": [[[450.0, 1867.0], [888.0, 1867.0], [888.0, 1891.0], [450.0, 1891.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}], "img_path": "00169.jpeg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [521, 59, 832, 133], "vertical": false, "font_size": 63, "lines_coords": [[[526.0, 62.0], [819.0, 58.0], [819.0, 126.0], [526.0, 130.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [855, 400, 909, 478], "vertical": true, "font_size": 54, "lines_coords": [[[855.0, 400.0], [909.0, 400.0], [909.0, 478.0], [855.0, 478.0]]], "lines": ["！！"]}, {"box": [776, 1383, 1145, 1464], "vertical": false, "font_size": 39.5, "lines_coords": [[[776.0, 1391.0], [999.0, 1383.0], [999.0, 1417.0], [776.0, 1425.0]], [[922.0, 1419.0], [1145.0, 1415.0], [1145.0, 1460.0], [922.0, 1464.0]]], "lines": ["『ロンソーガールに", "「逆らえない」の"]}, {"box": [478, 1811, 866, 1837], "vertical": false, "font_size": 26, "lines_coords": [[[478.0, 1811.0], [866.0, 1811.0], [866.0, 1837.0], [478.0, 1837.0]]], "lines": ["電子特別版おまけイラスト"]}, {"box": [806, 1505, 1132, 1576], "vertical": false, "font_size": 35.0, "lines_coords": [[[806.0, 1505.0], [999.0, 1505.0], [999.0, 1537.0], [806.0, 1537.0]], [[856.0, 1539.0], [1132.0, 1533.0], [1132.0, 1571.0], [856.0, 1576.0]]], "lines": ["お買い上げ頂き", "ありがとうございます！！"]}, {"box": [830, 1612, 1168, 1659], "vertical": false, "font_size": 24.0, "lines_coords": [[[997.0, 1612.0], [1168.0, 1612.0], [1168.0, 1636.0], [997.0, 1636.0]], [[830.0, 1633.0], [1168.0, 1635.0], [1168.0, 1659.0], [830.0, 1657.0]]], "lines": ["◎樫風／一迅社２０２０年ここが、", "「ロンリーガールに逆らえない！！いい購入特典"]}, {"box": [1053, 1661, 1168, 1680], "vertical": false, "font_size": 19, "lines_coords": [[[1053.0, 1661.0], [1168.0, 1661.0], [1168.0, 1680.0], [1053.0, 1680.0]]], "lines": ["ＮｏＴＦＯＲＳＡＬＥ"]}], "img_path": "00170.jpeg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [1087, 86, 1265, 320], "vertical": true, "font_size": 169, "lines_coords": [[[1087.0, 93.0], [1256.0, 86.0], [1265.0, 313.0], [10