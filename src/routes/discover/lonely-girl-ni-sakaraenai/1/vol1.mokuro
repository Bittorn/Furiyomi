: [211, 431, 289, 705], "vertical": true, "font_size": 32, "lines_coords": [[[253.0, 431.0], [286.0, 431.0], [288.0, 673.0], [255.0, 673.0]], [[211.0, 433.0], [243.0, 433.0], [243.0, 705.0], [211.0, 705.0]]], "lines": ["本田さんが同じ", "学校だったなんて"]}, {"box": [781, 845, 870, 1221], "vertical": true, "font_size": 38, "lines_coords": [[[830.0, 847.0], [868.0, 847.0], [868.0, 1104.0], [830.0, 1104.0]], [[787.0, 847.0], [826.0, 847.0], [826.0, 1209.0], [787.0, 1209.0]]], "lines": ["もっと上の学校", "行ったんだと思ってた"]}, {"box": [333, 834, 545, 1224], "vertical": false, "font_size": 99, "lines_coords": [[[333.0, 1194.0], [451.0, 834.0], [545.0, 864.0], [427.0, 1224.0]]], "lines": ["森のお茶はお"]}, {"box": [1036, 1557, 1073, 1693], "vertical": true, "font_size": 34, "lines_coords": [[[1036.0, 1558.0], [1070.0, 1558.0], [1070.0, 1693.0], [1036.0, 1693.0]]], "lines": ["わたしも"]}], "img_path": "00022.jpeg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [1081, 191, 1203, 564], "vertical": true, "font_size": 33, "lines_coords": [[[1166.0, 191.0], [1200.0, 191.0], [1198.0, 534.0], [1164.0, 534.0]], [[1123.0, 193.0], [1155.0, 193.0], [1155.0, 564.0], [1123.0, 564.0]], [[1081.0, 193.0], [1115.0, 193.0], [1115.0, 365.0], [1081.0, 365.0]]], "lines": ["まあやっぱり地元から", "離れたくなかったかな〜", "みたいな．．"]}, {"box": [254, 324, 286, 506], "vertical": true, "font_size": 26, "lines_coords": [[[255.0, 326.0], [281.0, 326.0], [281.0, 506.0], [255.0, 506.0]]], "lines": ["そうなんだ．．．"]}, {"box": [1094, 746, 1200, 1020], "vertical": true, "font_size": 28, "lines_coords": [[[1168.0, 746.0], [1200.0, 746.0], [1200.0, 1020.0], [1168.0, 1020.0]], [[1132.0, 748.0], [1158.0, 748.0], [1158.0, 988.0], [1132.0, 988.0]], [[1095.0, 748.0], [1121.0, 748.0], [1121.0, 988.0], [1095.0, 988.0]]], "lines": ["私：本田さんと同じ", "クラスの委員長に", "なったんだけど．．．"]}, {"box": [324, 825, 363, 926], "vertical": true, "font_size": 39, "lines_coords": [[[324.0, 825.0], [363.0, 825.0], [363.0, 926.0], [324.0, 926.0]]], "lines": ["本題．．．"]}, {"box"