": [[[1155.0, 716.0], [1186.0, 716.0], [1186.0, 840.0], [1155.0, 840.0]], [[1117.0, 714.0], [1149.0, 714.0], [1149.0, 958.0], [1117.0, 958.0]], [[1081.0, 714.0], [1110.0, 714.0], [1108.0, 988.0], [1080.0, 988.0]]], "lines": ["それで？", "本田さんと話した", "感触はどうだった？"]}, {"box": [1138, 1181, 1221, 1333], "vertical": true, "font_size": 29, "lines_coords": [[[1181.0, 1183.0], [1207.0, 1183.0], [1207.0, 1333.0], [1181.0, 1333.0]], [[1138.0, 1181.0], [1170.0, 1181.0], [1170.0, 1305.0], [1138.0, 1305.0]]], "lines": ["まだ何とも", "ですね．．．"]}, {"box": [526, 1363, 646, 1706], "vertical": true, "font_size": 33, "lines_coords": [[[607.0, 1363.0], [646.0, 1363.0], [646.0, 1672.0], [607.0, 1672.0]], [[568.0, 1365.0], [600.0, 1365.0], [600.0, 1706.0], [568.0, 1706.0]], [[528.0, 1366.0], [555.0, 1366.0], [555.0, 1706.0], [528.0, 1706.0]]], "lines": ["でも知らない子では", "なかったのでこれから", "もう少し話してみます"]}, {"box": [157, 1503, 245, 1675], "vertical": true, "font_size": 36, "lines_coords": [[[206.0, 1503.0], [245.0, 1503.0], [245.0, 1612.0], [206.0, 1612.0]], [[157.0, 1505.0], [191.0, 1505.0], [193.0, 1674.0], [159.0, 1674.0]]], "lines": ["う〜ん", "手強いわね"]}], "img_path": "00026.jpeg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [1130, 165, 1203, 443], "vertical": true, "font_size": 34, "lines_coords": [[[1160.0, 165.0], [1203.0, 165.0], [1203.0, 236.0], [1160.0, 236.0]], [[1132.0, 172.0], [1158.0, 172.0], [1158.0, 442.0], [1132.0, 442.0]]], "lines": ["まっ", "良い報告待ってるわ"]}, {"box": [478, 382, 601, 620], "vertical": true, "font_size": 35, "lines_coords": [[[568.0, 384.0], [600.0, 384.0], [600.0, 555.0], [568.0, 555.0]], [[523.0, 382.0], [560.0, 382.0], [560.0, 588.0], [523.0, 588.0]], [[478.0, 382.0], [515.0, 382.0], [515.0, 620.0], [478.0, 620.0]]], "lines": ["約束された", "未来のために", "がんばってね♥"]}, {"box": [142, 922, 262, 1228], "vertical": true, "font_size": 32, "lines_coords": [[[228.0, 924.0], [260.0, 924.0], [260.0, 1228.0], [228.0, 1228.0]], [[187.0, 924.0], [219.0, 924.0], [219.0, 116