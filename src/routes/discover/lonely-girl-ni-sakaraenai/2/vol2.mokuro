g_width": 1441, "img_height": 2048, "blocks": [{"box": [757, 156, 1062, 244], "vertical": false, "font_size": 41, "lines_coords": [[[758.0, 156.0], [916.0, 156.0], [916.0, 198.0], [758.0, 198.0]], [[758.0, 202.0], [1050.0, 202.0], [1050.0, 242.0], [758.0, 242.0]]], "lines": ["ちょっ．．．", "恥ずかしいから、"]}, {"box": [844, 466, 1069, 552], "vertical": false, "font_size": 41, "lines_coords": [[[846.0, 468.0], [1064.0, 468.0], [1064.0, 508.0], [846.0, 508.0]], [[844.0, 510.0], [992.0, 510.0], [992.0, 552.0], [844.0, 552.0]]], "lines": ["彩花いい表情", "してる〜"]}, {"box": [321, 325, 582, 406], "vertical": false, "font_size": 34, "lines_coords": [[[326.0, 328.0], [502.0, 328.0], [502.0, 362.0], [326.0, 362.0]], [[324.0, 372.0], [574.0, 372.0], [574.0, 406.0], [324.0, 406.0]]], "lines": ["いいじゃん", "かわいーじゃん"]}, {"box": [770, 723, 1109, 795], "vertical": false, "font_size": 31, "lines_coords": [[[774.0, 724.0], [1016.0, 724.0], [1016.0, 758.0], [774.0, 758.0]], [[776.0, 766.0], [1102.0, 766.0], [1102.0, 794.0], [776.0, 794.0]]], "lines": ["うちのお父さんは", "プロカメラマンだからね"]}, {"box": [317, 624, 580, 661], "vertical": false, "font_size": 28, "lines_coords": [[[322.0, 628.0], [566.0, 628.0], [566.0, 656.0], [322.0, 656.0]]], "lines": ["いい写真やな〜"]}, {"box": [692, 1624, 758, 1804], "vertical": true, "font_size": 66, "lines_coords": [[[692.0, 1624.0], [758.0, 1624.0], [758.0, 1804.0], [692.0, 1804.0]]], "lines": ["保存．．．"]}], "img_path": "_0163.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [112, 178, 662, 344], "vertical": false, "font_size": 72, "lines_coords": [[[112.0, 184.0], [662.0, 178.0], [662.0, 268.0], [112.0, 274.0]], [[140.0, 290.0], [536.0, 274.0], [538.0, 328.0], [142.0, 344.0]]], "lines": ["守永和奏初期実が", "わりと好きという話"]}, {"box": [78, 386, 656, 786], "vertical": false, "font_size": 82, "lines_coords": [[[78.0, 416.0], [604.0, 386.0], [616.0, 570.0], [90.0, 600.0]], [[118.0, 552.0], [654.0, 538.0], [656.0, 600.0], [120.0, 614.0]], [[124.0, 616.0], [532.0, 596.0], [534.0, 642.0], [126.0, 662.0]], [[118.0, 666.0], [576.0, 656.0], [576.0, 710.0], [118.0, 720.0]], [[124.0, 724.0], [510.0, 718.0], [510.0, 780.0], [124.0, 786.0]]], "lines": ["初期薬は異量に毛先がラッキングビングというなんともバックなほどが", "なんともパンクな見た目でした。", "しかし目指していたのは", "「明るいギャル」だったので", "今の形になりました。"]}, {"box": [400, 1178, 529, 1264], "vertical": false, "font_size": 39, "lines_coords": [[[402.0, 1186.0], [518.0, 1180.0], [520.0, 1222.0], [404.0, 1228.0]], [[404.0, 1228.0], [520.0, 1228.0], [520.0, 1264.0], [404.0, 1264.0]]], "lines": ["ギャル反", "マシマシ"]}, {"box": [1046, 1462, 1326, 1632], "vertical": false, "font_size": 57.0, "lines_coords": [[[1058.0, 1462.0], [1326.0, 1512.0], [1314.0, 1568.0], [1046.0, 1518.0]], [[1150.0, 1548.0], [1292.0, 1576.0], [1280.0, 1632.0], [1138.0, 1604.0]]], "lines": ["マジロか学園に", "居そう。"]}, {"box": [118, 1427, 582, 1714], "vertical": false, "font_size": 68, "lines_coords": [[[118.0, 1502.0], [482.0, 1430.0], [496.0, 1500.0], [132.0, 1572.0]], [[148.0, 1586.0], [556.0, 1468.0], [574.0, 1532.0], [166.0, 1650.0]], [[158.0, 1650.0], [400.0, 1590.0], [418.0, 1654.0], [174.0, 1714.0]]], "lines": ["「ギャル」にするには", "ちょっと見た目クールに", "なりすぎた。"]}, {"box": [190, 1788, 446, 1900], "vertical": false, "font_size": 43.0, "lines_coords": [[[194.0, 1788.0], [392.0, 1804.0], [388.0, 1848.0], [190.0, 1832.0]], [[236.0, 1844.0], [446.0, 1858.0], [444.0, 1900.0], [234.0, 1886.0]]], "lines": ["でもこれは", "これで好き。"]}], "img_path": "_0164.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [146, 388, 564, 498], "vertical": false, "font_size": 98, "lines_coords": [[[146.0, 400.0], [562.0, 388.0], [564.0, 486.0], [148.0, 498.0]]], "lines": ["頂きありがとうございました。１巻までは序章、やっとの人の「いいのね。"]}, {"box": [0, 112, 770, 1016], "vertical": false, "font_size": 359.3333333333333, "lines_coords": [[[162.0, 120.0], [588.0, 112.0], [590.0, 242.0], [164.0, 250.0]], [[0.0, 118.0], [770.0, 118.0], [770.0, 1016.0], [0.0, 1016.0]], [[168.0, 710.0], [356.0, 704.0], [358.0, 754.0], [170.0, 760.0]]], "lines": ["あとがき", "．．．", "近くなり、利用といてもフクワクし参りました。今後も２人の進展"]}, {"box": [128, 838, 578, 994], "vertical": false, "font_size": 71.0, "lines_coords": [[[128.0, 848.0], [576.0, 838.0], [578.0, 924.0], [130.0, 934.0]], [[134.0, 938.0], [462.0, 926.0], [464.0, 982.0], [136.0, 994.0]]], "lines": ["今後もちゃんと見守ってあげて下さい！", "おたのしみに！"]}, {"box": [162, 1362, 492, 1438], "vertical": false, "font_size": 70, "lines_coords": [[[162.0, 1368.0], [492.0, 1362.0], [492.0, 1432.0], [162.0, 1438.0]]], "lines": ["＊Ｓｐｅｃｉａｌ"]}, {"box": [144, 1464, 652, 1584], "vertical": false, "font_size": 120, "lines_coords": [[[144.0, 1464.0], [652.0, 1464.0], [652.0, 1584.0], [144.0, 1584.0]]], "lines": ["．．．。◎担当の内藤様"]}, {"box": [504, 1350, 932, 1430], "vertical": false, "font_size": 76, "lines_coords": [[[504.0, 1354.0], [932.0, 1350.0], [932.0, 1426.0], [504.0, 1430.0]]], "lines": ["１．ｆｈａｎｋｓ！＊"]}, {"box": [776, 1492, 1306, 1538], "vertical": false, "font_size": 46, "lines_coords": [[[776.0, 1492.0], [1306.0, 1492.0], [1306.0, 1538.0], [776.0, 1538.0]]], "lines": ["◎１０話でモブいばれ描いて"]}, {"box": [214, 1620, 692, 1708], "vertical": false, "font_size": 84, "lines_coords": [[[214.0, 1624.0], [692.0, 1620.0], [692.0, 1704.0], [214.0, 1708.0]]], "lines": ["シデザインの菅原様、"]}, {"box": [830, 1552, 1110, 1616], "vertical": false, "font_size": 64, "lines_coords": [[[830.0, 1552.0], [1110.0, 1552.0], [1110.0, 1616.0], [830.0, 1616.0]]], "lines": ["これた先さん"]}, {"box": [836, 1634, 1260, 1740], "vertical": false, "font_size": 44.0, "lines_coords": [[[836.0, 1646.0], [1260.0, 1634.0], [1260.0, 1680.0], [836.0, 1692.0]], [[842.0, 1698.0], [1144.0, 1684.0], [1146.0, 1726.0], [844.0, 1740.0]]], "lines": ["海れた時もつらせてくれた", "こたろうろぞ（うさ）"]}], "img_path": "_0165.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [557, 66, 884, 141], "vertical": false, "font_size": 68, "lines_coords": [[[562.0, 68.0], [874.0, 62.0], [874.0, 136.0], [562.0, 142.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [434, 236, 1070, 282], "vertical": false, "font_size": 42, "lines_coords": [[[434.0, 236.0], [1070.0, 240.0], [1070.0, 282.0], [434.0, 278.0]]], "lines": ["シリーガールに逆らえない"]}, {"box": [723, 345, 1134, 765], "vertical": false, "font_size": 34, "lines_coords": [[[822.0, 351.0], [936.0, 351.0], [936.0, 379.0], [822.0, 379.0]], [[802.0, 379.0], [950.0, 379.0], [950.0, 407.0], [802.0, 407.0]], [[728.0, 431.0], [948.0, 431.0], [948.0, 471.0], [728.0, 471.0]], [[724.0, 493.0], [808.0, 489.0], [810.0, 533.0], [726.0, 537.0]], [[726.0, 549.0], [834.0, 549.0], [834.0, 597.0], [726.0, 597.0]], [[726.0, 615.0], [1116.0, 609.0], [1116.0, 649.0], [726.0, 655.0]], [[736.0, 655.0], [1088.0, 647.0], [1088.0, 687.0], [736.0, 695.0]], [[742.0, 695.0], [1050.0, 685.0], [1050.0, 717.0], [742.0, 727.0]], [[742.0, 733.0], [970.0, 725.0], [970.0, 759.0], [742.0, 767.0]]], "lines": ["そりながらそれはやって", "－宇永和奏", "・１２月２日生まれ", "・Ｂ型", "・１５６ｃｍ", "・大阪土身のアラシス高い水着ル。", "運動神経良いけど建動部には", "入りたくない〈疲れるから", "実はピアノが得意。"]}, {"box": [240, 814, 1144, 1032], "vertical": false, "font_size": 233, "lines_coords": [[[242.0, 793.0], [1144.0, 799.0], [1142.0, 1053.0], [240.0, 1047.0]]], "lines": ["そういえば、そうですね。それがわからない。"]}, {"box": [630, 1930, 808, 1966], "vertical": false, "font_size": 36, "lines_coords": [[[630.0, 1930.0], [808.0, 1930.0], [808.0, 1966.0], [630.0, 1966.0]]], "lines": ["本体・表紙"]}, {"box": [480, 1992, 948, 2018], "vertical": false, "font_size": 26, "lines_coords": [[[480.0, 1992.0], [948.0, 1992.0], [948.0, 2018.0], [480.0, 2018.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}], "img_path": "_0166.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [554, 66, 886, 141], "vertical": false, "font_size": 61, "lines_coords": [[[564.0, 69.0], [870.0, 65.0], [870.0, 131.0], [564.0, 135.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [418, 307, 1037, 381], "vertical": false, "font_size": 54, "lines_coords": [[[428.0, 320.0], [1022.0, 320.0], [1022.0, 374.0], [428.0, 374.0]]], "lines": ["起こしたら具けゲーム♡"]}, {"box": [652, 430