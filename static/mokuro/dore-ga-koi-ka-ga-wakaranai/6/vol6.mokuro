], [1153.0, 296.0]]], "lines": ["メイさんは魅力的よ", "大学生って", "いい時期だもの"]}, {"box": [724, 50, 858, 390], "vertical": true, "font_size": 38, "lines_coords": [[[819.0, 50.0], [858.0, 50.0], [855.0, 352.0], [815.0, 352.0]], [[772.0, 50.0], [810.0, 50.0], [810.0, 354.0], [772.0, 354.0]], [[725.0, 50.0], [763.0, 50.0], [763.0, 390.0], [725.0, 390.0]]], "lines": ["この先メイさんが", "私じゃない誰かと", "付き合うのは明白．．．"]}, {"box": [487, 39, 633, 300], "vertical": true, "font_size": 40, "lines_coords": [[[588.0, 39.0], [633.0, 39.0], [633.0, 195.0], [588.0, 195.0]], [[536.0, 45.0], [573.0, 45.0], [573.0, 268.0], [536.0, 268.0]], [[487.0, 41.0], [525.0, 41.0], [525.0, 300.0], [487.0, 300.0]]], "lines": ["この海で", "一縷の望みに", "かけたかったの"]}, {"box": [133, 39, 314, 380], "vertical": true, "font_size": 38, "lines_coords": [[[273.0, 41.0], [311.0, 41.0], [311.0, 380.0], [273.0, 380.0]], [[225.0, 39.0], [264.0, 39.0], [268.0, 270.0], [228.0, 270.0]], [[180.0, 43.0], [217.0, 43.0], [217.0, 378.0], [180.0, 378.0]], [[133.0, 39.0], [170.0, 39.0], [170.0, 226.0], [133.0, 226.0]]], "lines": ["今はダメでも４年後", "卒業した時に", "メイさんが私のこと", "まだ好きで"]}, {"box": [729, 730, 768, 940], "vertical": true, "font_size": 34, "lines_coords": [[[731.0, 731.0], [765.0, 731.0], [765.0, 870.0], [731.0, 870.0]]], "lines": ["だけどー"]}, {"box": [163, 712, 256, 963], "vertical": true, "font_size": 40, "lines_coords": [[[211.0, 712.0], [253.0, 712.0], [255.0, 963.0], [213.0, 963.0]], [[163.0, 714.0], [202.0, 714.0], [202.0, 963.0], [163.0, 963.0]]], "lines": ["誰のものでも", "なかったなら"]}, {"box": [1017, 1119, 1171, 1440], "vertical": true, "font_size": 46, "lines_coords": [[[1126.0, 1121.0], [1171.0, 1121.0], [1171.0, 1305.0], [1126.0, 1305.0]], [[1063.0, 1119.0], [1115.0, 1119.0], [1119.0, 1353.0], [1066.0, 1353.0]], [[1018.0, 1123.0], [1057.0, 1123.0], [1057.0, 1440.0], [1018.0, 1440.0]]], "lines": ["その時は", "私の恋人に", "なってくれる？"]}, {"box": [171, 1113, 327, 1526], "vertical": true, "font_size": 44, "lines_coords": [[[281.0, 1119.0], [326.0, 1119.0], [326.0, 1389.0], [281.0, 1389.0]], [[219.0, 1113.0], [270.0, 1113.0], [273.0, 1526.0], [223.0, 1526.0]], [[172.0, 1119.0], [210.0, 1119.0], [210.0, 1344.0], [172.0, 1344.0]]], "lines": ["ただし４年間", "成績すべて優の人に", "限りまーす"]}], "img_path": "p_015.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [1068, 28, 1203, 294], "vertical": true, "font_size": 37, "lines_coords": [[[1164.0, 28.0], [1203.0, 28.0], [1200.0, 219.0], [1160.0, 219.0]], [[1119.0, 33.0], [1153.0, 33.0], [1153.0, 183.0], [1119.0, 183.0]], [[1068.0, 30.0], [1106.0, 30.0], [1106.0, 292.0], [1068.0, 292.0]]], "lines": ["これは私が", "今できる", "精一杯の告白．．．"]}, {"box": [367, 35, 459, 322], "vertical": true, "font_size": 43, "lines_coords": [[[420.0, 35.0], [459.0, 35.0], [459.0, 320.0], [420.0, 320.0]], [[367.0, 35.0], [406.0, 35.0], [406.0, 322.0], [367.0, 322.0]]], "lines": ["長く生きてると", "わかっちゃうの"]}, {"box": [56, 41, 266, 333], "vertical": true, "font_size": 43, "lines_coords": [[[221.0, 41.0], [266.0, 41.0], [266.0, 249.0], [221.0, 249.0]], [[166.0, 41.0], [215.0, 41.0], [215.0, 170.0], [166.0, 170.0]], [[106.0, 41.0], [146.0, 41.0], [151.0, 333.0], [112.0, 333.0]], [[56.0, 43.0], [101.0, 43.0], [101.0, 253.0], [56.0, 253.0]]], "lines": ["ああこれは", "ダメだ", "恋に堕ちちゃう", "やつだって"]}, {"box": [1098, 633, 1205, 907], "vertical": true, "font_size": 52, "lines_coords": [[[1158.0, 637.0], [1203.0, 637.0], [1203.0, 907.0], [1158.0, 907.0]], [[1098.0, 633.0], [1156.0, 633.0], [1156.0, 738.0], [1098.0, 738.0]]], "lines": ["ごめんなさい", "私．．．"]}, {"box": [607, 635, 652, 863], "vertical": true, "font_size": 39, "lines_coords": [[[607.0, 635.0], [646.0, 635.0], [646.0, 862.0], [607.0, 862.0]]], "lines": ["だめです．．．"]}, {"box": [247, 637, 311, 710], "vertical": true, "font_size": 64, "lines_coords": [[[247.0, 637.0], [311.0, 637.0], [311.0, 710.0], [247.0, 710.0]]], "lines": ["え"]}, {"box": [755, 1453, 883, 1803], "vertical": true, "font_size": 56, "lines_coords": [[[823.0, 1455.0], [877.0, 1453.0], [883.0, 1698.0], [828.0, 1700.0]], [[755.0, 1460.0], [813.0, 1460.0], [813.0, 1803.0], [755.0, 1803.0]]], "lines": ["メイさんに", "一目惚れなの．．．"]}], "img_path": "p_016.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [1138, 58, 1230, 427], "vertical": true, "font_size": 92, "lines_coords": [[[1138.0, 58.0], [1230.0, 58.0], [1230.0, 427.0], [1138.0, 427.0]]], "lines": ["そんな話は"]}, {"box": [146, 54, 308, 429], "vertical": true, "font_size": 80, "lines_coords": [[[232.0, 60.0], [307.0, 60.0], [307.0, 281.0], [232.0, 281.0]], [[146.0, 54.0], [230.0, 54.0], [230.0, 429.0], [146.0, 429.0]]], "lines": ["みとめ", "ませんっ！！"]}, {"box": [1096, 650, 1296, 902], "vertical": true, "font_size": 40, "lines_coords": [[[1254.0, 654.0], [1293.0, 654.0], [1293.0, 900.0], [1254.0, 900.0]], [[1196.0, 650.0], [1241.0, 650.0], [1245.0, 901.0], [1200.0, 901.0]], [[1149.0, 650.0], [1186.0, 650.0], [1186.0, 858.0], [1149.0, 858.0]], [[1098.0, 652.0], [1138.0, 652.0], [1138.0, 821.0], [1098.0, 821.0]]], "lines": ["先生が仕向け", "たんですよ！？", "それを今更", "だめとか"]}, {"box": [639, 635, 679, 845], "vertical": true, "font_size": 37, "lines_coords": [[[639.0, 635.0], [676.0, 635.0], [676.0, 843.0], [639.0, 843.0]]], "lines": ["そう．．．よね"]}, {"box": [836, 1424, 998, 1882], "vertical": true, "font_size": 49, "lines_coords": [[[948.0, 1428.0], [993.0, 1428.0], [993.0, 1882.0], [948.0, 1882.0]], [[890.0, 1426.0], [941.0, 1426.0], [941.0, 1747.0], [890.0, 1747.0]], [[836.0, 1425.0], [888.0, 1425.0], [888.0, 1747.0], [836.0, 1747.0]]], "lines": ["今の私のこの気持ち．．．", "我慢するなんて", "絶対無理です！！"]}, {"box": [151, 1616, 208, 1734], "vertical": true, "font_size": 57, "lines_coords": [[[151.0, 1616.0], [208.0, 1616.0], [208.0, 1734.0], [151.0, 1734.0]]], "lines": ["っ．．．"]}], "img_path": "p_017.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [1081, 131, 1141, 352], "vertical": true, "font_size": 60, "lines_coords": [[[1081.0, 131.0], [1141.0, 131.0], [1141.0, 352.0], [1081.0, 352.0]]], "lines": ["私の手．．