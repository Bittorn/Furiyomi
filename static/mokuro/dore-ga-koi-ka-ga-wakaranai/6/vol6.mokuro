81.0], [172.0, 1263.0], [121.0, 1263.0]], [[76.0, 1183.0], [123.0, 1181.0], [127.0, 1295.0], [80.0, 1297.0]], [[45.0, 1186.0], [78.0, 1186.0], [78.0, 1297.0], [45.0, 1297.0]]], "lines": ["ん？", "ああ．．．", "それは"]}, {"box": [1057, 1470, 1207, 1680], "vertical": true, "font_size": 49, "lines_coords": [[[1151.0, 1470.0], [1207.0, 1470.0], [1207.0, 1567.0], [1151.0, 1567.0]], [[1104.0, 1471.0], [1155.0, 1471.0], [1155.0, 1567.0], [1104.0, 1567.0]], [[1059.0, 1473.0], [1098.0, 1473.0], [1098.0, 1680.0], [1059.0, 1680.0]]], "lines": ["全部", "もう", "送ったんだ"]}, {"box": [135, 1588, 198, 1681], "vertical": true, "font_size": 58, "lines_coords": [[[135.0, 1590.0], [193.0, 1588.0], [198.0, 1680.0], [140.0, 1681.0]]], "lines": ["えっ"]}], "img_path": "p_142.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [1151, 71, 1224, 386], "vertical": true, "font_size": 73, "lines_coords": [[[1151.0, 75.0], [1224.0, 75.0], [1224.0, 386.0], [1151.0, 386.0]]], "lines": ["行くぞ空池"]}, {"box": [294, 1016, 348, 1318], "vertical": true, "font_size": 52, "lines_coords": [[[294.0, 1016.0], [346.0, 1016.0], [346.0, 1318.0], [294.0, 1318.0]]], "lines": ["さよならだ"]}], "img_path": "p_143.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [106, 1783, 465, 1807], "vertical": false, "font_size": 24, "lines_coords": [[[106.0, 1783.0], [465.0, 1783.0], [465.0, 1807.0], [106.0, 1807.0]]], "lines": ["コミックス第７巻へつづく"]}], "img_path": "p_144.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [1093, 1219, 1225, 1543], "vertical": true, "font_size": 132, "lines_coords": [[[1093.0, 1219.0], [1225.0, 1219.0], [1225.0, 1543.0], [1093.0, 1543.0]]], "lines": ["さ、よ"]}, {"box": [633, 1226, 781, 1718], "vertical": true, "font_size": 126, "lines_coords": [[[656.0, 1235.0], [781.0, 1243.0], [759.0, 1657.0], [633.0, 1650.0]]], "lines": ["は．．．って。"]}], "img_path": "p_145.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [953, 153, 1203, 455], "vertical": true, "font_size": 36, "lines_coords": [[[1166.0, 161.0], [1203.0, 161.0], [1203.0, 384.0], [1166.0, 384.0]], [[1123.0, 155.0], [1160.0, 155.0], [1160.0, 453.0], [1123.0, 453.0]], [[1080.0, 157.0], [1117.0, 157.0], [1117.0, 345.0], [1080.0, 345.0]], [[1038.0, 159.0], [1076.0, 159.0], [1076.0, 384.0], [1038.0, 384.0]], [[997.0, 159.0], [1035.0, 159.0], [1035.0, 384.0], [997.0, 384.0]], [[954.0, 153.0], [986.0, 153.0], [986.0, 414.0], [954.0, 414.0]]], "lines": ["こんにちは！", "６巻を読み返して", "千春ちゃん", "かわいそう！", "ってなってる", "奥たまむしです"]}, {"box": [785, 118, 893, 217], "vertical": true, "font_size": 33, "lines_coords": [[[811.0, 123.0], [843.0, 118.0], [860.0, 200.0], [828.0, 206.0]], [[785.0, 121.0], [819.0, 120.0], [823.0, 185.0], [789.0, 187.0]]], "lines": ["幸せな", "いいの？"]}, {"box": [592, 78, 742, 103], "vertical": false, "font_size": 25, "lines_coords": [[[592.0, 78.0], [742.0, 78.0], [742.0, 103.0], [592.0, 103.0]]], "lines": ["あとがき"]}, {"box": [112, 151, 573, 570], "vertical": true, "font_size": 37, "lines_coords": [[[540.0, 155.0], [571.0, 155.0], [571.0, 526.0], [540.0, 526.0]], [[491.0, 155.0], [528.0, 155.0], [532.0, 528.0], [495.0, 528.0]], [[451.0, 157.0], [489.0, 157.0], [489.0, 493.0], [451.0, 493.0]], [[410.0, 155.0], [448.0, 155.0], [448.0, 564.0], [410.0, 564.0]], [[367.0, 153.0], [405.0, 153.0], [405.0, 564.0], [367.0, 564.0]], [[318.0, 153.0], [363.0, 153.0], [363.0, 305.0], [318.0, 305.0]], [[281.0, 157.0], [318.0, 157.0], [318.0, 476.0], [281.0, 476.0]], [[238.0, 157.0], [275.0, 157.0], [275.0, 530.0], [238.0, 530.0]], [[198.0, 159.0], [230.0, 159.0], [230.0, 564.0], [198.0, 564.0]], [[150.0, 151.0], [189.0, 151.0], [193.0, 526.0], [153.0, 526.0]], [[112.0, 153.0], [151.0, 153.0], [151.0, 378.0], [112.0, 378.0]]], "lines": ["うまくいかないんだよ", "現世：〈恋愛の話です〉", "せめてメイちゃんみ", "メインキャラには漫画の", "中で幸せになってほしい", "ですが．．．", "このお話、畳むのに", "あと２巻位かかりそう", "なのですが．．．よかったら", "見守っていただけると、", "嬉しいです！"]}, {"box": [915, 720, 1210, 1083], "vertical": true, "font_size": 37, "lines_coords": [[[1170.0, 727.0], [1207.0, 727.0], [1207.0, 1021.0], [1170.0, 1021.0]], [[1126.0, 721.0], [1164.0, 721.0], [1164.0, 1044.0], [1126.0, 1044.0]], [[1081.0, 720.0], [1121.0, 720.0], [1117.0, 1083.0], [1078.0, 1083.0]], [[1038.0, 727.0], [1076.0, 727.0], [1076.0, 1061.0], [1038.0, 1061.0]], [[997.0, 727.0], [1036.0, 727.0], [1036.0, 988.0], [997.0, 988.0]], [[956.0, 727.0], [993.0, 727.0], [993.0, 1061.0], [956.0, 1061.0]], [[915.0, 727.0], [948.0, 727.0], [948.0, 836.0], [915.0, 836.0]]], "lines": ["ちなみに次の巻は", "「悪に染まりかけた", "空池メイバカオル様と", "という感じの話から、", "始まる予定です。", "改心できるのか空池", "メイ！"]}, {"box": [716, 716, 841, 1053], "vertical": true, "font_size": 38, "lines_coords": [[[802.0, 718.0], [841.0, 718.0], [841.0, 1053.0], [802.0, 1053.0]], [[761.0, 718.0], [798.0, 718.0], [795.0, 946.0], [757.0, 946.0]], [[716.0, 718.0], [755.0, 718.0], [755.0, 1018.0], [716.0, 1018.0]]], "lines": ["空池しっかりしろ！", "正気になれ！", "誰でもいいのか！"]}, {"box": [444, 714, 612, 976], "vertical": true, "font_size": 38, "lines_coords": [[[573.0, 720.0], [607.0, 720.0], [609.0, 975.0], [575.0, 975.0]], [[530.0, 721.0], [570.0, 721.0], [570.0, 935.0], [530.0, 935.0]], [[489.0, 718.0], [530.0, 718.0], [526.0, 868.0], [485.0, 868.0]], [[444.0, 714.0], [483.0, 714.0], [483.0, 976.0], [444.0, 976.0]]], "lines": ["好きな女の子と", "ィチャイチャ", "して何が", "悪いんですか！"]}, {"box": [125, 723, 337, 1098], "vertical": true, "font_size": 37, "lines_coords": [[[298.0, 725.0], [335.0, 725.0], [335.0, 1096.0], [298.0, 1096.0]], [[255.0, 723.0], [292.0, 723.0], [292.0, 1023.0], [255.0, 1023.0]], [[211.0, 727.0], [249.0, 727.0], [249.0, 1098.0], [211.0, 1098.0]], [[168.0, 725.0], [208.0, 725.0], [208.0, 1059.0], [168.0, 1059.0]], [[127.0, 725.0], [161.0, 725.0], [159.0, 1091.0], [125.0, 1091.0]]], "lines": ["どれが恋？じゃなくて", "もうみんな売って", "ことでいいんですよ！", "今すぐおっぱい触り", "たいんですよ！！！"]}, {"box": [693, 1393, 796, 1464], "vertical": false, "font_size": 36, "lines_coords": [[[706.0, 1393.0], [796.0, 1430.0], [783.0, 1464.0], [693.0, 1426.0]]], "lines": ["ｅｎｗｉ．"]}, {"box": [138, 1295, 379, 1336], "vertical": false, "font_size": 41, "lines_coords": [[[138.0, 1295.0], [379.0, 1295.0], [379.0, 1336.0], [138.0, 1336.0]]], "lines": ["ポイントージです。"]}, {"box": [913, 1408, 1205, 1785], "vertical": true, "font_size": 36, "lines_coords": [[[1171.0, 1415.0], [1203.0, 1415.0], [1203.0, 1674.0], [1171.0, 1674.0]], [[1125.0, 1413.0], [1162.0, 1413.0], [1162.0, 1781.0], [1125.0, 1781.0]], [[1083.0, 1415.0], [1121.0, 1415.0], [1121.0, 1711.0], [1083.0, 1711.0]], [[1040.0, 1410.0], [1078.0, 1410.0], [1080.0, 1785.0], [1042.0, 1785.0]], [[997.0, 1408.0], [1035.0, 1408.0], [1035.0, 1635.0], [997.0, 1635.0]], [[956.0, 1413.0], [993.0, 1413.0], [993.0, 1640.0], [956.0, 1640.0]], [[915.0, 1413.0], [948.0, 1413.0], [946.0, 1710.0], [913.0, 1710.0]]], "lines": ["そして最後に！", "この漫画が続いている", "のはいつも買って", "読んでくださっている", "読者の皆様の", "おかげです！", "本当に感謝です！"]}, {"box": [588, 1820, 770, 1850], "vertical": false, "font_size": 26, "lines_coords": [[[588.0, 1824.0], [770.0, 1820.0], [770.0, 1846.0], [588.0, 1850.0]]], "lines": ["ＳＰｅｃｉａｌｔｈａｎｋｓ"]}, {"box": [307, 1858, 965, 1882], "vertical": false, "font_size": 24, "lines_coords": [[[307.0, 1858.0], [965.0, 1858.0], [965.0, 1882.0], [307.0, 1882.0]]], "lines": ["結果様、デザイナー一様、関係者の皆様、そして読者の皆様方！！"]}, {"box": [146, 1421, 311, 1763], "vertical": true, "font_size": 35, "lines_coords": [[[277.0, 1425.0], [309.0, 1425.0], [305.0, 1760.0], [273.0, 1760.0]], [[230.0, 1428.0], [268.0, 1428.0], [268.0, 1760.0], [230.0, 1760.0]], [[187.0, 1426.0], [226.0, 1426.0], [226.0, 1571.0], [187.0, 1571.0]], [[146.0, 1421.0], [178.0, 1421.0], [178.0, 1676.0], [146.0, 1676.0]]], "lines": ["またよかったら来年", "お会いしましょう！！", "みんなー", "幸せになって！"]}], "img_path": "p_146.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [114, 787, 416, 920], "vertical": false, "font_size": 17, "lines_coords": [[[116.0, 787.0], [416.0, 787.0], [416.0, 806.0], [116.0, 806.0]], [[118.0, 819.0], [294.0, 819.0], [294.0, 832.0], [118.0, 832.0]], [[116.0, 847.0], [348.0, 847.0], [348.0, 860.0], [116.0, 860.0]], [[114.0, 873.0], [273.0, 873.0], [273.0, 892.0], [114.0, 892.0]], [[114.0, 901.0], [346.0, 901.0], [346.0, 920.0], [114.0, 920.0]]], "lines": ["空池メイをめぐる海水浴もついに最終日", "みんなが帰っていくなか", "もう一日ふたりで湯ごきたいか", "先生から提案がある。", "夏と海はまだ終わらない．．．。！！"]}, {"box": [114, 954, 268, 973], "vertical": false, "font_size": 17, "lines_coords": [[[114.0, 954.0], [268.0, 954.0], [268.0, 973.0], [114.0, 973.0]]], "lines": ["恋が恋を呼ぶ"]}, {"box": [116, 993, 322, 1012], "vertical": false, "font_size": 17, "lines_coords": [[[116.0, 993.0], [322.0, 993.0], [322.0, 1012.0], [116.0, 1012.0]]], "lines": ["百合物語、第６巻第"]}, {"box": [110, 1048, 208, 1083], "vertical": false, "font_size": 16, "lines_coords": [[[110.0, 1048.0], [198.0, 1048.0], [198.0, 1066.0], [110.0, 1066.0]], [[114.0, 1068.0], [204.0, 1068.0], [204.0, 1081.0], [114.0, 1081.0]]], "lines": ["！ｄｏｎｔｋｍｏｗ", "ｗｈｉｃｈｉｓｌｏｗｓ"]}], "img_path": "p_147.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [1325, 416, 1346, 528], "vertical": true, "font_size": 21, "lines_coords": [[[1325.0, 416.0], [1346.0, 416.0], [1346.0, 528.0], [1325.0, 528.0]]], "lines": ["．．．"]}, {"box": [45, 652, 309, 823], "vertical": false, "font_size": 20, "lines_coords": [[[50.0, 652.0], [181.0, 652.0], [181.0, 673.0], [50.0, 673.0]], [[52.0, 686.0], [183.0, 686.0], [183.0, 706.0], [52.0, 706.0]], [[52.0, 723.0], [303.0, 723.0], [303.0, 742.0], [52.0, 742.0]], [[50.0, 750.0], [125.0, 750.0], [125.0, 770.0], [50.0, 770.0]], [[48.0, 776.0], [196.0, 776.0], [196.0, 795.0], [48.0, 795.0]], [[50.0, 804.0], [240.0, 804.0], [240.0, 823.0], [50.0, 823.0]]], "lines": ["奥たまむし", "つれｕＴａｍａｍｕｓｈｉ", "メインキャラ６人表紙に描けました！", "やったー！！", "皆様のおかげです！！", "しかし危険な賭けだった．．．"]}, {"box": [562, 330, 1127, 654], "vertical": false, "font_size": 256, "lines_coords": [[[562.0, 401.0], [1066.0, 330.0], [1102.0, 583.0], [598.0, 654.0]]], "lines": ["．．．"]}, {"box": [1220, 422, 1303, 796], "vertical": true, "font_size": 22, "lines_coords": [[[1260.0, 427.0], [1286.0, 427.0], [1286.0, 778.0], [1260.0, 778.0]], [[1220.0, 429.0], [1239.0, 429.0], [1239.0, 590.0], [1220.0, 590.0]]], "lines": ["奥が、ま、むしろ", "ＯｋＥＴｗｍａｍｕｓｈ"]}, {"box": [624, 901, 1368, 1565], "vertical": false, "font_size": 361.0, "lines_coords": [[[643.0, 901.0], [1085.0, 901.0], [1085.0, 1215.0], [643.0, 1215.0]], [[624.0, 1175.0], [1246.0, 982.0], [1368.0, 1370.0], [746.0, 1565.0]]], "lines": ["．．．", "．．"]}, {"box": [1189, 1080, 1302, 1170], "vertical": false, "font_size": 18, "lines_coords": [[[1203.0, 1081.0], [1282.0, 1081.0], [1282.0, 1095.0], [1203.0, 1095.0]], [[1196.0, 1098.0], [1288.0, 1098.0], [1288.0, 1117.0], [1196.0, 1117.0]], [[1190.0, 1123.0], [1297.0, 1123.0], [1297.0, 1143.0], [1190.0, 1143.0]], [[1200.0, 1151.0], [1288.0, 1151.0], [1288.0, 1170.0], [1200.0, 1170.0]]], "lines": ["ｄｏｎｔｋｍｏｔ", "ｗｈｉｃｈｉｓｌｏｗｅ", "どれが恋かか", "わからない"]}, {"box": [943, 1231, 1256, 1373], "vertical": false, "font_size": 156, "lines_coords": [[[943.0, 1217.0], [1256.0, 1217.0], [1256.0, 1387.0], [943.0, 1387.0]]], "lines": ["ん、"]}, {"box": [47, 1437, 200, 1490], "vertical": false, "font_size": 18, "lines_coords": [[[56.0, 1436.0], [138.0, 1436.0], [138.0, 1453.0], [56.0, 1453.0]], [[50.0, 1453.0], [195.0, 1453.0], [195.0, 1475.0], [50.0, 1475.0]], [[50.0, 1468.0], [153.0, 1469.0], [153.0, 1492.0], [50.0, 1490.0]]], "lines": ["このＶｏｒｄｅｓｉｇｎ", "名和田耕平デザイン事務所☆初日はユーザー", "名和田新千アサイン（名和日樹子＋起空参）"]}, {"box": [1128, 1477, 1289, 1498], "vertical": false, "font_size": 21, "lines_coords": [[[1128.0, 1475.0], [1278.0, 1477.0], [1278.0, 1500.0], [1128.0, 1498.0]]], "lines": ["ｍｅｔｅｕＮＥＳＥＲＩＥＳ"]}], "img_path": "p_148.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [], "img_path": "p_149.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [195, 469, 398, 533], "vertical": false, "font_size": 26, "lines_coords": [[[196.0, 468.0], [384.0, 468.0], [384.0, 497.0], [196.0, 497.0]], [[200.0, 502.0], [393.0, 502.0], [393.0, 530.0], [200.0, 530.0]]], "lines": ["ｌｄｏｎ＇ｔｋｎｏｗ", "ｗｈｉｃｈｉｓｌｏｖｅ"]}], "img_path": "p_150.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [129, 127, 465, 159], "vertical": false, "font_size": 32, "lines_coords": [[[129.0, 127.0], [465.0, 127.0], [465.0, 159.0], [129.0, 159.0]]], "lines": ["ＭＦＣキューンシリーズ"]}, {"box": [121, 354, 457, 412], "vertical": false, "font_size": 52, "lines_coords": [[[121.0, 354.0], [457.0, 360.0], [457.0, 412.0], [121.0, 406.0]]], "lines": ["著者一奥たまむし"]}, {"box": [131, 211, 853, 285], "vertical": false, "font_size": 64, "lines_coords": [[[131.0, 221.0], [853.0, 211.0], [853.0, 275.0], [131.0, 285.0]]], "lines": ["どれが恋かがわからない６"]}, {"box": [129, 534, 395, 596], "vertical": false, "font_size": 26.0, "lines_coords": [[[129.0, 534.0], [395.0, 538.0], [395.0, 564.0], [129.0, 560.0]], [[129.0, 570.0], [221.0, 570.0], [221.0, 596.0], [129.0, 596.0]]], "lines": ["２０２５年９月２７日発行", "ｖｅｒ．００１"]}, {"box": [129, 635, 433, 660], "vertical": false, "font_size": 25, "lines_coords": [[[129.0, 635.0], [433.0, 635.0], [433.0, 660.0], [129.0, 660.0]]], "lines": ["ｃｏｋｕＴａｎａｍｕｓｈｉ２０２５"]}, {"box": [123, 705, 751, 795], "vertical": false, "font_size": 26.333333333333332, "lines_coords": [[[127.0, 705.0], [639.0, 705.0], [639.0, 731.0], [127.0, 731.0]], [[123.0, 736.0], [751.0, 735.0], [751.0, 761.0], [123.0, 763.0]], [[129.0, 768.0], [526.0, 768.0], [526.0, 795.0], [129.0, 795.0]]], "lines": ["本電子書籍は下記にもとづいて制作しました", "ＭＦＣキューンシリーズ『どれが恋かがわからない。", "・２０２５年９月２７日初版第一刷発行"]}, {"box": [125, 834, 510, 958], "vertical": false, "font_size": 26.25, "lines_coords": [[[127.0, 834.0], [326.0, 834.0], [326.0, 860.0], [127.0, 860.0]], [[125.0, 866.0], [487.0, 864.0], [487.0, 890.0], [125.0, 892.0]], [[125.0, 898.0], [510.0, 900.0], [510.0, 926.0], [125.0, 924.0]], [[125.0, 931.0], [435.0, 931.0], [435.0, 958.0], [125.0, 958.0]]], "lines": ["発行者・山下直久", "発行・株式会社ＫＡＤＯＫＡＷＡ", "ｈｔｔｐｓ：／／ｗｗｗ．ｋａｄｏｋａｗａ．ｃｏ．ｊｐ／", "編集企画キューン編集部"]}, {"box": [127, 1029, 952, 1188], "vertical": false, "font_size": 24.2, "lines_coords": [[[129.0, 1029.0], [301.0, 1029.0], [301.0, 1053.0], [129.0, 1053.0]], [[127.0, 1068.0], [952.0, 1068.0], [952.0, 1093.0], [127.0, 1093.0]], [[127.0, 1104.0], [645.0, 1104.0], [645.0, 1128.0], [127.0, 1128.0]], [[129.0, 1134.0], [630.0, 1134.0], [630.0, 1158.0], [129.0, 1158.0]], [[127.0, 1164.0], [360.0, 1164.0], [360.0, 1188.0], [127.0, 1188.0]]], "lines": ["●お問い合わせ", "ｈｔｔｐｓ：／／ｗｗｗｋａｄｏｋａｖａ．ｃｏ．ｊｐ／《「お問い１合わせ「へお進みください」", "＊＊内容によっては、お答えできない場合があります。", "☆サポートは日本国内のみとさせていただきます。", "Ｘ－ａｐａｎｅｓｅｔｅｘｔｏｒｌｙ"]}, {"box": [125, 1222, 890, 1333], "vertical": false, "font_size": 24.75, "lines_coords": [[[125.0, 1222.0], [851.0, 1222.0], [851.0, 1246.0], [125.0, 1246.0]], [[127.0, 1248.0], [605.0, 1248.0], [605.0, 1273.0], [127.0, 1273.0]], [[125.0, 1278.0], [877.0, 1280.0], [877.0, 1305.0], [125.0, 1303.0]], [[125.0, 1308.0], [890.0, 1306.0], [890.0, 1331.0], [125.0, 1333.0]]], "lines": ["本電子書籍の全部または、一部を無断で複製、転載、配信、送信すること、", "あるいはウェブサイトヘへの転載等を禁止します。", "また、本電子書籍の内容を無断で改変、改ざん等を行うことも禁止します。", "本電子書籍購入時にご承諾いただいた規約により、有償・無償にかかわらず"]}, {"box": [127, 1340, 806, 1387], "vertical": false, "font_size": 19.0, "lines_coords": [[[127.0, 1340.0], [630.0, 1340.0], [630.0, 1359.0], [127.0, 1359.0]], [[127.0, 1368.0], [806.0, 1368.0], [806.0, 1387.0], [127.0, 1387.0]]], "lines": ["本電子書籍を第三者に譲渡することはできません。", "本電子書籍の内容は、底本発行時の取材・執筆内容にもとづきます。"]}, {"box": [125, 1396, 868, 1421], "vertical": false, "font_size": 25, "lines_coords": [[[125.0, 1396.0], [868.0, 1396.0], [868.0, 1421.0], [125.0, 1421.0]]], "lines": ["本電子書籍を示すサムネイルなどのイメージ画像は、再ダウンロード時に"]}, {"box": [125, 1548, 729, 1573], "vertical": false, "font_size": 25, "lines_coords": [[[125.0, 1548.0], [729.0, 1548.0], [729.0, 1573.0], [125.0, 1573.0]]], "lines": ["初出月刊コミックキュ一ン２０２５年４月号〜１０月号"]}, {"box": [129, 1428, 1008, 1475], "vertical": false, "font_size": 19.0, "lines_coords": [[[129.0, 1428.0], [495.0, 1428.0], [495.0, 1447.0], [129.0, 1447.0]], [[129.0, 1456.0], [1008.0, 1456.0], [1008.0, 1475.0], [129.0, 1475.0]]], "lines": ["予告なく変更される場合があります。", "また、ご覧になるりーディングシステムにより、表示の差が認められることがあります。"]}], "img_path": "p_151.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [307, 675, 1051, 967], "vertical": false, "font_size": 321, "lines_coords": [[[318.0, 646.0], [1051.0, 646.0], [1051.0, 996.0], [318.0, 996.0]]], "lines": ["．．．"]}, {"box": [163, 1008, 1173, 1185], "vertical": false, "font_size": 185, "lines_coords": [[[189.0, 1000.0], [1171.0, 992.0], [1173.0, 1193.0], [191.0, 1201.0]]], "lines": ["ＴＯＯＫ＞＞ＷＡＬＫＥＲ"]}], "img_path": "p_152.jpg"}]}