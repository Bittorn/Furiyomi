.0, 1048.0], [135.0, 1048.0]]], "lines": ["あの．．．", "実はひとりから", "付き合おうって", "言われていて．．．"]}, {"box": [604, 1216, 789, 1513], "vertical": false, "font_size": 291, "lines_coords": [[[604.0, 1222.0], [780.0, 1216.0], [789.0, 1507.0], [613.0, 1513.0]]], "lines": ["あれですっ"]}, {"box": [1037, 1226, 1170, 1674], "vertical": true, "font_size": 38, "lines_coords": [[[1133.0, 1226.0], [1170.0, 1226.0], [1170.0, 1599.0], [1133.0, 1599.0]], [[1086.0, 1228.0], [1123.0, 1228.0], [1123.0, 1674.0], [1086.0, 1674.0]], [[1037.0, 1228.0], [1076.0, 1228.0], [1076.0, 1526.0], [1037.0, 1526.0]]], "lines": ["でも他にも好きな人が", "いる状態で付き合うって．．．", "いいのかなって．．．"]}, {"box": [133, 1258, 324, 1706], "vertical": true, "font_size": 59, "lines_coords": [[[270.0, 1263.0], [324.0, 1263.0], [324.0, 1432.0], [270.0, 1432.0]], [[197.0, 1258.0], [260.0, 1258.0], [260.0, 1561.0], [197.0, 1561.0]], [[133.0, 1261.0], [189.0, 1261.0], [189.0, 1706.0], [133.0, 1706.0]]], "lines": ["大学生", "手がはやー", "マリア泣きそーっ"]}, {"box": [191, 1558, 264, 1657], "vertical": true, "font_size": 59, "lines_coords": [[[202.0, 1558.0], [264.0, 1565.0], [253.0, 1657.0], [191.0, 1650.0]]], "lines": ["い"]}], "img_path": "00031.jpg"}, {"version": "0.2.4", "img_width": 1349, "img_height": 1920, "blocks": [{"box": [1080, 170, 1180, 298], "vertical": true, "font_size": 48, "lines_coords": [[[1131.0, 170.0], [1180.0, 170.0], [1180.0, 298.0], [1131.0, 298.0]], [[1080.0, 170.0], [1127.0, 170.0], [1127.0, 298.0], [1080.0, 298.0]]], "lines": ["平常心", "平常心"]}, {"box": [303, 178, 461, 446], "vertical": true, "font_size": 33, "lines_coords": [[[429.0, 180.0], [461.0, 180.0], [461.0, 446.0], [429.0, 446.0]], [[386.0, 178.0], [418.0, 178.0], [418.0, 380.0], [386.0, 380.0]], [[345.0, 178.0], [377.0, 178.0], [377.0, 378.0], [345.0, 378.0]], [[303.0, 178.0], [335.0, 178.0], [335.0, 346.0], [303.0, 346.0]]], "lines": ["誰かひとりを愛し", "誰かひとりと", "添い遂げねば", "ならない．．．"]}, {"box": [135, 180, 253, 478], "vertical": true, "font_size": 33, "lines_coords": [[[219.0, 181.0], [253.0, 18