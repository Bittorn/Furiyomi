font_size": 37, "lines_coords": [[[1144.0, 1245.0], [1182.0, 1245.0], [1182.0, 1616.0], [1144.0, 1616.0]], [[1103.0, 1243.0], [1136.0, 1243.0], [1135.0, 1687.0], [1101.0, 1687.0]], [[1058.0, 1243.0], [1097.0, 1243.0], [1093.0, 1507.0], [1054.0, 1507.0]], [[1016.0, 1245.0], [1048.0, 1245.0], [1048.0, 1687.0], [1016.0, 1687.0]], [[971.0, 1246.0], [1011.0, 1246.0], [1011.0, 1543.0], [971.0, 1543.0]], [[930.0, 1245.0], [968.0, 1245.0], [968.0, 1616.0], [930.0, 1616.0]], [[889.0, 1241.0], [926.0, 1241.0], [926.0, 1689.0], [889.0, 1689.0]]], "lines": ["次の巻は大学生らしい", "シチュエーションをもっと", "描けたらなと！", "メイちゃんは色々どうする", "のかな．．．？って？", "というわけで！長々と", "ありがとうございました！"]}, {"box": [116, 1818, 1208, 1852], "vertical": false, "font_size": 32, "lines_coords": [[[116.0, 1820.0], [1208.0, 1818.0], [1208.0, 1850.0], [116.0, 1852.0]]], "lines": ["ＳｅｃｉａｌＴｈａｎｋｓ＞編集様、デザイナー様、関係者の皆様、そして読者の皆様方にお"]}], "img_path": "00157.jpg"}, {"version": "0.2.4", "img_width": 1349, "img_height": 1920, "blocks": [{"box": [216, 764, 411, 1134], "vertical": true, "font_size": 18, "lines_coords": [[[397.0, 770.0], [410.0, 770.0], [410.0, 1023.0], [397.0, 1023.0]], [[363.0, 768.0], [388.0, 768.0], [388.0, 1072.0], [363.0, 1072.0]], [[337.0, 770.0], [356.0, 770.0], [356.0, 1130.0], [337.0, 1130.0]], [[307.0, 770.0], [326.0, 770.0], [326.0, 960.0], [307.0, 960.0]], [[281.0, 770.0], [300.0, 770.0], [300.0, 1003.0], [281.0, 1003.0]], [[255.0, 772.0], [268.0, 772.0], [268.0, 1035.0], [255.0, 1035.0]], [[223.0, 770.0], [242.0, 770.0], [240.0, 965.0], [221.0, 965.0]]], "lines": ["「大学でせったい彼女をつくる！", "と意気込む主人公・空池メイのもとに、", "入学早々なぜか次々と女の子たちがやってくる。", "演劇経験のないメイだが、", "主演として舞台に立つことに。", "しかも劇の内容は、カリン先輩との", "キスシーンもあって．．．！？"]}, {"box": [174, 772, 187, 926], "vertical": true, "font_size": 16, "lines_coords": [[[174.0, 772.0], [187.0, 772.0], [187.0, 926.0], [174.0, 926.0]]], "lines": ["恋が恋を呼ぶ"]}, {"box": [129, 772, 148, 1003], "vertical": true, "font_size": 16, "lines_coords": [[[129.0, 772.0], [148.0, 772.0], [148.0, 1003.0], [129.0, 1003.0]]], "lines": ["百合物語、第３巻！"]}, {"box": [132, 1219, 335, 1236], "vertical": false, "font_size": 19, "lines_coords": [[[132.0, 1217.0], [335.0, 1217.0], [335.0, 1238.0], [132.0, 1238.0]]], "lines": ["Ｉｄｏｒｔｋｉｏｗｗｉｎｔｈｉｓｌａｖｅ"]}], "img_path": "00158.jpg"}, {"version": "0.2.4", "img_width": 1349, "img_height": 1920, "blocks": [{"box": [581, 883, 729, 975], "vertical": false, "font_size": 27, "lines_coords": [[[596.0, 885.0], [692.0, 883.0], [692.0, 901.0], [596.0, 903.0]], [[594.0, 903.0], [709.0, 903.0], [709.0, 924.0], [594.0, 924.0]], [[591.0, 922.0], [729.0, 922.0], [729.0, 963.0], [591.0, 963.0]], [[600.0, 948.0], [711.0, 948.0], [711.0, 975.0], [600.0, 975.0]]], "lines": ["「ｄｏｎｔｋｍｏｗ", "ｗｈｉｃｈｉｓｌｏｖｅ", "どれが恋かが．．．。", "わからない"]}, {"box": [48, 656, 176, 676], "vertical": false, "font_size": 20, "lines_coords": [[[48.0, 656.0], [176.0, 656.0], [176.0, 676.0], [48.0, 676.0]]], "lines": ["奥たまむし"]}, {"box": [48, 723, 257, 823], "vertical": false, "font_size": 20, "lines_coords": [[[50.0, 723.0], [106.0, 723.0], [106.0, 744.0], [50.0, 744.0]], [[48.0, 748.0], [257.0, 748.0], [257.0, 772.0], [48.0, 772.0]], [[48.0, 778.0], [249.0, 778.0], [249.0, 796.0], [48.0, 796.0]], [[48.0, 804.0], [240.0, 804.0], [240.0, 823.0], [48.0, 823.0]]], "lines": ["祝３巻！", "全員分の表紙を描きたいので", "６巻までは絶対出さないと！！", "と思って日々生きております"]}, {"box": [641, 716, 1364, 1216], "vertical": false, "font_size": 332, "lines_coords": [[[641.0, 898.0], [1272.0, 716.0], [1364.0, 1035.0], [733.0, 1216.0]]], "lines": ["．．．"]}, {"box": [545, 671, 577, 1357], "vertical": true, "font_size": 32, "lines_coords": [[[545.0, 671.0], [577.0, 671.0], [577.0, 1357.0], [545.0, 1357.0]]], "lines": ["良くたくまでむーーしー。こう．．．"]}, {"box": [551, 1184, 566, 1357], "vertical": true, "font_size": 15, "lines_coords": [[[551.0, 1184.0], [566.0, 1184.0], [566.0, 1357.0], [551.0, 1357.0]]], "lines": ["ＯｋｃＴａｍａｍｕｓｈｉｌ"]}, {"box": [1131, 1479, 1281, 1498], "vertical": false, "font_size": 19, "lines_coords": [[[1131.0, 1479.0], [1281.0, 1479.0], [1281.0, 1498.0], [1131.0, 1498.0]]], "lines": ["ｍｍｃｅｕＮＥＳＥＲＥＳ"]}, {"box": [44, 1438, 198, 1488], "vertical": false, "font_size": 17, "lines_coords": [[[56.0, 1438.0], [140.0, 1438.0], [140.0, 1455.0], [56.0, 1455.0]], [[48.0, 1453.0], [195.0, 1453.0], [195.0, 1475.0], [48.0, 1475.0]], [[52.0, 1471.0], [157.0, 1471.0], [157.0, 1488.0], [52.0, 1488.0]]], "lines": ["．．．いいですね。しか", "名和田新平デザイン事務所されていますが、", "名科田初丁ノリック（名前田耕平＋海井優楽）"]}], "img_path": "00159.jpg"}, {"version": "0.2.4", "img_width": 1349, "img_height": 1920, "blocks": [], "img_path": "00160.jpg"}, {"version": "0.2.4", "img_width": 1349, "img_height": 1920, "blocks": [{"box": [1299, 70, 1359, 97], "vertical": false, "font_size": 29, "lines_coords": [[[1299.0, 68.0], [1348.0, 68.0], [1348.0, 99.0], [1299.0, 99.0]]], "lines": ["Ｒの"]}, {"box": [190, 472, 399, 540], "vertical": false, "font_size": 24, "lines_coords": [[[195.0, 472.0], [384.0, 472.0], [384.0, 500.0], [195.0, 500.0]], [[198.0, 509.0], [394.0, 509.0], [394.0, 532.0], [198.0, 532.0]]], "lines": ["ｌｄｏｎ＇ｔｋｎｏｗ", "ｗｈｉｃｈｉｓｌｏｖｅ"]}], "img_path": "00161.jpg"}, {"version": "0.2.4", "img_width": 1349, "img_height": 1920, "blocks": [{"box": [125, 123, 461, 161], "vertical": false, "font_size": 38, "lines_coords": [[[125.0, 123.0], [461.0, 123.0], [461.0, 161.0], [125.0, 161.0]]], "lines": ["ＭＦＣキューシシリーズ"]}, {"box": [121, 356, 455, 406], "vertical": false, "font_size": 50, "lines_coords": [[[121.0, 356.0], [455.0, 356.0], [455.0, 406.0], [121.0, 406.0]]], "lines": ["著者一奥たまむし"]}, {"box": [123, 202, 855, 292], "vertical": false, "font_size": 77, "lines_coords": [[[123.0, 215.0], [853.0, 202.0], [855.0, 279.0], [125.0, 292.0]]], "lines": ["どれが恋かがわからない３"]}, {"box": [120, 533, 407, 597], "vertical": false, "font_size": 28, "lines_coords": [[[127.0, 532.0], [394.0, 536.0], [394.0, 566.0], [127.0, 562.0]], [[129.0, 568.0], [217.0, 568.0], [217.0, 598.0], [129.0, 598.0]]], "lines": ["２０２３年８月２５日発行", "ｖｅｒ．００１"]}, {"box": [127, 635, 429, 660], "vertical": false, "font_size": 25, "lines_coords": [[[127.0, 635.0], [429.0, 635.0], [429.0, 660.0], [127.0, 660.0]]], "lines": ["©ＣｋｕＴａｍａｍｕｓｈｉ２０２３"]}, {"box": [123, 694, 748, 802], "vertical": false, "font_size": 28, "lines_coords": [[[127.0, 703.0], [637.0, 703.0], [637.0, 733.0], [127.0, 733.0]], [[125.0, 736.0], [748.0, 736.0], [748.0, 765.0], [125.0, 765.0]], [[127.0, 768.0], [525.0, 768.0], [525.0, 798.0], [127.0, 798.0]]], "lines": ["本電子書籍は下記にもとづいて制作しました", "ＭＦＣキューンシリーズ『どれが恋かがわからない』", "２０２３年８月２５日初版第一刷発行"]}, {"box": [116, 834, 521, 961], "vertical": false, "font_size": 28, "lines_coords": [[[125.0, 832.0], [328.0, 832.0], [328.0, 862.0], [125.0, 862.0]], [[125.0, 864.0], [485.0, 862.0], [485.0, 894.0], [125.0, 896.0]], [[125.0, 899.0], [510.0, 899.0], [510.0, 928.0], [125.0, 928.0]], [[123.0, 931.0], [433.0, 931.0], [433.0, 960.0], [123.0, 960.0]]], "lines": ["発行者・山下直久・", "発行・株式会社ＫＡＤＯＫＡＮＡ", "わせｐｓ：／／ｗｗｗ．ｋａｄｏｋａｗａｃｏ．ｊｐ／ｋａｖａ．Ｃｏ．Ｉｐ／", "編集企画キューン編集部"]}, {"box": [131, 1033, 298, 1051], "vertical": false, "font_size": 18, "lines_coords": [[[131.0, 1033.0], [298.0, 1033.0], [298.0, 1051.0], [131.0, 1051.0]]], "lines": ["●お問い合わせ"]}, {"box": [127, 1166, 358, 1190], "vertical": false, "font_size": 24, "lines_coords": [[[127.0, 1166.0], [358.0, 1166.0], [358.0, 1190.0], [127.0, 1190.0]]], "lines": ["＊＊＿ａｐａｎｅｓｅｔｅｘｔｏｎｌｙ"]}, {"box": [129, 1108, 641, 1156], "vertical": false, "font_size": 18.0, "lines_coords": [[[129.0, 1108.0], [641.0, 1108.0], [641.0, 1126.0], [129.0, 1126.0]], [[129.0, 1138.0], [628.0, 1138.0], [628.0, 1156.0], [129.0, 1156.0]]], "lines": ["＊＊内容によっては、お答えできない１場合があります。", "メサポートは日本国内のみとさせていただきます。"]}, {"box": [123, 1066, 951, 1095], "vertical": false, "font_size": 27, "lines_coords": [[[123.0, 1068.0], [951.0, 1066.0], [951.0, 1093.0], [123.0, 1095.0]]], "lines": ["ｈｔｔｐｓ／／ｗｗｗ．ｋａｄｏｋａｖａ．ｃｏ．ｊｐ／《「お問い１合わせ「へお進みください」"]}, {"box": [125, 1226, 1005, 1479], "vertical": false, "font_size": 23.333333333333332, "lines_coords": [[[127.0, 1226.0], [851.0, 1226.0], [851.0, 1245.0], [127.0, 1245.0]], [[125.0, 1252.0], [606.0, 1252.0], [606.0, 1276.0], [125.0, 1276.0]], [[127.0, 1280.0], [876.0, 1280.0], [876.0, 1305.0], [127.0, 1305.0]], [[129.0, 1312.0], [885.0, 1312.0], [885.0, 1331.0], [129.0, 1331.0]], [[125.0, 1338.0], [628.0, 1338.0], [628.0, 1363.0], [125.0, 1363.0]], [[125.0, 1368.0], [808.0, 1368.0], [808.0, 1393.0], [125.0, 1393.0]], [[125.0, 1396.0], [866.0, 1395.0], [866.0, 1419.0], [125.0, 1421.0]], [[127.0, 1426.0], [495.0, 1426.0], [495.0, 1451.0], [127.0, 1451.0]], [[125.0, 1455.0], [1005.0, 1455.0], [1005.0, 1479.0], [125.0, 1479.0]]], "lines": ["本電子書籍の全部または、一部を無断で複製、転載、配信、送信すること、", "あるいはウェブサイトへの転載等を禁止します。", "また、本電子書籍の内容を無断で改変、改ざん等を行ううことも禁止します。", "本電子書籍購入時にご承諾いいただいた規約により、有償・無償にかかわらず", "本電子書籍を第三者に譲渡することはできません。", "本電子書籍の内容は、底本発行時の取材・執筆内容にもとづきます。", "本電子書籍を示すサムネイルなどのイメージ画像は、再ダウンロード時に", "予告なく変更される場合があります。", "また、ご覧になるリーディシグシステムにより、表示の差が認められることがあります。"]}, {"box": [127, 1548, 711, 1573], "vertical": false, "font_size": 25, "lines_coords": [[[127.0, 1548.0], [711.0, 1548.0], [711.0, 1573.0], [127.0, 1573.0]]], "lines": ["初出、月刊コミックキュ一ン２０２３年２月号〜９月号"]}], "img_path": "00162.jpg"}, {"version": "0.2.4", "img_width": 1349, "img_height": 1920, "blocks": [{"box": [324, 675, 1056, 969], "vertical": false, "font_size": 323, "lines_coords": [[[339.0, 646.0], [1056.0, 646.0], [1056.0, 998.0], [339.0, 998.0]]], "lines": ["．．．"]}, {"box": [150, 1010, 1168, 1185], "vertical": false, "font_size": 178, "lines_coords": [[[191.0, 1007.0], [1167.0, 994.0], [1168.0, 1187.0], [193.0, 1201.0]]], "lines": ["３００Ｋ～～ＷＡＬＫＥＲ"]}], "img_path": "00163.jpg"}, {"version": "0.2.4", "img_width": 1348, "img_height": 1920, "blocks": [{"box": [202, 39, 736, 281], "vertical": false, "font_size": 242, "lines_coords": [[[202.0, 39.0], [736.0, 39.0], [736.0, 281.0], [202.0, 281.0]]], "lines": ["．．．"]}, {"box": [33, 472, 95, 936], "vertical": true, "font_size": 29, "lines_coords": [[[44.0, 843.0], [73.0, 840.0], [78.0, 888.0], [50.0, 890.0]]], "lines": ["．．"]}, {"box": [65, 836, 324, 980], "vertical": false, "font_size": 23, "lines_coor