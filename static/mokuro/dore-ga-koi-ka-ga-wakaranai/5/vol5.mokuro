ません．．．"]}, {"box": [722, 1153, 840, 1249], "vertical": false, "font_size": 96, "lines_coords": [[[722.0, 1153.0], [840.0, 1153.0], [840.0, 1249.0], [722.0, 1249.0]]], "lines": ["やっっッきゃっ"]}, {"box": [413, 1213, 597, 1248], "vertical": false, "font_size": 35, "lines_coords": [[[413.0, 1213.0], [597.0, 1213.0], [597.0, 1248.0], [413.0, 1248.0]]], "lines": ["Ｌｏｒｔｏｉｔｌ"]}, {"box": [907, 1316, 1181, 1728], "vertical": true, "font_size": 47, "lines_coords": [[[1130.0, 1323.0], [1181.0, 1323.0], [1181.0, 1408.0], [1130.0, 1408.0]], [[1076.0, 1325.0], [1115.0, 1325.0], [1115.0, 1498.0], [1076.0, 1498.0]], [[1018.0, 1316.0], [1068.0, 1316.0], [1065.0, 1725.0], [1014.0, 1725.0]], [[960.0, 1318.0], [1010.0, 1318.0], [1010.0, 1728.0], [960.0, 1728.0]], [[907.0, 1316.0], [952.0, 1316.0], [952.0, 1728.0], [907.0, 1728.0]]], "lines": ["さぁ", "このまま", "どうなっちゃうの！", "な６巻もよかったら、", "見てみてください！！"]}, {"box": [368, 1817, 966, 1885], "vertical": false, "font_size": 24, "lines_coords": [[[577.0, 1820.0], [757.0, 1820.0], [757.0, 1845.0], [577.0, 1845.0]], [[397.0, 1854.0], [961.0, 1854.0], [961.0, 1878.0], [397.0, 1878.0]]], "lines": ["ＳＰｅｃｉａｌｔｈａｎｋｓ", "の作品に関わってくださっている皆様！読者様！"]}, {"box": [78, 1325, 315, 1749], "vertical": true, "font_size": 51, "lines_coords": [[[260.0, 1327.0], [307.0, 1325.0], [311.0, 1466.0], [264.0, 1468.0]], [[213.0, 1333.0], [253.0, 1333.0], [253.0, 1689.0], [213.0, 1689.0]], [[157.0, 1333.0], [196.0, 1333.0], [196.0, 1558.0], [157.0, 1558.0]], [[78.0, 1533.0], [153.0, 1513.0], [215.0, 1728.0], [140.0, 1749.0]]], "lines": ["半年位", "また引きこもって", "描きます！", "がんばるぞっ"]}], "img_path": "147.jpg"}, {"version": "0.2.4", "img_width": 1350, "img_height": 1920, "blocks": [{"box": [112, 787, 416, 978], "vertical": false, "font_size": 21, "lines_coords": [[[112.0, 789.0], [391.0, 787.0], [391.0, 806.0], [112.0, 808.0]], [[118.0, 817.0], [341.0, 817.0], [341.0, 836.0], [118.0, 836.0]], [[114.0, 845.0], [416.0, 845.0], [416.0, 864.0], [114.0, 864.0]], [[114.0, 873.0], [303.0, 873.0], [303.0, 8