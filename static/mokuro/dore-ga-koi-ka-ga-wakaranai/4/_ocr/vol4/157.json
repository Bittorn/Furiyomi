, 804.0], [887.0, 804.0]], [[845.0, 565.0], [887.0, 567.0], [878.0, 871.0], [835.0, 870.0]], [[804.0, 571.0], [842.0, 571.0], [842.0, 790.0], [804.0, 790.0]]], "lines": ["作者的には", "メイへ対する５人の", "想いがそれぞれ", "深まってきたところ、", "が嬉しいです。"]}, {"box": [121, 568, 367, 872], "vertical": true, "font_size": 33, "lines_coords": [[[334.0, 571.0], [365.0, 571.0], [365.0, 775.0], [334.0, 775.0]], [[292.0, 575.0], [323.0, 575.0], [323.0, 870.0], [292.0, 870.0]], [[250.0, 573.0], [282.0, 573.0], [279.0, 807.0], [246.0, 807.0]], [[206.0, 570.0], [243.0, 570.0], [243.0, 809.0], [206.0, 809.0]], [[165.0, 573.0], [198.0, 573.0], [198.0, 842.0], [165.0, 842.0]], [[121.0, 568.0], [154.0, 568.0], [157.0, 762.0], [125.0, 762.0]]], "lines": ["片思いしてる", "女の子が好きなので、", "どこを向いても", "片思いな状況は", "今描いていて大変", "楽しいです。"]}, {"box": [109, 928, 413, 1266], "vertical": true, "font_size": 34, "lines_coords": [[[378.0, 928.0], [410.0, 928.0], [412.0, 1231.0], [379.0, 1231.0]], [[332.0, 929.0], [375.0, 929.0], [375.0, 1203.0], [332.0, 1203.0]], [[295.0, 934.0], [328.0, 934.0], [328.0, 1198.0], [295.0, 1198.0]], [[245.0, 934.0], [282.0, 934.0], [282.0, 1234.0], [245.0, 1234.0]], [[198.0, 934.0], [229.0, 934.0], [229.0, 1167.0], [198.0, 1167.0]], [[154.0, 931.0], [187.0, 931.0], [189.0, 1265.0], [156.0, 1265.0]], [[109.0, 929.0], [140.0, 929.0], [140.0, 1265.0], [109.0, 1265.0]]], "lines": ["最後に！こうやって", "続きが描けるのも", "全て読者の皆様の", "おかげです！感謝！", "またよかったら", "お巻で会いましょう！！", "楽しい差になるぞ！！"]}, {"box": [898, 931, 1015, 1495], "vertical": true, "font_size": 32, "lines_coords": [[[982.0, 934.0], [1014.0, 934.0], [1014.0, 1157.0], [982.0, 1157.0]], [[940.0, 931.0], [973.0, 931.0], [971.0, 1428.0], [939.0, 1428.0]], [[900.0, 931.0], [931.0, 931.0], [931.0, 1495.0], [900.0, 1495.0]]], "lines": ["一方主人公は．．．", "モテすぎてマヒしているというか、", "そういう性格といううか．．．杏気ですね！！"]}, {"box": [470, 925, 568, 1493], "vertical": true, "font_size": 34, "lines_coords": [[[518.0, 929.0], [550.0, 929.0], [550.0, 1457.0], [518.0, 1457.0]], [[470.0, 929.0], [506.0, 929.0], [506