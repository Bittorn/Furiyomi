0], [687.0, 890.0], [203.0, 1004.0]], [[323.0, 950.0], [751.0, 860.0], [768.0, 948.0], [340.0, 1037.0]], [[362.0, 1012.0], [821.0, 906.0], [842.0, 992.0], [382.0, 1098.0]], [[390.0, 1076.0], [595.0, 1037.0], [610.0, 1114.0], [404.0, 1153.0]], [[368.0, 1060.0], [654.0, 1073.0], [635.0, 1515.0], [350.0, 1503.0]]], "lines": ["ちゅ、ちゅちゅっできてます", "ちゅ、ちゅちゅにできてます？．．．んあ、おゆっちゅ。んっ", "えできくまぁ．．．あなたはいちゅっちゅ、んんはぁっ、もう、急にと", "はむ。ちゅっちゅ、んっんん．．．はぁ、もう、急にそんな強ふっ、そんだに良かったです", "．．．はあ、もう、急にさんほらふふ♪そんなに良かったですねーますよー♪バンツの．．", "はいそんなに良かったですよー♪パンツの．．．ゆるじゅる〜ここを", "よー♪パンツの．．．やゆるじゅる♪ここ、そ、声出ちゃってます。", "ゆるじゅる♪ここ、で声出ちゃってますよあゆ．．．じ", "高出ちゃっちゅ．．．じです．．", "いいちゃんちゃっちゃいましょうし"]}, {"box": [785, 1032, 1076, 1470], "vertical": false, "font_size": 159.33333333333334, "lines_coords": [[[785.0, 1054.0], [970.0, 1032.0], [976.0, 1093.0], [792.0, 1115.0]], [[796.0, 1123.0], [1000.0, 1081.0], [1015.0, 1153.0], [812.0, 1195.0]], [[814.0, 1129.0], [1034.0, 1101.0], [1076.0, 1442.0], [854.0, 1470.0]]], "lines": ["ゆるいきなりとああはあ", "いきなりでああ、はあ、ふ．．．つあん", "はははあはああっあああ．．．ですまあ、はんんん！！"]}, {"box": [865, 1554, 1009, 1581], "vertical": false, "font_size": 27, "lines_coords": [[[865.0, 1554.0], [1009.0, 1554.0], [1009.0, 1581.0], [865.0, 1581.0]]], "lines": ["正しい、Ｒａｗ．Ｓｅ"]}, {"box": [137, 1075, 292, 1470], "vertical": true, "font_size": 47, "lines_coords": [[[245.0, 1076.0], [289.0, 1076.0], [289.0, 1254.0], [245.0, 1254.0]], [[189.0, 1075.0], [237.0, 1075.0], [237.0, 1470.0], [189.0, 1470.0]], [[137.0, 1075.0], [185.0, 1075.0], [185.0, 1428.0], [137.0, 1428.0]]], "lines": ["これ全部", "ひとりのセリフなの", "お〜〜〜～～～っ！？"]}], "img_path": "074.jpg"}, {"version": "0.2.4", "img_width": 1125, "img_height": 1600, "blocks": [{"box": [915, 146, 1014, 371], "vertical": true, "font_size": 29, "lines_coords": [[[984.0, 146.0], [1012.0, 146.0], [1014.0, 371.0], [985.0, 371.0]], [[948.0, 148.0], [979.0, 148.0], [979.0, 348.0], [948.0, 348.0]], [[915.0, 148.0], [942.0, 148.0], [942.0, 289.0], [915.0, 289.0]]], "lines": ["これ演劇の台本と", "ぜんぜん違う．．．", "難しそう．．．"]}, {"box": [75