0, 115.0], [571.0, 115.0], [571.0, 414.0], [540.0, 414.0]], [[495.0, 118.0], [521.0, 118.0], [521.0, 414.0], [495.0, 414.0]]], "lines": ["石合ハーレムっぽく", "なってきましたね！！"]}, {"box": [106, 17, 291, 43], "vertical": false, "font_size": 28, "lines_coords": [[[106.0, 15.0], [291.0, 15.0], [291.0, 45.0], [106.0, 45.0]]], "lines": ["ＲａｗＬａｚｙＣｏｍ"]}, {"box": [276, 112, 440, 485], "vertical": true, "font_size": 32, "lines_coords": [[[409.0, 120.0], [440.0, 120.0], [440.0, 485.0], [409.0, 485.0]], [[367.0, 123.0], [400.0, 123.0], [400.0, 420.0], [367.0, 420.0]], [[325.0, 123.0], [357.0, 123.0], [357.0, 453.0], [325.0, 453.0]], [[276.0, 112.0], [314.0, 112.0], [314.0, 456.0], [276.0, 456.0]]], "lines": ["１６人同じ場所に集まるで、", "と思っていましたが、", "マリア先生のおかげで、", "集まりました！感謝！！"]}, {"box": [128, 135, 202, 347], "vertical": true, "font_size": 45, "lines_coords": [[[140.0, 176.0], [185.0, 171.0], [201.0, 320.0], [156.0, 325.0]]], "lines": ["いのよー"]}, {"box": [804, 565, 1010, 871], "vertical": true, "font_size": 38, "lines_coords": [[[968.0, 571.0], [1006.0, 570.0], [1010.0, 735.0], [973.0, 737.0]], [[931.0, 571.0], [964.0, 571.0], [964.0, 868.0], [931.0, 868.0]], [[887.0, 567.0], [925.0, 567.0], [925.0, 804.0], [887.0, 804.0]], [[845.0, 565.0], [887.0, 567.0], [878.0, 871.0], [835.0, 870.0]], [[804.0, 571.0], [842.0, 571.0], [842.0, 790.0], [804.0, 790.0]]], "lines": ["作者的には", "メイへ対する５人の", "想いがそれぞれ", "深まってきたところ、", "が嬉しいです。"]}, {"box": [121, 568, 367, 872], "vertical": true, "font_size": 33, "lines_coords": [[[334.0, 571.0], [365.0, 571.0], [365.0, 775.0], [334.0, 775.0]], [[292.0, 575.0], [323.0, 575.0], [323.0, 870.0], [292.0, 870.0]], [[250.0, 573.0], [282.0, 573.0], [279.0, 807.0], [246.0, 807.0]], [[206.0, 570.0], [243.0, 570.0], [243.0, 809.0], [206.0, 809.0]], [[165.0, 573.0], [198.0, 573.0], [198.0, 842.0], [165.0, 842.0]], [[121.0, 568.0], [154.0, 568.0], [157.0, 762.0], [125.0, 762.0]]], "lines": ["片思いしてる", "女の子が好きなので、", "どこを向いても", "片思いな状況は", "今描いていて大変", "楽しいです。"]}, {"box": [109, 928, 413, 1266], "vertical": true, "font_size": 34, "lines_coords": [[[378.0, 928.0], [410.0, 928.0], [412.0, 1231.0], [379.0, 1231.0]], [[332.0, 929.0], [375.0, 929.0], [375.0, 1203.0], [332.0, 1203.0]], [[295.0, 934.0], [328.0, 934.0], [328.0, 1198.0], [295.0, 1198.0]], [[245.0, 934.0], [282.0, 934.0], [282.0, 1234.0], [245.0, 1234.0]], [[198.0, 934.0], [229.0, 934.0], [229.0, 1167.0], [198.0, 1167.0]], [[154.0, 931.0], [187.0, 931.0], [189.0, 1265.0], [156.0, 1265.0]], [[109.0, 929.0], [140.0, 929.0], [140.0, 1265.0], [109.0, 1265.0]]], "lines": ["最後に！こうやって", "続きが描けるのも", "全て読者の皆様の", "おかげです！感謝！", "またよかったら", "お巻で会いましょう！！", "楽しい差になるぞ！！"]}, {"box": [898, 931, 1015, 1495], "vertical": true, "font_size": 32, "lines_coords": [[[982.0, 934.0], [1014.0, 934.0], [1014.0, 1157.0], [982.0, 1157.0]], [[940.0, 931.0], [973.0, 931.0], [971.0, 1428.0], [939.0, 1428.0]], [[900.0, 931.0], [931.0, 931.0], [931.0, 1495.0], [900.0, 1495.0]]], "lines": ["一方主人公は．．．", "モテすぎてマヒしているというか、", "そういう性格といううか．．．杏気ですね！！"]}, {"box": [470, 925, 568, 1493], "vertical": true, "font_size": 34, "lines_coords": [[[518.0, 929.0], [550.0, 929.0], [550.0, 1457.0], [518.0, 1457.0]], [[470.0, 929.0], [506.0, 929.0], [506.0, 1493.0], [470.0, 1493.0]]], "lines": ["ただこのお話の主人公の器としては", "子度いいのかな？どうなるでしょう！！"]}, {"box": [234, 1545, 954, 1576], "vertical": false, "font_size": 26, "lines_coords": [[[234.0, 1545.0], [954.0, 1550.0], [954.0, 1576.0], [234.0, 1571.0]]], "lines": ["編集様、デザイナー様関係者の皆様、の様、私が様々でしで読者の皆様直ご褒め"]}, {"box": [492, 1518, 642, 1542], "vertical": false, "font_size": 22, "lines_coords": [[[492.0, 1520.0], [642.0, 1518.0], [642.0, 1540.0], [492.0, 1542.0]]], "lines": ["ＳＰｅｃｉａｌ．ｔｈａｎｋｓ"]}], "img_path": "157.jpg"}, {"version": "0.2.4", "img_width": 1125, "img_height": 1600, "blocks": [{"box": [105, 16, 291, 44], "vertical": false, "font_size": 18, "lines_coords": [[[117.0, 19.0], [282.0, 19.0], [282.0, 39.0], [117.0, 39.0]]], "lines": ["ＲａｗＬａｚｙＣｏｍ"]}, {"box": [96, 657, 384, 790], "vertical": false, "font_size": 17, "lines_coords": [[[98.0, 657.0], [300.0, 657.0], [300.0, 673.0], [98.0, 673.0]], [[96.0, 676.0], [337.0, 678.0], [337.0, 700.0], [96.0, 698.0]], [[98.0, 704.0], [384.0, 704.0], [384.0, 720.0], [98.0, 720.0]], [[96.0, 728.0], [279.0, 728.0], [279.0, 743.0], [96.0, 743.0]], [[98.0, 751.0], [259.0, 751.0], [259.0, 767.0], [98.0, 767.0]], [[98.0, 775.0], [329.0, 775.0], [329.0, 790.0], [98.0, 790.0]]], "lines": ["「大学でせったい彼女をつくる！！", "と意気込む主人公・空港メイのもとに、", "入学早々なぜか次々と女の子たちがやってくる", "無事、初の決断の舞台を終え", "カリン先輩から告白されて", "ついに彼女ができると喜ぶメイだから"]}, {"box": [96, 818, 276, 868], "vertical": false, "font_size": 17, "lines_coords": [[[98.0, 818.0], [226.0, 818.0], [226.0, 834.0], [98.0, 834.0]], [[96.0, 848.0], [276.0, 848.0], [276.0, 868.0], [96.0, 868.0]]], "lines": ["恋が恋を呼ぶ", "百合物語、第４巻！"]}, {"box": [92, 1016, 258, 1029], "vertical": false, "font_size": 15, "lines_coords": [[[92.0, 1014.0], [258.0, 1014.0], [258.0, 1031.0], [92.0, 1031.0]]], "lines": ["１．あのでも気付いていたんだけど、"]}], "img_path": "158.jpg"}, {"version": "0.2.4", "img_width": 1125, "img_height": 1600, "blocks": [{"box": [105, 16, 291, 44], "vertical": false, "font_size": 18, "lines_coords": [[[117.0, 19.0], [282.0, 19.0], [282.0, 39.0], [117.0, 39.0]]], "lines": ["ＲａｗＬａｚｙＣｏｍ"]}, {"box": [33, 528, 260, 664], "vertical": false, "font_size": 18, "lines_coords": [[[37.0, 543.0], [165.0, 543.0], [165.0, 565.0], [37.0, 565.0]], [[43.0, 573.0], [140.0, 573.0], [140.0, 589.0], [43.0, 589.0]], [[39.0, 601.0], [196.0, 603.0], [196.0, 620.0], [39.0, 618.0]], [[37.0, 621.0], [256.0, 625.0], [256.0, 645.0], [37.0, 642.0]], [[40.0, 648.0], [232.0, 648.0], [232.0, 664.0], [40.0, 664.0]]], "lines": ["奥たまむし", "これもできれるのもと", "４巻お待たせいたしました", "板タブレットで漫画を描いているので", "肩こり知らずなのが取り柄です！"]}, {"box": [449, 553, 483, 857], "vertical": true, "font_size": 26, "lines_coords": [[[453.0, 554.0], [479.0, 554.0], [479.0, 850.0], [453.0, 850.0]]], "lines": ["奥、たっま、むし、"]}, {"box": [493, 687, 603, 777], "vertical": false, "font_size": 22, "lines_coords": [[[515.0, 685.0], [582.0, 685.0], [582.0, 700.0], [515.0, 700.0]], [[506.0, 699.0], [587.0, 698.0], [587.0, 717.0], [506.0, 719.0]], [[506.0, 713.0], [585.0, 713.0], [585.0, 734.0], [506.0, 734.0]], [[500.0, 718.0], [603.0, 733.0], [596.0, 777.0], [493.0, 761.0]], [[509.0, 758.0], [581.0, 758.0], [581.0, 778.0], [509.0, 778.0]]], "lines": ["！ｄｅｎｔｋｎｏｘ", "いつかもあれのがＷｈにかけるＩｏｗｅ", "ＷｈｉｃｈｉｓｔｏｄｅＯｋｕＴａｍａｍｅｓｈｉ", "ｏｕＴｅｍａｎｕｎどれが変かったからない", "わからない"]}, {"box": [502, 688, 601, 777], "vertical": false, "font_size": 89, "lines_coords": [[[502.0, 688.0], [601.0, 688.0], [601.0, 777.0], [502.0, 777.0]]], "lines": ["いどこのままかのおかげでありますのでＯＫＬｉｎａｍｅｓｔａｍａｎｔｅｒがかかっているかもしれません。"]}, {"box": [407, 765, 910, 1300], "vertical": false, "font_size": 211.0, "lines_coords": [[[578.0, 810.0], [879.0, 765.0], [910.0, 973.0], [609.0, 1018.0]], [[407.0, 1106.0], [612.0, 1015.0], [698.0, 1209.0], [493.0, 1300.0]]], "lines": ["．．．", "．．．"]}, {"box": [745, 979, 1037, 1154], "vertical": false, "font_size": 171, "lines_coords": [[[745.0, 983.0], [1025.0, 964.0], [1036.0, 1149.0], [756.0, 1168.0]]], "lines": ["でもねえ"]}, {"box": [34, 1196, 167, 1240], "vertical": false, "font_size": 13, "lines_coords": [[[42.0, 1196.0], [117.0, 1196.0], [117.0, 1211.0], [42.0, 1211.0]], [[42.0, 1212.0], [160.0, 1212.0], [160.0, 1227.0], [42.0, 1227.0]], [[43.0, 1226.0], [131.0, 1226.0], [131.0, 1241.0], [43.0, 1241.0]]], "lines": ["．．．", "それ回結干デザイン事態所", "やっ！！？それ知識様子ヶ瀬戸建東）"]}, {"box": [937, 1229, 1070, 1248], "vertical": false, "font_size": 18, "lines_coords": [[[942.0, 1230.0], [1065.0, 1230.0], [1065.0, 1250.0], [942.0, 1250.0]]], "lines": ["Ａｍａｚｏｕ機能ＳＥＲＩＥＳ"]}], "img_path": "159.jpg"}, {"version": "0.2.4", "img_width": 1125, "img_height": 1600, "blocks": [{"box": [105, 16, 291, 44], "vertical": false, "font_size": 30, "lines_coords": [[[105.0, 14.0], [291.0, 14.0], [291.0, 46.0], [105.0, 46.0]]], "lines": ["ＲａｗＬａｚｙＣｏｍ"]}, {"box": [865, 1553, 1011, 1583], "vertical": false, "font_size": 33, "lines_coords": [[[865.0, 1550.0], [1011.0, 1550.0], [1011.0, 1586.0], [8