968.0, 106.0], [1000.0, 106.0], [1000.0, 345.0], [968.0, 345.0]], [[925.0, 106.0], [957.0, 106.0], [957.0, 346.0], [925.0, 346.0]], [[882.0, 106.0], [915.0, 106.0], [915.0, 314.0], [882.0, 314.0]], [[839.0, 104.0], [870.0, 104.0], [870.0, 378.0], [839.0, 378.0]]], "lines": ["依存症の中には", "私の専門とする", "恋愛に関する", "依存症もあります"]}, {"box": [105, 16, 292, 44], "vertical": false, "font_size": 30, "lines_coords": [[[105.0, 14.0], [292.0, 14.0], [292.0, 46.0], [105.0, 46.0]]], "lines": ["ＲａｗＬａｚｙＣｏｍ"]}, {"box": [114, 826, 275, 1104], "vertical": true, "font_size": 36, "lines_coords": [[[239.0, 828.0], [271.0, 828.0], [273.0, 1103.0], [240.0, 1103.0]], [[193.0, 826.0], [235.0, 826.0], [235.0, 1073.0], [193.0, 1073.0]], [[153.0, 829.0], [190.0, 829.0], [190.0, 1104.0], [153.0, 1104.0]], [[114.0, 829.0], [145.0, 829.0], [145.0, 1068.0], [114.0, 1068.0]]], "lines": ["好きな人のことで", "頭がいっぱいで", "レポートの提出も", "忘れてしまう．．．"]}, {"box": [848, 1104, 976, 1398], "vertical": true, "font_size": 39, "lines_coords": [[[940.0, 1107.0], [975.0, 1107.0], [976.0, 1359.0], [942.0, 1359.0]], [[895.0, 1104.0], [939.0, 1104.0], [934.0, 1398.0], [890.0, 1398.0]], [[851.0, 1107.0], [889.0, 1107.0], [885.0, 1396.0], [848.0, 1396.0]]], "lines": ["そんなことでは", "社会生活に支障が", "でてしまいますね"]}, {"box": [865, 1553, 1009, 1581], "vertical": false, "font_size": 28, "lines_coords": [[[865.0, 1553.0], [1009.0, 1553.0], [1009.0, 1581.0], [865.0, 1581.0]]], "lines": ["これ．．．Ｒａｗ．Ｓｅ"]}, {"box": [107, 1285, 154, 1480], "vertical": true, "font_size": 44, "lines_coords": [[[107.0, 1287.0], [151.0, 1285.0], [154.0, 1415.0], [110.0, 1417.0]]], "lines": ["しかし"]}], "img_path": "066.jpg"}, {"version": "0.2.4", "img_width": 1125, "img_height": 1600, "blocks": [{"box": [892, 164, 981, 353], "vertical": true, "font_size": 42, "lines_coords": [[[943.0, 167.0], [981.0, 167.0], [981.0, 353.0], [943.0, 353.0]], [[895.0, 164.0], [940.0, 165.0], [937.0, 284.0], [892.0, 282.0]]], "lines": ["恋と依存は", "紙一重"]}, {"box": [107, 17, 291, 43], "vertical": false, "font_size": 28, "lines_coords": [[[107.0, 15.0], [291.0, 15.0], [291.0, 45.0], [107.0, 45.0]]], "lines": ["ＲａｖｌａｚｙＣｏｍ"]}, {"box": [147, 139, 341, 403], "vertical": true, "font_size": 30, "lines_coords": [[[309.0, 139.0], [340.0, 139.0], [337.0, 403.0], [306.0, 403.0]], [[270.0, 140.0], [298.0, 140.0], [296.0, 368.0], [268.0, 368.0]], [[228.0, 142.0], [260.0, 142.0], [260.0, 401.0], [228.0, 401.0]], [[187.0, 142.0], [218.0, 142.0], [218.0, 368.0], [187.0, 368.0]], [[148.0, 140.0], [175.0, 140.0], [175.0, 304.0], [148.0, 304.0]]], "lines": ["日常のストレスを", "恋で発散しても", "ストレス反応の元", "ストレッサーは", "消えません"]}, {"box": [850, 576, 997, 825], "vertical": true, "font_size": 30, "lines_coords": [[[965.0, 578.0], [996.0, 578.0], [996.0, 825.0], [965.0, 825.0]], [[926.0, 576.0], [957.0, 576.0], [957.0, 796.0], [926.0, 796.0]], [[890.0, 578.0], [917.0, 578.0], [917.0, 764.0], [890.0, 764.0]], [[850.0, 578.0], [881.0, 578.0], [881.0, 796.0], [850.0, 796.0]]], "lines": ["脳の可塑性により", "恋愛への欲求は", "より強くなり", "止められない．．．"]}, {"box": [370, 585, 532, 625], "vertical": false, "font_size": 33, "lines_coords": [[[370.0, 592.0], [531.0, 585.0], [532.0, 618.0], [371.0, 625.0]]], "lines": ["・行動的反応"]}, {"box": [150, 589, 295, 809], "vertical": true, "font_size": 31, "lines_coords": [[[262.0, 589.0], [293.0, 589.0], [293.0, 775.0], [262.0, 775.0]], [[223.0, 593.0], [257.0, 593.0], [257.0, 685.0], [223.0, 685.0]], [[184.0, 590.0], [217.0, 590.0], [217.0, 809.0], [184.0, 809.0]], [[150.0, 593.0], [176.0, 593.0], [176.0, 809.0], [150.0, 809.0]]], "lines": ["そうならない", "ための", "正しいストレス", "コーヒングです"]}, {"box": [479, 990, 583, 1380], "vertical": true, "font_size": 28, "lines_coords": [[[551.0, 992.0], [582.0, 992.0], [582.0, 1203.0], [551.0, 1203.0]], [[517.0, 995.0], [543.0, 995.0], [543.0, 1376.0], [517.0, 1376.0]], [[479.0, 995.0], [506.0, 995.0], [506.0, 1142.0], [479.0, 1142.0]]], "lines": ["すこやかな心は", "正しい自己コントロールから", "生まれます"]}, {"box": [382, 990, 417, 1108], "vertical": true, "font_size": 35, "lines_coords": [[[382.0, 990.0], [417.0, 990.0], [417.0, 1062.0], [382.0, 1062.0]]], "lines": ["では"]}, {"box": [897, 991, 1003, 1410], "vertical": true, "font_size": 29, "lines_coords": [[[971.0, 992.0], [1003.0, 992.0], [1003.0, 1409.0], [971.0, 1409.0]], [[934.0, 993.0], [962.0, 993.0], [964.0, 1303.0], [935.0, 1303.0]], [[898.0, 993.0], [925.0, 993.0], [925.0, 1260.0], [898.0, 1260.0]]], "lines": ["あなたのストレッサーはなに？", "取り除ける？もしくは", "認識を変えられる？"]}, {"box": [867, 1552, 1008, 1581], "vertical": false, "font_size": 29, "lines_coords": [[[867.0, 1552.0], [1008.0, 1552.0], [1008.0, 1581.0], [867.0, 1581.0]]], "lines": ["むし．．．Ｒａｗ．Ｓｅ"]}, {"box": [149, 1312, 171, 1393], "vertical": true, "font_size": 22, "lines_coords": [[[149.0, 1312.0], [171.0, 1312.0], [171.0, 1393.0], [149.0, 1393.0]]], "lines": ["．．．．．．"]}], "img_path": "067.jpg"}, {"version": "0.2.4", "img_width": 1125, "img_height": 1600, "blocks": [{"box": [909, 52, 979, 363], "vertical": true, "font_size": 32, "lines_coords": [[[948.0, 54.0], [979.0, 54.0], [979.0, 362.0], [948.0, 362.0]], [[909.0, 53.0], [942.0, 53.0], [942.0, 306.0], [909.0, 306.0]]], "lines": ["やっぱり百目鬼先生の", "授業は面白いねー"]}, {"box": [742, 217, 773, 375], "vertical": true, "font_size": 31, "lines_coords": [[[742.0, 217.0], [773.0, 217.0], [773.0, 375.0], [742.0, 375.0]]], "lines": ["そうです？"]}, {"box": [481, 131, 615, 328], "vertical": true, "font_size": 28, "lines_coords": [[[587.0, 132.0], [614.0, 132.0], [614.0, 328.0], [587.0, 328.0]], [[551.0, 131.0], [579.0, 131.0], [576.0, 271.0], [548.0, 271.0]], [[514.0, 131.0], [542.0, 131.0], [545.0, 328.0], [517.0, 328.0]], [[481.0, 131.0], [509.0, 131.0], [509.0, 245.0], [481.0, 245.0]]], "lines": ["服装は普段通り", "変でしたが", "授業内容が普通", "すぎて．．．"]}, {"box": [107, 18, 291, 42], "vertical": false, "font_size": 26, "lines_coords": [[[107.0, 16.0], [291.0, 16.0], [291.0, 44.0], [107.0, 44.0]]], "lines": ["ＲａｖｌａｚｙＣｏｍ"]}, {"box": [107, 131, 240, 356], "vertical": true, "font_size": 28, "lines_coords": [[[207.0, 131.0], [240.0, 131.0], [240.0, 220.0], [207.0, 220.0]], [[176.0, 132.0], [203.0, 132.0], [203.0, 326.0], [176.0, 326.0]], [[139.0, 131.0], [167.0, 131.0], [170.0, 273.0], [142.0, 273.0]], [[107.0, 131.0], [129.0, 131.0], [129.0, 353.0], [107.0, 353.0]]], "lines": ["そこに", "違和感があって", "頭に入って", "きませんでしたね"]}, {"box": [489, 559, 621, 701], "vertical": true, "font_size": 27, "lines_coords": [[[593.0, 559.0], [621.0, 559.0], [621.0, 646.0], [593.0, 646.0]], [[556.0, 559.0], [584.0, 559.0], [585.0, 700.0], [557.0, 700.0]], [[523.0, 559.0], [550.0, 559.0], [550.0, 700.0], [523.0, 700.0]], [[489.0, 560.0], [515.0, 560.0], [515.0, 701.0], [489.0, 701.0]]], "lines": ["そう？", "私は恋愛で", "色々例えて", "くれるから"]}, {"box": [115, 535, 248, 732], "vertical": true, "font_size": 27, "lines_coords": [[[218.0, 535.0], [245.0, 535.0], [248.0, 703.0], [221.0, 703.0]], [[185.0, 535.0], [212.0, 535.0], [212.0, 731.0], [185.0, 731.0]], [[150.0, 535.0], [176.0, 535.0], [176.0, 732.0], [150.0, 732.0]], [[115.0, 535.0], [142.0, 535.0], [142.0, 629.0], [115.0, 629.0]]], "lines": ["わかるーって", "なってスーって", "頭に入ってきた", "けどな"]}, {"box": [825, 928, 973, 1270], "vertical": true, "font_size": 28, "lines_coords": [[[942.0, 929.0], [973.0, 929.0], [973.0, 1146.0], [942.0, 1146.0]], [[901.0, 928.0], [932.0, 928.0], [932.0, 1115.0], [901.0, 1115.0]], [[867.0, 931.0], [893.0, 931.0], [893.0, 1270.0], [867.0, 1270.0]], [[825.0, 929.0], [851.0, 929.0], [851.0, 1081.0], [825.0, 1081.0]]], "lines": ["わかりませんね", "人間の悩みは", "ほとんど人間関係による", "ものなのに"]}, {"box": [334, 898, 440, 1225], "vertical": true, "font_size": 31, "lines_coords": [[[409.0, 898.0], [440.0, 898.0], [440.0, 1168.0], [409.0, 1168.0]], [[371.0, 898.0], [403.0, 898.0], [403.0, 1225.0], [371.0, 1225.0]], [[334.0, 900.0], [365.0, 900.0], [365.0, 1081.0], [334.0, 1081.0]]], "lines": ["そのストレス解消に", "人と付き合う恋愛なんて", "本末転倒です"]}, {"box": [120, 990, 191, 1178], "vertical": true, "font_size": 32, "lines_coords": [[[157.0, 990.0], [190.0, 990.0], [190.0, 1150.0], [157.0, 1150.0]], [[120.0, 992.0], [151.0, 992.0], [