1063, 796, 1254, 1152], "vertical": true, "font_size": 30, "lines_coords": [[[1221.0, 802.0], [1249.0, 802.0], [1249.0, 1086.0], [1221.0, 1086.0]], [[1177.0, 796.0], [1211.0, 796.0], [1213.0, 1152.0], [1179.0, 1152.0]], [[1137.0, 800.0], [1171.0, 800.0], [1173.0, 1056.0], [1139.0, 1056.0]], [[1103.0, 800.0], [1131.0, 800.0], [1131.0, 1056.0], [1103.0, 1056.0]], [[1063.0, 802.0], [1091.0, 802.0], [1091.0, 1024.0], [1063.0, 1024.0]]], "lines": ["来年この人気講義が", "とれる確実性がないので", "先生にお願いして", "「もぐり」をさせて", "もらっています"]}, {"box": [621, 542, 737, 676], "vertical": true, "font_size": 38, "lines_coords": [[[701.0, 544.0], [737.0, 544.0], [737.0, 676.0], [701.0, 676.0]], [[663.0, 544.0], [699.0, 544.0], [699.0, 676.0], [663.0, 676.0]], [[621.0, 542.0], [663.0, 542.0], [663.0, 646.0], [621.0, 646.0]]], "lines": ["同じ学科", "だったん", "ですね"]}, {"box": [191, 524, 261, 696], "vertical": true, "font_size": 33, "lines_coords": [[[221.0, 524.0], [261.0, 524.0], [261.0, 590.0], [221.0, 590.0]], [[191.0, 530.0], [217.0, 530.0], [217.0, 696.0], [191.0, 696.0]]], "lines": ["えっ", "恋愛心理学！？"]}, {"box": [219, 790, 491, 1084], "vertical": true, "font_size": 33, "lines_coords": [[[457.0, 794.0], [491.0, 794.0], [491.0, 1020.0], [457.0, 1020.0]], [[415.0, 794.0], [449.0, 794.0], [449.0, 1084.0], [415.0, 1084.0]], [[377.0, 794.0], [411.0, 794.0], [411.0, 1050.0], [377.0, 1050.0]], [[337.0, 790.0], [375.0, 790.0], [375.0, 864.0], [337.0, 864.0]], [[299.0, 796.0], [327.0, 796.0], [327.0, 1082.0], [299.0, 1082.0]], [[257.0, 794.0], [291.0, 794.0], [291.0, 1052.0], [257.0, 1052.0]], [[219.0, 794.0], [247.0, 794.0], [247.0, 1016.0], [219.0, 1016.0]]], "lines": ["高額な授業料を", "払ってるんですから", "元は取らないと．．", "まぁ", "授業を寝てる人には", "理解できないかも", "しれませんが．．．"]}, {"box": [1199, 1438, 1281, 1584], "vertical": true, "font_size": 39, "lines_coords": [[[1247.0, 1442.0], [1281.0, 1442.0], [1281.0, 1584.0], [1247.0, 1584.0]], [[1199.0, 1438.0], [1243.0, 1438.0], [1243.0, 1554.0], [1199.0, 1554.0]]], "lines": ["そろそろ", "ですね"]}, {"box": [151, 1166, 313, 1345], "vertical": true, "font_size": 44, "lines_coords": [[[259.0, 1178.0], [313.0, 1178.0], [313.0, 1264.0], [259.0, 1264.0]], [[221.0, 1184.0], [265.0, 1184.0], [265.0, 1292.0], [221.0, 1292.0]], [[153.0, 1166.0], [187.0, 1166.0], [187.0, 1344.0], [153.0, 1344.0]]], "lines": ["は．．．", "はい．．", "ごめんなさい、"]}, {"box": [209, 1444, 265, 1598], "vertical": true, "font_size": 56, "lines_coords": [[[209.0, 1444.0], [265.0, 1444.0], [265.0, 1598.0], [209.0, 1598.0]]], "lines": ["音楽？"]}], "img_path": "033.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [], "img_path": "034.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [659, 154, 743, 484], "vertical": true, "font_size": 84, "lines_coords": [[[659.0, 154.0], [743.0, 154.0], [743.0, 484.0], [659.0, 484.0]]], "lines": ["マリア．．．"]}, {"box": [537, 1204, 574, 1406], "vertical": true, "font_size": 34, "lines_coords": [[[537.0, 1204.0], [571.0, 1204.0], [571.0, 1406.0], [537.0, 1406.0]]], "lines": ["これはまた："]}, {"box": [143, 992, 255, 1262], "vertical": true, "font_size": 108, "lines_coords": [[[143.0, 994.0], [251.0, 992.0], [255.0, 1260.0], [147.0, 1262.0]]], "lines": ["先生！？"]}], "img_path": "035.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [1173, 200, 1257, 453], "vertical": true, "font_size": 39, "lines_coords": [[[1213.0, 200.0], [1257.0, 200.0], [1257.0, 312.0], [1213.0, 312.0]], [[1173.0, 202.0], [1207.0, 202.0], [1207.0, 452.0], [1173.0, 452.0]]], "lines": ["はーい", "みんなー元気ー"]}, {"box": [727, 172, 795, 504], "vertical": true, "font_size": 29, "lines_coords": [[[761.0, 172.0], [791.0, 172.0], [793.0, 414.0], [763.0, 414.0]], [[727.0, 174.0], [755.0, 174.0], [755.0, 504.0], [727.0, 504.0]]], "lines": ["今日はアイドルを", "イメージしてみましたー"]}, {"box": [535, 166, 625, 298], "vertical": true, "font_size": 26, "lines_coords": [[[597.0, 168.0], [625.0, 168.0], [625.0, 296.0], [597.0, 296.0]], [[561.0, 166.0], [589.0, 166.0], [589.0, 296.0], [561.0, 296.0]], [[535.0, 170.0], [557.0, 170.0], [557.0, 298.0], [535.0, 298.0]]], "lines": ["もうそこっ", "キツいとか", "いわない～"]}, {"box": [357, 160, 421, 318], "vertical": true, "font_size": 32, "lines_coords": [[[385.0, 160.0], [421.0, 160.0], [421.0, 244.0], [385.0, 244.0]], [[357.0, 162.0], [385.0, 162.0], [385.0, 318.0], [357.0, 318.0]]], "lines": ["えっ？", "いってない？"]}, {"box": [205, 156, 271, 338], "vertical": true, "font_size": 32, "lines_coords": [[[235.0, 158.0], [271.0, 158.0], [271.0, 242.0], [235.0, 242.0]], [[207.0, 156.0], [235.0, 156.0], [233.0, 336.0], [205.0, 336.0]]], "lines": ["いつも", "こんななの．．．？"]}, {"box": [169, 554, 287, 720], "vertical": true, "font_size": 36, "lines_coords": [[[247.0, 554.0], [287.0, 554.0], [287.0, 628.0], [247.0, 628.0]], [[211.0, 560.0], [245.0, 560.0], [245.0, 720.0], [211.0, 720.0]], [[169.0, 558.0], [203.0, 558.0], [203.0, 716.0], [169.0, 716.0]]], "lines": ["まぁ", "人気なのも", "わかるよね"]}, {"box": [1075, 960, 1209, 1302], "vertical": true, "font_size": 39, "lines_coords": [[[1167.0, 960.0], [1209.0, 960.0], [1209.0, 1080.0], [1167.0, 1080.0]], [[1121.0, 962.0], [1161.0, 962.0], [1161.0, 1302.0], [1121.0, 1302.0]], [[1077.0, 962.0], [1111.0, 962.0], [1111.0, 1300.0], [1077.0, 1300.0]]], "lines": ["皆さん", "「先生おかしー」って", "思ったんじゃない？"]}, {"box": [171, 920, 393, 1352], "vertical": true, "font_size": 38, "lines_coords": [[[351.0, 920.0], [391.0, 920.0], [391.0, 1318.0], [351.0, 1318.0]], [[309.0, 920.0], [349.0, 920.0], [349.0, 1248.0], [309.0, 1248.0]], [[263.0, 920.0], [303.0, 920.0], [303.0, 1352.0], [263.0, 1352.0]], [[219.0, 922.0], [255.0, 922.0], [255.0, 1068.0], [219.0, 1068.0]], [[171.0, 920.0], [207.0, 920.0], [211.0, 1102.0], [175.0, 1102.0]]], "lines": ["それは皆さんが過去経験", "してきた「先生」とは", "違う．．．と感じたからよね？", "でも事実", "私は先生："]}, {"box": [181, 1536, 413, 1858], "vertical": true, "font_size": 32, "lines_coords": [[[377.0, 1540.0], [411.0, 1540.0], [411.0, 1858.0], [377.0, 1858.0]], [[341.0, 1540.0], [369.0, 1540.0], [369.0, 1734.0], [341.0, 1734.0]], [[295.0, 1536.0], [329.0, 1536.0], [331.0, 1858.0], [297.0, 1858.0]], [[255.0, 1536.0], [289.0, 1536.0], [291.0, 1798.0], [257.0, 1798.0]], [[217.0, 1536.0], [251.0, 1536.0], [251.0, 1856.0], [217.0, 1856.0]], [[181.0, 1540.0], [209.0, 1540.0], [209.0, 1702.0], [181.0, 1702.0]]], "lines": ["時として人を不合理に", "させてしまう", "誰しもが無意識に持つ", "心のフィルター．．．", "これを「認知バイアス」", "と言います"]}], "img_path": "036.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [1068, 160, 1270, 400], "vertical": true, "font_size": 33, "lines_coords": [[[1235.0, 162.0], [1269.0, 162.0], [1269.0, 398.0], [1235.0, 398.0]], [[1191.0, 162.0], [1225.0, 162.0], [1225.0, 332.0], [1191.0, 332.0]], [[1151.0, 162.0], [1185.0, 162.0], [1185.0, 400.0], [1151.0, 400.0]], [[1105.0, 160.0], [1141.0, 160.0], [1143.0, 332.0], [1107.0, 332.0]], [[1069.0, 164.0], [1097.0, 164.0], [1097.0, 398.0], [1069.0, 398.0]]], "lines": ["人の脳は合理的", "判断を常に", "くだせていると", "勘違いして", "しまうのよね．．．"]}, {"box": [507, 473, 544, 633], "vertical": true, "font_size": 34, "lines_coords": [[[507.0, 474.0], [541.0, 474.0], [541.0, 632.0], [507.0, 632.0]]], "lines": ["メイさん♡"]}, {"box": [161, 806, 245, 890], "vertical": false, "font_size": 76, "lines_coords": [[[169.0, 806.0], [245.0, 814.0], [237.0, 890.0], [161.0, 882.0]]], "lines": ["！？"]}, {"box": [1053, 1278, 1287, 1634], "vertical": true, "font_size": 32, "lines_coords": [[[1251.0, 1278.0], [1285.0, 1278.0], [1287.0, 1506.0], [1253.0, 1506.0]], [[1213.0, 1280.0], [1247.0, 1280.0], [1247.0, 1634.0], [1213.0, 1634.0]], [[1175.0, 1282.0], [1203.0, 1282.0], [1203.0, 1600.0], [1175.0, 1600.0]], [[1135.0, 1280.0], [1163.0, 1280.0], [1163.0, 1598.0], [1135.0, 1598.0]], [[1093.0, 1280.0], [1127.0, 1280.0], [1127.0, 1602.0], [1093.0, 1602.0]], [[1053.0, 1280.0], [1087.0, 1280.0], [1087.0, 1536.0], [1053.0, 1536.0]]], "lines": ["人は恋に落ちて", "ドキドキするのではなく、", "高い心拍数という事実", "そして私という美女が", "隣にいるという状況を", "無意識につなげて"]}, {"box": [169, 1004, 243, 1126], "vertical": true, "font_size": 40, "lines_coords": [[[197.0, 1004.0], [243.0, 1004.0], [243.0, 1078.0], [197.0, 1078.0]], [[169.0, 1010.0], [203.0, 1010.0], [203.0, 1126.0], [169.0, 1126.0]]], "lines": ["今の", "私にっ！！"]}, {"box": [225, 1214, 380, 1473], "vertical": true, "font_size": 32, "lines_coords": [[[343.0, 1216.0], [377.0, 1216.0], [373.0, 1408.0], [339.0, 1408.0]], [[303.0, 1216.0], [337.0, 1216.0], [337.0, 1412.0], [303.0, 1412.0]], [[261.0, 1214.0], [295.0, 1214.0], [295.0, 1470.0], [261.0, 1470.0]], [[225.0, 1218.0], [253.0, 1218.0], [253.0, 1408.0], [225.0, 1408.0]]], "lines": ["「これは恋だ」", "そう判断して", "しまっているだけ", "かもしれない"]}, {"box": [215, 1636, 363, 1880], "vertical": true, "font_size": 38, "lines_coords": [[[319.0, 1636.0], [363.0, 1636.0], [363.0, 1734.0], [319.0, 1734.0]], [[281.0, 1636.0], [325.0, 1636.0], [325.0, 1736.0], [281.0, 1736.0]], [[247.0, 1640.0], [283.0, 1640.0], [283.0, 1766.0], [247.0, 1766.0]], [[215.0, 1640.0], [243.0, 1640.0], [243.0, 1878.0], [215.0, 1878.0]]], "lines": ["そこで", "今日の", "ワークを", "やってみましょう"]}], "img_path": "037.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [1081, 86, 1273, 280], "vertical": true, "font_size": 32, "lines_coords": [[[1239.0, 88.0], [1273.0, 88.0], [1273.0, 218.0], [1239.0, 218.0]], [[1197.0, 88.0], [1231.0, 88.0], [1231.0, 278.0], [1197.0, 278.0]], [[1159.0, 86.0], [1193.0, 86.0], [1193.0, 280.0], [1159.0, 280.0]], [[1121.0, 86.0], [1151.0, 86.0], [1147.0, 248.0], [1117.0, 248.0]], [[1083.0, 88.0], [1111.0, 88.0], [1109.0, 280.0], [1081.0, 280.0]]], "lines": ["隣の人と", "ペアを作って", "今から１０分間", "ワークーを", "おこないます"]}, {"box": [913, 156, 951, 320], "vertical": true, "font_size": 34, "lines_coords": [[[917.0, 156.0], [951.0, 156.0], [947.0, 320.0], [913.0, 320.0]]], "lines": ["では始めて"]}, {"box": [690, 163, 721, 343], "vertical": true, "font_size": 28, "lines_coords": [[[691.0, 164.0], [719.0, 164.0], [719.0, 342.0], [691.0, 342.0]]], "lines": ["ねぇ渡辺さ．．．"]}, {"box": [199, 148, 315, 390], "vertical": true, "font