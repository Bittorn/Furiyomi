": "160.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [113, 1900, 507, 1928], "vertical": false, "font_size": 26, "lines_coords": [[[113.0, 1902.0], [507.0, 1900.0], [507.0, 1926.0], [113.0, 1928.0]]], "lines": ["コミックス第３巻へつづく"]}], "img_path": "161.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [1111, 82, 1269, 110], "vertical": false, "font_size": 28, "lines_coords": [[[1111.0, 82.0], [1269.0, 82.0], [1269.0, 110.0], [1111.0, 110.0]]], "lines": ["あとがき"]}, {"box": [993, 178, 1292, 660], "vertical": true, "font_size": 41, "lines_coords": [[[1249.0, 186.0], [1289.0, 186.0], [1291.0, 660.0], [1251.0, 660.0]], [[1195.0, 184.0], [1237.0, 184.0], [1239.0, 624.0], [1197.0, 624.0]], [[1147.0, 180.0], [1189.0, 180.0], [1189.0, 506.0], [1147.0, 506.0]], [[1097.0, 178.0], [1137.0, 178.0], [1137.0, 622.0], [1097.0, 622.0]], [[1043.0, 184.0], [1083.0, 184.0], [1085.0, 622.0], [1045.0, 622.0]], [[993.0, 184.0], [1033.0, 184.0], [1033.0, 582.0], [993.0, 582.0]]], "lines": ["ここまで読んでくださって", "ありがとうございます！", "奥たまむしです！", "買ってくださった皆様の", "おかげでこの友な漫画は、", "生かされております！"]}, {"box": [561, 74, 1051, 758], "vertical": true, "font_size": 406, "lines_coords": [[[649.0, 74.0], [1051.0, 130.0], [963.0, 758.0], [561.0, 702.0]]], "lines": ["神．．．あーどう"]}, {"box": [442, 154, 659, 656], "vertical": true, "font_size": 35, "lines_coords": [[[617.0, 158.0], [657.0, 158.0], [657.0, 636.0], [617.0, 636.0]], [[575.0, 156.0], [609.0, 156.0], [609.0, 524.0], [575.0, 524.0]], [[533.0, 154.0], [567.0, 154.0], [567.0, 656.0], [533.0, 656.0]], [[489.0, 160.0], [523.0, 160.0], [523.0, 488.0], [489.0, 488.0]], [[445.0, 164.0], [479.0, 164.0], [479.0, 624.0], [445.0, 624.0]]], "lines": ["さて皆全力で一斉に走らせて", "そろそろバトルの下地", "今作用的にどれ恋はバトル漫画ですか", "ができてきましたが、", "一人だけ強くないですか．．．っ"]}, {"box": [139, 166, 199, 418], "vertical": true, "font_size": 50, "lines_coords": [[[139.0, 170.0], [189.0, 168.0], [197.0, 392.0], [147.0, 394.0]]], "lines": ["え？私？"]}, {"box": [1245, 772, 1284, 1022], "vertical": true, "font_size": 34, "lines_coords": [[[1245.0, 772.0], [1279.0, 772.0], [1283.0, 1022.0], [1249.0, 1022.0]]], "lines": ["この方も強い．．．"]}, {"box": [707, 746, 913, 1233], "vertical": true, "font_size": 206, "lines_coords": [[[707.0, 786.0], [913.0, 786.0], [913.0, 1176.0], [707.0, 1176.0]]], "lines": ["バェラはオレのんてのかん"]}, {"box": [646, 773, 685, 1212], "vertical": true, "font_size": 34, "lines_coords": [[[647.0, 778.0], [681.0, 778.0], [681.0, 1210.0], [647.0, 1210.0]]], "lines": ["あとこの方も結構攻める．．．"]}, {"box": [153, 778, 285, 1256], "vertical": true, "font_size": 68, "lines_coords": [[[221.0, 780.0], [279.0, 778.0], [285.0, 950.0], [227.0, 952.0]], [[153.0, 810.0], [231.0, 804.0], [263.0, 1250.0], [185.0, 1256.0]]], "lines": ["えっ？", "なんのことですか？"]}, {"box": [1247, 1320, 1296, 1498], "vertical": true, "font_size": 44, "lines_coords": [[[1247.0, 1320.0], [1291.0, 1320.0], [1295.0, 1498.0], [1251.0, 1498.0]]], "lines": ["頑張れっ"]}, {"box": [145, 1310, 348, 1622], "vertical": true, "font_size": 33, "lines_coords": [[[315.0, 1318.0], [343.0, 1318.0], [343.0, 1518.0], [315.0, 1518.0]], [[267.0, 1310.0], [307.0, 1310.0], [307.0, 1622.0], [267.0, 1622.0]], [[225.0, 1314.0], [261.0, 1314.0], [263.0, 1588.0], [227.0, 1588.0]], [[185.0, 1320.0], [219.0, 1320.0], [219.0, 1604.0], [185.0, 1604.0]], [[145.0, 1318.0], [173.0, 1318.0], [173.0, 1512.0], [145.0, 1512.0]]], "lines": ["２巻は先生が", "見せつけられすぎで", "かわいそうだった", "こので、おまけ漫画を", "描きましたと"]}, {"box": [709, 1318, 806, 1882], "vertical": true, "font_size": 41, "lines_coords": [[[763.0, 1324.0], [803.0, 1324.0], [799.0, 1882.0], [759.0, 1882.0]], [[709.0, 1318.0], [751.0, 1318.0], [751.0, 1642.0], [709.0, 1642.0]]], "lines": ["次巻頑張ってもらいたいです！", "〈個人の見解です〉"]}, {"box": [433, 1320, 630, 1838], "vertical": true, "font_size": 39, "lines_coords": [[[593.0, 1326.0], [627.0, 1326.0], [627.0, 1556.0], [593.0, 1556.0]], [[537.0, 1320.0], [577.0, 1320.0], [577.0, 1838.0], [537.0, 1838.0]], [[485.0, 1320.0], [525.0, 1320.0], [529.0, 1832.0], [489.0, 1832.0]], [[435.0, 1322.0], [477.0, 1322.0], [475.0, 1838.0], [433.0, 1838.0]]], "lines": ["というわけで", "とよければまた見てください！！", "「メイをめぐってわちゃわぢゃ", "してくるはず．．．どうなるか！？"]}, {"box": [253, 1950, 1173, 1978], "vertical": false, "font_size": 28, "lines_coords": [[[253.0, 1950.0], [1173.0, 1950.0], [1173.0, 1978.0], [253.0, 1978.0]]], "lines": ["読者様、そして関係君の皆様、いつもありがとうツざぃます！感謝！"]}, {"box": [217, 1820, 361, 1894], "vertical": false, "font_size": 58, "lines_coords": [[[223.0, 1820.0], [361.0, 1836.0], [355.0, 1894.0], [217.0, 1878.0]]], "lines": ["Ｎｅ！！"]}], "img_path": "162.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [1097, 147, 1286, 423], "vertical": true, "font_size": 41, "lines_coords": [[[1243.0, 148.0], [1283.0, 148.0], [1283.0, 422.0], [1243.0, 422.0]], [[1195.0, 148.0], [1235.0, 148.0], [1235.0, 350.0], [1195.0, 350.0]], [[1147.0, 150.0], [1187.0, 150.0], [1187.0, 386.0], [1147.0, 386.0]], [[1097.0, 150.0], [1141.0, 150.0], [1141.0, 270.0], [1097.0, 270.0]]], "lines": ["どうせ同期生の", "白沢さんと", "ひっつくんで", "しょ！？"]}, {"box": [657, 60, 1245, 108], "vertical": false, "font_size": 46, "lines_coords": [[[657.0, 62.0], [1245.0, 60.0], [1245.0, 106.0], [657.0, 108.0]]], "lines": ["私のないマリア先生のＰＨ"]}, {"box": [707, 172, 769, 368], "vertical": true, "font_size": 58, "lines_coords": [[[707.0, 174.0], [765.0, 174.0], [765.0, 368.0], [707.0, 368.0]]], "lines": ["にぎにぎ"]}, {"box": [369, 64, 633, 102], "vertical": false, "font_size": 34, "lines_coords": [[[369.0, 68.0], [633.0, 64.0], [633.0, 98.0], [369.0, 102.0]]], "lines": ["本編とは関係"]}, {"box": [487, 152, 639, 456], "vertical": true, "font_size": 46, "lines_coords": [[[591.0, 152.0], [639.0, 152.0], [633.0, 456.0], [585.0, 456.0]], [[537.0, 154.0], [585.0, 154.0], [585.0, 330.0], [537.0, 330.0]], [[487.0, 160.0], [529.0, 160.0], [529.0, 366.0], [487.0, 366.0]]], "lines": ["でもメイさん．．．", "恋なんて", "一時のもの"]}, {"box": [167, 134, 300, 466], "vertical": true, "font_size": 41, "lines_coords": [[[259.0, 134.0], [299.0, 134.0], [299.0, 394.0], [259.0, 394.0]], [[213.0, 134.0], [253.0, 134.0], [253.0, 466.0], [213.0, 466.0]], [[167.0, 134.0], [209.0, 134.0], [209.0, 354.0], [167.0, 354.0]]], "lines": ["人生百年時代．．．", "その中で最も大切な", "もの：それは"]}, {"box": [711, 521, 899, 762], "vertical": true, "font_size": 38, "lines_coords": [[[861.0, 524.0], [897.0, 524.0], [897.0, 682.0], [861.0, 682.0]], [[809.0, 522.0], [849.0, 522.0], [849.0, 758.0], [809.0, 758.0]], [[761.0, 524.0], [797.0, 524.0], [797.0, 682.0], [761.0, 682.0]], [[711.0, 522.0], [751.0, 522.0], [751.0, 762.0], [711.0, 762.0]]], "lines": ["漫画でも", "白髪と黒髪が", "統計的に", "ひっつくしー"]}, {"box": [1115, 858, 1299, 1472], "vertical": true, "font_size": 184, "lines_coords": [[[1115.0, 858.0], [1299.0, 858.0], [1299.0, 1472.0], [1115.0, 1472.0]]], "lines": ["お金よ！！"]}, {"box": [135, 882, 551, 1453], "vertical": true, "font_size": 61, "lines_coords": [[[485.0, 884.0], [547.0, 884.0], [547.0, 1328.0], [485.0, 1328.0]], [[419.0, 884.0], [475.0, 884.0], [475.0, 1228.0], [419.0, 1228.0]], [[345.0, 884.0], [407.0, 884.0], [407.0, 1444.0], [345.0, 1444.0]], [[275.0, 884.0], [331.0, 882.0], [337.0, 1114.0], [281.0, 1116.0]], [[201.0, 882.0], [269.0, 882.0], [269.0, 1450.0], [201.0, 1450.0]], [[135.0, 882.0], [197.0, 882.0], [197.0, 1340.0], [135.0, 1340.0]]], "lines": ["お金の心配がない", "良い暮らし！！", "私なら貯金も老後まで", "あるし！", "資産運用もばっちり！", "不動産も潤沢よ！"]}, {"box": [1005, 1546, 1295, 1882], "vertical": true, "font_size": 51, "lines_coords": [[[1245.0, 1548.0], [1295.0, 1548.0], [1295.0, 1696.0], [1245.0, 1696.0]], [[1183.0, 1548.0], [1237.0, 1548.0], [1237.0, 1840.0], [1183.0, 1840.0]], [[1125.0, 1548.0], [1173.0, 1548.0], [1173.0, 1882.0], [1125.0, 1882.0]], [[1061.0, 1548.0], [1115.0, 1548.0], [1115.0, 1838.0], [1061.0, 1838.0]], [[1007.0, 1552.0], [1057.0, 1552.0], [1057.0, 1742.0], [1007.0, 1742.0]]], "lines": ["だから", "絶対純対絶対", "私にしたほうが", "ぜーったいに", "いいよ！！"]}, {"box": [817, 1522, 865, 1857], "vertical": true, "font_size": 48, "lines_coords": [[[817.0, 1522.0], [865.0, 1522.0], [865.0, 1724.0], [817.0, 1724.0]]], "lines": ["おはよーメ"]}, {"box": [445, 1538, 544, 1788], "vertical": true, "font_size": 44, "lines_coords": [[[493.0, 1538.0], [541.0, 1538.0], [537.0, 1702.0], [489.0, 1702.0]], [[445.0, 1552.0], [485.0, 1552.0], [491.0, 1788.0], [451.0, 1788.0]]], "lines": ["おはよう", "つざいます！"]}, {"box": [149, 1618, 415, 1835], "vertical": true, "font_size": 44, "lines_coords": [[[367.0, 1624.0], [415.0, 1624.0], [415.0, 1674.0], [367.0, 1674.0]], [[313.0, 1626.0], [355.0, 1626.0], [355.0, 1804.0], [313.0, 1804.0]], [[255.0, 1624.0], [297.0, 1624.0], [301.0, 1804.0], [259.0, 1804.0]]], "lines": ["と", "言えたら", "いいのに"]}], "img_path": "163.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [188, 817, 449, 1167], "vertical": true, "font_size": 22, "lines_coords": [[[421.0, 820.0], [441.0, 820.0], [441.0, 1096.0], [421.0, 1096.0]], [[393.0, 820.0], [413.0, 820.0], [413.0, 1136.0], [393.0, 1136.0]], [[359.0, 820.0], [385.0, 820.0], [385.0, 1004.0], [359.0, 1004.0]], [[329.0, 820.0], [351.0, 820.0], [353.0, 1024.0], [331.0, 1024.0]], [[303.0, 818.0], [323.0, 818.0], [319.0, 1166.0], [299.0, 1166.0]], [[267.0, 820.0], [293.0, 820.0], [293.0, 1084.0], [267.0, 1084.0]], [[241.0, 822.0], [261.0, 822.0], [261.0, 1126.0], [241.0, 1126.0]]], "lines": ["「大学でぜったい彼女をつくる！」", "と意気込む主人公・空港メイのもとに、", "入学早々なぜか次々と", "女の子たちがやってくる。", "どれが本当の恋かわからないメイだったが、", "“キス屋”の味間カリン先輩から", "付き合ってみないかと誘われて．．．！？"]}, {"box": [139, 821, 210, 1078], "vertical": true, "font_size": 23, "lines_coords": [[[183.0, 822.0], [209.0, 822.0], [209.0, 992.0], [183.0, 992.0]], [[141.0, 824.0], [161.0, 824.0], [161.0, 1070.0], [141.0, 1070.0]]], "lines": ["恋が恋を呼ぶ", "百合物語、第２巻！"]}, {"box": [138, 1298, 360, 1318], "vertical": false, "font_size": 22, "lines_coords": [[[138.0, 1296.0], [360.0, 1296.0], [360.0, 1320.0], [138.0, 1320.0]]], "lines": ["Ｉｄｏｎｔｋｏｏｗｗｉｎｔｈｉｓｈｉｌｅｌｄｙｅ"]}], "img_path": "164.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [1413, 448, 1435, 554], "vertical": true, "font_size": 22, "lines_coords": [[[1413.0, 448.0], [1435.0, 448.0], [1435.0, 554.0], [1413.0, 554.0]]], "lines": ["．．．"]}, {"box": [57, 700, 179, 722], "vertical": false, "font_size": 21, "lines_coords": [[[57.0, 700.0], [179.0, 700.0], [179.0, 722.0], [57.0, 722.0]]], "lines": ["奥たまむ"]}, {"box": [51, 798, 275, 994], "vertical": false, "font_size": 21, "lines_coords": [[[53.0, 798.0], [227.0, 798.0], [227.0, 824.0], [53.0, 824.0]], [[51.0, 830.0], [195.0, 830.0], [195.0, 850.0], [51.0, 850.0]], [[53.0, 858.0], [211.0, 858.0], [211.0, 878.0], [53.0, 878.0]], [[53.0, 888.0], [275.0, 888.0], [275.0, 908.0], [53.0, 908.0]], [[53.0, 916.0], [165.0, 916.0], [165.0, 936.0], [53.0, 936.0]], [[53.0, 944.0], [213.0, 944.0], [213.0, 964.0], [53.0, 964.0]], [[51.0, 972.0], [139.0, 972.0], [139.0, 994.0], [51.0, 994.0]]], "lines": ["キャラが出揃いましたか", "誰か好きなキャラは", "できましたでしょうか？", "私も一人、特に好きなキャラは", "いるのですが．．．", "何かがバレそうなので", "秘密です！！"]}, {"box": [633, 420, 1039, 614], "vertical": false, "font_size": 163, "lines_coords": [[[633.0, 452.0], [1025.0, 420.0], [1039.0, 582.0], [647.0, 614.0]]], "lines": ["と、"]}, {"box": [1331, 662, 1367, 1016], "vertical": true, "font_size": 34, "lines_coords": [[[1331.0, 662.0], [1365.0, 662.0], [1367.0, 1016.0], [1333.0, 1016.0]]], "lines": ["奥、たっま、むしむ。"]}, {"box": [595, 1040, 716, 1135], "vertical": false, "font_size": 20, "lines_coords": [[[603.0, 1038.0], [697.0, 1038.0], [697.0, 1062.0], [603.0, 1062.0]], [[601.0, 1058.0], [699.0, 1058.0], [699.0, 1082.0], [601.0, 1082.0]], [[597.0, 1086.0], [713.0, 1086.0], [713.0, 1110.0], [597.0, 1110.0]], [[607.0, 1116.0], [699.0, 1116.0], [699.0, 1134.0], [607.0, 1134.0]]], "lines": ["ｄｏｎｔｋｍｏｗｋｉｔｉｌ．", "ｗｈｉｃｈｉｓｌｏｖｅ", "どれが恋かが", "わからない"]}, {"box": [551, 960, 1417, 1686], "vertical": false, "font_size": 299.5, "lines_coords": [[[747.0, 960.0], [1181.0, 994.0], [1159.0, 1282.0], [725.0, 1248.0]], [[551.0, 1390.0], [1325.0, 1150.0], [1417.0, 1446.0], [643.0, 1686.0]]], "lines": ["．．．", "いや．．．"]}, {"box": [46, 1531, 212, 1587], "vertical": false, "font_size": 16, "lines_coords": [[[55.0, 1552.0], [205.0, 1552.0], [205.0, 1570.0], [55.0, 1570.0]], [[59.0, 1570.0], [165.0, 1570.0], [165.0, 1588.0], [59.0, 1588.0]]], "lines": ["名和田鋳平デザイン事務所", "名和田耕平＋清非優実）"]}, {"box": [1201, 1574, 1368, 1596], "vertical": false, "font_size": 22, "lines_coords": [[[1201.0, 1572.0], [1365.0, 1574.0], [1365.0, 1598.0], [1201.0, 1596.0]]], "lines": ["ｍｍｃｅｕＮＥＳＥＲＩＥＳ"]}], "img_path": "165.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [], "img_path": "166.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [201, 506, 423, 573], "vertical": false, "font_size": 28, "lines_coords": [[[207.0, 504.0], [405.0, 504.0], [405.0, 534.0], [207.0, 534.0]], [[207.0, 544.0], [419.0, 544.0], [419.0, 574.0], [207.0, 574.0]]], "lines": ["ｌｄｏｎ＇ｔｋｎｏｗ", "ｗｈｉｃｈｉｓｌｏｖｅ"]}], "img_path": "167.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [131, 132, 493, 172], "vertical": false, "font_size": 40, "lines_coords": [[[131.0, 132.0], [493.0, 132.0], [493.0, 172.0], [131.0, 172.0]]], "lines": ["ＭＦＣキューシシリーズ"]}, {"box": [129, 380, 487, 434], "vertical": false, "font_size": 54, "lines_coords": [[[129.0, 380.0], [487.0, 380.0], [487.0, 434.0], [129.0, 434.0]]], "lines": ["著者一奥たまむし"]}, {"box": [131, 214, 905, 312], "vertical": false, "font_size": 82, "lines_coords": [[[131.0, 230.0], [903.0, 214.0], [905.0, 296.0], [133.0, 312.0]]], "lines": ["どれが恋かがわからない２"]}, {"box": [135, 570, 437, 636], "vertical": false, "font_size": 28.0, "lines_coords": [[[135.0, 570.0], [437.0, 572.0], [437.0, 600.0], [135.0, 598.0]], [[137.0, 608.0], [233.0, 608.0], [233.0, 636.0], [137.0, 636.0]]], "lines": ["２０２２年１２月２７日－発行", "ｖｅｒ．ＯＯ１"]}, {"box": [135, 678, 459, 704], "vertical": false, "font_size": 26, "lines_coords": [[[135.0, 678.0], [459.0, 678.0], [459.0, 704.0], [135.0, 704.0]]], "lines": ["ＣＯＫｕＴａｍａｍｕｓｈｉ２０２２"]}, {"box": [132, 738, 799, 855], "vertical": false, "font_size": 29, "lines_coords": [[[133.0, 750.0], [679.0, 750.0], [679.0, 782.0], [133.0, 782.0]], [[133.0, 784.0], [799.0, 784.0], [799.0, 816.0], [133.0, 816.0]], [[135.0, 820.0], [581.0, 820.0], [581.0, 850.0], [135.0, 850.0]]], "lines": ["本電子書籍は下記にもとづいて制作しました", "ＭＦＣキュキューンシリーズ『どれが恋かがわからない』", "・２０２２年１２月２７日初版第一刷発行"]}, {"box": [131, 890, 543, 1022], "vertical": false, "font_size": 28.0, "lines_coords": [[[135.0, 890.0], [349.0, 890.0], [349.0, 918.0], [135.0, 918.0]], [[133.0, 924.0], [517.0, 922.0], [517.0, 950.0], [133.0, 952.0]], [[131.0, 958.0], [543.0, 960.0], [543.0, 988.0], [131.0, 986.0]], [[133.0, 994.0], [461.0, 994.0], [461.0, 1022.0], [133.0, 1022.0]]], "lines": ["発行者・山下直久", "発行・株式会社Ｋ・ＡＤＯＫＡＷＡ", "ｈｔｔｐｓ／／ｗｗｗ．ｋａｄｏｋａｗａｃｏ．ｊｐ／", "編集企画キューン編集部"]}, {"box": [133, 1098, 1015, 1268], "vertical": false, "font_size": 26.4, "lines_coords": [[[137.0, 1098.0], [319.0, 1098.0], [319.0, 1124.0], [137.0, 1124.0]], [[133.0, 1140.0], [1015.0, 1140.0], [1015.0, 1168.0], [133.0, 1168.0]], [[135.0, 1178.0], [685.0, 1178.0], [685.0, 1204.0], [135.0, 1204.0]], [[135.0, 1210.0], [669.0, 1210.0], [669.0, 1236.0], [135.0, 1236.0]], [[135.0, 1240.0], [381.0, 1242.0], [381.0, 1268.0], [135.0, 1266.0]]], "lines": ["●お問い合わせ", "ｈｔｔｐｓ／／ｗｗｗｋａｄｏｋａｖａ．ｃｏ．ｊｐ／《「お問い合わせ「へお進みください」", "＊＊内容によっては、お答えできない場合があります。", "☆サポートは日本国内のみとさせていただきます。", "＊＊：＊＊＿＊＊．ａｐａｎｅｓｔｅｘｔｒｏｒｌｙ"]}, {"box": [131, 1306, 1075, 1574], "vertical": false, "font_size": 24.0, "lines_coords": [[[135.0, 1306.0], [907.0, 1306.0], [907.0, 1326.0], [135.0, 1326.0]], [[131.0, 1332.0], [643.0, 1332.0], [643.0, 1358.0], [131.0, 1358.0]], [[133.0, 1364.0], [935.0, 1366.0], [935.0, 1392.0], [133.0, 1390.0]], [[131.0, 1396.0], [949.0, 1394.0], [949.0, 1420.0], [131.0, 1422.0]], [[131.0, 1428.0], [671.0, 1428.0], [671.0, 1454.0], [131.0, 1454.0]], [[135.0, 1462.0], [859.0, 1462.0], [859.0, 1482.0], [135.0, 1482.0]], [[133.0, 1490.0], [925.0, 1490.0], [925.0, 1516.0], [133.0, 1516.0]], [[135.0, 1520.0], [527.0, 1520.0], [527.0, 1546.0], [135.0, 1546.0]], [[137.0, 1554.0], [1075.0, 1554.0], [1075.0, 1574.0], [137.0, 1574.0]]], "lines": ["本電子書籍の全部または、一部を無断で複製、転載、配信、送信すること、", "あるいはウェブサイトヘの転載等を禁止します。", "また、本電子書籍の内容を無断で改変、改ざん等を行うことも禁止します。", "本電子書籍購入時にご承諾いわただいた規約により、有償・無償にかかわらず", "本電子書籍を第三者に譲渡することはできません。", "本電子書籍の内容は、底本発行時の取材・執筆内容にもとづきます。", "本電子書籍を示すサムネイルなどのイメージ画像は、再ダウンロード時に", "予告なく変更される場合があります。", "また、ご覧になるりーディングシステムにより、表示の差が認められることがあります。"]}, {"box": [135, 1652, 1179, 1678], "vertical": false, "font_size": 26, "lines_coords": [[[135.0, 1652.0], [1179.0, 1652.0], [1179.0, 1678.0], [135.0, 1678.0]]], "lines": ["初出・月刊コミックキュ一ン２０２２年５月号〜７月号、９月号〜１２月号、２０２３年１月号"]}], "img_path": "168.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [324, 716, 1115, 1030], "vertical": false, "font_size": 345, "lines_coords": [[[345.0, 685.0], [1115.0, 685.0], [1115.0, 1061.0], [345.0, 1061.0]]], "lines": ["．．．"]}, {"box": [178, 1076, 1253, 1264], "vertical": false, "font_size": 198, "lines_coords": [[[201.0, 1066.0], [1251.0, 1058.0], [1253.0, 1274.0], [203.0, 1282.0]]], "lines": ["ＴＯＯＫ＞＞ＷＡＬＫＥＲ"]}], "img_path": "169.jpg"}]}