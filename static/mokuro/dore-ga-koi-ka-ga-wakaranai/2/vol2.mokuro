, 266.0], [127.0, 266.0]]], "lines": ["でも私とミナトは", "３年生で空いてるし、", "メイちゃんは学部", "違うでしょ？"]}, {"box": [55, 362, 141, 630], "vertical": true, "font_size": 35, "lines_coords": [[[103.0, 362.0], [139.0, 362.0], [141.0, 630.0], [105.0, 630.0]], [[55.0, 364.0], [91.0, 364.0], [93.0, 556.0], [57.0, 556.0]]], "lines": ["それに小劇場も", "空いてる．．．"]}, {"box": [1189, 820, 1267, 1056], "vertical": true, "font_size": 33, "lines_coords": [[[1233.0, 820.0], [1267.0, 820.0], [1267.0, 1056.0], [1233.0, 1056.0]], [[1189.0, 820.0], [1223.0, 820.0], [1223.0, 1022.0], [1189.0, 1022.0]]], "lines": ["だからちょうど", "いいかなって"]}, {"box": [905, 626, 941, 732], "vertical": true, "font_size": 36, "lines_coords": [[[905.0, 626.0], [941.0, 626.0], [941.0, 732.0], [905.0, 732.0]]], "lines": ["通常ね"]}, {"box": [287, 816, 373, 1082], "vertical": true, "font_size": 44, "lines_coords": [[[337.0, 818.0], [373.0, 818.0], [373.0, 964.0], [337.0, 964.0]], [[289.0, 816.0], [325.0, 816.0], [323.0, 1082.0], [287.0, 1082.0]]], "lines": ["えっコレ", "カリン先輩が！？"]}, {"box": [1033, 972, 1151, 1208], "vertical": true, "font_size": 33, "lines_coords": [[[1117.0, 974.0], [1151.0, 974.0], [1151.0, 1208.0], [1117.0, 1208.0]], [[1079.0, 976.0], [1107.0, 976.0], [1107.0, 1208.0], [1079.0, 1208.0]], [[1033.0, 972.0], [1067.0, 972.0], [1067.0, 1142.0], [1033.0, 1142.0]]], "lines": ["メイちゃん用に", "カンタンな台本", "書いたんだ"]}, {"box": [1095, 1336, 1271, 1694], "vertical": true, "font_size": 40, "lines_coords": [[[1221.0, 1336.0], [1271.0, 1336.0], [1271.0, 1454.0], [1221.0, 1454.0]], [[1181.0, 1338.0], [1215.0, 1338.0], [1215.0, 1590.0], [1181.0, 1590.0]], [[1133.0, 1340.0], [1173.0, 1340.0], [1177.0, 1552.0], [1137.0, 1552.0]], [[1095.0, 1342.0], [1129.0, 1342.0], [1129.0, 1694.0], [1095.0, 1694.0]]], "lines": ["怖い？", "そう思ったなら", "これは成長の", "チャンスかもしれない"]}, {"box": [167, 1072, 271, 1202], "vertical": true, "font_size": 44, "lines_coords": [[[223.0, 1078.0], [267.0, 1076.0], [271.0, 1200.0], [227.0, 1202.0]], [[173.0, 1072.0], [233.0, 1076.0], [227.0, 1176.0],