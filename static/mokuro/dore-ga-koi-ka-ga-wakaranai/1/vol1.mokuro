.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [1223, 22, 1297, 284], "vertical": true, "font_size": 32, "lines_coords": [[[1263.0, 22.0], [1297.0, 22.0], [1295.0, 284.0], [1261.0, 284.0]], [[1225.0, 24.0], [1255.0, 24.0], [1253.0, 282.0], [1223.0, 282.0]]], "lines": ["隠しても先生には", "どうせバレるし．．．"]}, {"box": [893, 263, 1015, 624], "vertical": true, "font_size": 28, "lines_coords": [[[981.0, 264.0], [1015.0, 264.0], [1015.0, 374.0], [981.0, 374.0]], [[957.0, 414.0], [985.0, 414.0], [985.0, 586.0], [957.0, 586.0]], [[925.0, 414.0], [951.0, 414.0], [951.0, 624.0], [925.0, 624.0]], [[893.0, 412.0], [919.0, 412.0], [919.0, 624.0], [893.0, 624.0]]], "lines": ["たしかに", "私高校３年間", "ひとりの女の子に", "片想いしてました"]}, {"box": [587, 78, 783, 308], "vertical": true, "font_size": 34, "lines_coords": [[[749.0, 80.0], [783.0, 80.0], [783.0, 276.0], [749.0, 276.0]], [[707.0, 80.0], [741.0, 80.0], [741.0, 244.0], [707.0, 244.0]], [[667.0, 80.0], [703.0, 80.0], [703.0, 214.0], [667.0, 214.0]], [[627.0, 80.0], [661.0, 80.0], [661.0, 276.0], [627.0, 276.0]], [[587.0, 78.0], [621.0, 78.0], [621.0, 308.0], [587.0, 308.0]]], "lines": ["すごく好きで", "人生で一番", "熱中して", "でも結果的に", "フラれちゃって"]}, {"box": [107, 342, 329, 586], "vertical": true, "font_size": 31, "lines_coords": [[[295.0, 344.0], [329.0, 344.0], [327.0, 586.0], [293.0, 586.0]], [[257.0, 344.0], [291.0, 344.0], [291.0, 500.0], [257.0, 500.0]], [[221.0, 346.0], [249.0, 346.0], [249.0, 526.0], [221.0, 526.0]], [[183.0, 342.0], [217.0, 342.0], [213.0, 500.0], [179.0, 500.0]], [[147.0, 348.0], [175.0, 348.0], [175.0, 526.0], [147.0, 526.0]], [[107.0, 344.0], [135.0, 344.0], [135.0, 582.0], [107.0, 582.0]]], "lines": ["やけくそになって", "次の恋って", "思ってたのに", "今はなんか", "心がひとつに", "さだまらなくて．．．"]}, {"box": [1120, 720, 1288, 948], "vertical": true, "font_size": 28, "lines_coords": [[[1259.0, 722.0], [1287.0, 722.0], [1287.0, 946.0], [1259.0, 946.0]], [[1221.0, 720.0], [1255.0, 720.0], [1255.0, 892.0], [1221.0, 892.0]], [[1189.0, 722.0], [1215.0, 722.0], [1215.0