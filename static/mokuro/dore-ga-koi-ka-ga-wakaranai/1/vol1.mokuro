う？", "神様よりモテ", "パワー的な．．．"]}, {"box": [167, 1118, 239, 1288], "vertical": true, "font_size": 34, "lines_coords": [[[205.0, 1118.0], [239.0, 1118.0], [239.0, 1254.0], [205.0, 1254.0]], [[167.0, 1128.0], [201.0, 1128.0], [201.0, 1288.0], [167.0, 1288.0]]], "lines": ["そういう", "のはなしで"]}, {"box": [176, 1331, 290, 1450], "vertical": true, "font_size": 52, "lines_coords": [[[233.0, 1338.0], [285.0, 1338.0], [285.0, 1400.0], [233.0, 1400.0]]], "lines": ["な、"]}, {"box": [1125, 1458, 1273, 1776], "vertical": true, "font_size": 40, "lines_coords": [[[1231.0, 1464.0], [1273.0, 1464.0], [1273.0, 1618.0], [1231.0, 1618.0]], [[1191.0, 1458.0], [1239.0, 1458.0], [1245.0, 1776.0], [1197.0, 1776.0]], [[1163.0, 1464.0], [1197.0, 1464.0], [1197.0, 1772.0], [1163.0, 1772.0]], [[1125.0, 1460.0], [1161.0, 1460.0], [1161.0, 1612.0], [1125.0, 1612.0]]], "lines": ["好み的に", "ふつーっぽい子を", "主人公にしたいの", "ですが．．"]}, {"box": [981, 1498, 1095, 1744], "vertical": true, "font_size": 104, "lines_coords": [[[981.0, 1504.0], [1085.0, 1498.0], [1095.0, 1738.0], [991.0, 1744.0]]], "lines": ["以外で"]}, {"box": [917, 1836, 1013, 1882], "vertical": true, "font_size": 89, "lines_coords": [[[917.0, 1836.0], [1013.0, 1836.0], [1013.0, 1882.0], [917.0, 1882.0]]], "lines": ["わ"]}, {"box": [703, 1500, 1015, 1910], "vertical": true, "font_size": 89, "lines_coords": [[[917.0, 1514.0], [1009.0, 1512.0], [1015.0, 1840.0], [923.0, 1842.0]], [[817.0, 1526.0], [909.0, 1518.0], [947.0, 1902.0], [855.0, 1910.0]], [[755.0, 1502.0], [847.0, 1500.0], [855.0, 1872.0], [763.0, 1874.0]], [[703.0, 1538.0], [775.0, 1536.0], [781.0, 1770.0], [709.0, 1772.0]]], "lines": ["フツーの女子が", "いきなり女子に", "恋愛でもって", "れない．．．"]}, {"box": [477, 1508, 661, 1884], "vertical": true, "font_size": 34, "lines_coords": [[[621.0, 1514.0], [661.0, 1514.0], [661.0, 1818.0], [621.0, 1818.0]], [[585.0, 1514.0], [619.0, 1514.0], [619.0, 1750.0], [585.0, 1750.0]], [[549.0, 1514.0], [583.0, 1514.0], [583.0, 1850.0], [549.0, 1850.0]], [[515.0, 1516.0], [543.0, 1516.0], [543.0, 1882.0], [515.0, 1882.0]], [[477.0, 1508.0], [511.0, 1508.0], [511.0, 1748.0], [477.0, 1748.0]]], "lines": ["はい、というわけで", "これはなんとか", "主人公の色々な部分を", "好きになってもらう事で", "乗り切りました"]}, {"box": [202, 1525, 365, 1590], "vertical": false, "font_size": 65, "lines_coords": [[[202.0, 1525.0], [365.0, 1525.0], [365.0, 1590.0], [202.0, 1590.0]]], "lines": ["にあいがすき"]}, {"box": [124, 1504, 157, 1904], "vertical": true, "font_size": 28, "lines_coords": [[[125.0, 1512.0], [153.0, 1512.0], [153.0, 1904.0], [125.0, 1904.0]]], "lines": ["これならあるかも！へないと"]}], "img_path": "164.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [1121, 167, 1245, 728], "vertical": true, "font_size": 65, "lines_coords": [[[1177.0, 174.0], [1245.0, 174.0], [1245.0, 544.0], [1177.0, 544.0]], [[1121.0, 174.0], [1183.0, 174.0], [1185.0, 728.0], [1123.0, 728.0]]], "lines": ["が、主人公の", "キャラが一番難関で"]}, {"box": [695, 136, 1017, 510], "vertical": true, "font_size": 45, "lines_coords": [[[989.0, 136.0], [1017.0, 136.0], [1017.0, 448.0], [989.0, 448.0]], [[951.0, 144.0], [979.0, 144.0], [979.0, 510.0], [951.0, 510.0]], [[915.0, 142.0], [943.0, 142.0], [943.0, 510.0], [915.0, 510.0]], [[877.0, 138.0], [911.0, 138.0], [911.0, 390.0], [877.0, 390.0]], [[839.0, 136.0], [873.0, 136.0], [873.0, 362.0], [839.0, 362.0]], [[805.0, 142.0], [833.0, 142.0], [833.0, 356.0], [805.0, 356.0]], [[769.0, 142.0], [797.0, 142.0], [797.0, 386.0], [769.0, 386.0]], [[727.0, 140.0], [765.0, 140.0], [765.0, 206.0], [727.0, 206.0]], [[695.0, 142.0], [723.0, 142.0], [723.0, 494.0], [695.0, 494.0]]], "lines": ["〈読まなくていいです〉", "モテるわけだから受け身に", "なるわけで、すると攻める", "ちのアクションが", "過激化していき", "主人公の末路が", "リアクション芸人", "に．．．", "逆に主人公が女好きですが、"]}, {"box": [817, 410, 911, 530], "vertical": true, "font_size": 45, "lines_coords": [[[845.0, 410.0], [881.0, 522.0], [853.0, 530.0], [817.0, 418.0]], [[857.0, 426.0], [887.0, 418.0], [911.0, 508.0], [881.0, 516.0]]], "lines": ["それじゃねー", "は富豪"]}, {"box": [659, 142, 853, 568], "vertical": true, "font_size": 45, "lines_coords": [[[659.0, 142.0], [687.0, 142.0], [687.0, 418.0], [659.0, 418.0]], [[819.0, 428.0], [853.0, 526.0], [831.0, 534.0], [797.0, 436.0]], [[795.0, 438.0], [847.0, 558.0], [827.0, 568.0], [773.0, 446.0]]], "lines": ["攻め攻めな人間だと", "パンツだ！？", "正直くんちゃ"]}, {"box": [623, 140, 811, 560], "vertical": true, "font_size": 45, "lines_coords": [[[623.0, 140.0], [651.0, 140.0], [651.0, 448.0], [623.0, 448.0]], [[765.0, 436.0], [811.0, 548.0], [785.0, 560.0], [739.0, 446.0]]], "lines": ["全員と一瞬で結ばれて", "セッシング"]}, {"box": [585, 138, 783, 570], "vertical": true, "font_size": 45, "lines_coords": [[[585.0, 138.0], [613.0, 138.0], [613.0, 322.0], [585.0, 322.0]], [[743.0, 458.0], [783.0, 562.0], [763.0, 570.0], [723.0, 466.0]]], "lines": ["無茶苦茶に．．．", "２０１７年１２月"]}, {"box": [499, 132, 563, 408], "vertical": true, "font_size": 45, "lines_coords": [[[499.0, 132.0], [563.0, 132.0], [563.0, 408.0], [499.0, 408.0]]], "lines": ["読んだ．．．"]}, {"box": [179, 126, 427, 474], "vertical": true, "font_size": 33, "lines_coords": [[[399.0, 132.0], [427.0, 132.0], [427.0, 250.0], [399.0, 250.0]], [[363.0, 132.0], [391.0, 132.0], [391.0, 314.0], [363.0, 314.0]], [[321.0, 128.0], [357.0, 128.0], [357.0, 228.0], [321.0, 228.0]], [[283.0, 126.0], [325.0, 126.0], [323.0, 474.0], [281.0, 474.0]], [[247.0, 128.0], [285.0, 128.0], [285.0, 226.0], [247.0, 226.0]], [[211.0, 130.0], [249.0, 130.0], [249.0, 226.0], [211.0, 226.0]], [[179.0, 132.0], [207.0, 132.0], [207.0, 284.0], [179.0, 284.0]]], "lines": ["そんな時", "とある百合な", "ＴＲＰＧで", "日常会話で１かありがえたんだ」", "静かに", "攻める", "女子を飛見"]}, {"box": [141, 130, 171, 320], "vertical": true, "font_size": 33, "lines_coords": [[[141.0, 130.0], [169.0, 130.0], [171.0, 320.0], [143.0, 320.0]]], "lines": ["したんですね、"]}, {"box": [247, 326, 279, 468], "vertical": true, "font_size": 33, "lines_coords": [[[251.0, 326.0], [279.0, 326.0], [275.0, 468.0], [247.0, 468.0]]], "lines": ["そうしよかった！"]}, {"box": [163, 498, 339, 766], "vertical": true, "font_size": 38, "lines_coords": [[[277.0, 500.0], [333.0, 500.0], [333.0, 766.0], [277.0, 766.0]], [[235.0, 502.0], [269.0, 502.0], [269.0, 686.0], [235.0, 686.0]], [[203.0, 500.0], [231.0, 500.0], [231.0, 762.0], [203.0, 762.0]], [[163.0, 502.0], [197.0, 502.0], [197.0, 732.0], [163.0, 732.0]]], "lines": ["これだ！", "となりました", "〈この漫画における", "唯一の閃きです）"]}, {"box": [165, 818, 666, 1182], "vertical": true, "font_size": 40, "lines_coords": [[[615.0, 846.0], [643.0, 846.0], [643.0, 1026.0], [615.0, 1026.0]], [[575.0, 842.0], [603.0, 842.0], [603.0, 1150.0], [575.0, 1150.0]], [[537.0, 840.0], [571.0, 840.0], [571.0, 1120.0], [537.0, 1120.0]], [[465.0, 818.0], [505.0, 818.0], [501.0, 1072.0], [461.0, 1072.0]], [[403.0, 824.0], [445.0, 824.0], [445.0, 1070.0], [403.0, 1070.0]], [[341.0, 824.0], [389.0, 824.0], [389.0, 1072.0], [341.0, 1072.0]], [[285.0, 824.0], [327.0, 824.0], [327.0, 1116.0], [285.0, 1116.0]], [[221.0, 820.0], [275.0, 820.0], [269.0, 1124.0], [215.0, 1124.0]], [[165.0, 820.0], [207.0, 820.0], [207.0, 1172.0], [165.0, 1172.0]]], "lines": ["というわけで", "今のすごくシンプルな", "構造ができました！", "まぁこの後", "これを漫画", "にするのが", "大変大変なの", "ですがそれは", "また別のお話．．．"]}, {"box": [75, 804, 109, 1236], "vertical": true, "font_size": 28, "lines_coords": [[[77.0, 804.0], [105.0, 804.0], [103.0, 1216.0], [75.0, 1216.0]]], "lines": ["今聞いてくれてありがとう．．．"]}, {"box": [1091, 839, 1307, 1214], "vertical": true, "font_size": 30, "lines_coords": [[[1277.0, 844.0], [1305.0, 844.0], [1303.0, 1182.0], [1275.0, 1182.0]], [[1241.0, 844.0], [1269.0, 844.0], [1269.0, 1026.0], [1241.0, 1026.0]], [[1203.0, 844.0], [1231.0, 844.0], [1231.0, 1180.0], [1203.0, 1180.0]], [[1167.0, 844.0], [1195.0, 844.0], [1195.0, 1120.0], [1167.0, 1120.0]], [[1127.0, 840.0], [1161.0, 840.0], [1161.0, 1212.0], [1127.0, 1212.0]], [[1091.0, 840.0], [1125.0, 840.0], [1125.0, 1214.0], [1091.0, 1214.0]]], "lines": ["つまり何気ない目常会話", "を喋りながら", "主人公が相手を無意識に", "攻める事ができれば", "この図式、成り立つよね！", "攻防戦できるよね！楽し！"]}, {"box": [945, 1292, 1317, 1882], "vertical": true, "font_size": 38, "lines_coords": [[[1277.0, 1296.0], [1317.0, 1296.0], [1317.0, 1528.0], [1277.0, 1528.0]], [[1231.0, 1292.0], [1267.0, 1292.0], [1265.0, 1842.0], [1229.0, 1842.0]], [[1181.0, 1292.0], [1221.0, 1292.0], [1221.0, 1650.0], [1181.0, 1650.0]], [[1135.0, 1294.0], [1169.0, 1294.0], [1169.0, 1880.0], [1135.0, 1880.0]], [[1085.0, 1292.0], [1127.0, 1292.0], [1125.0, 1844.0], [1083.0, 1844.0]], [[1041.0, 1296.0], [1075.0, 1296.0], [1075.0, 1882.0], [1041.0, 1882.0]], [[989.0, 1298.0], [1029.0, 1298.0], [1029.0, 1846.0], [989.0, 1846.0]], [[945.0, 1336.0], [979.0, 1336.0], [979.0, 1800.0], [945.0, 1800.0]]], "lines": ["というわけで", "キャラたちがどう動くか私にも", "まだ未知なのですが、", "カ尽きるまでこの実験．．．このお話", "描いていきたいと思いますので、", "よろしければ応援、「ご感想なども", "いただけると大変嬉しいです！！", "いやいでもここ読んでくだ"]}, {"box": [895, 1408, 935, 1766], "vertical": true, "font_size": 38, "lines_coords": [[[895.0, 1408.0], [935.0, 1408.0], [935.0, 1766.0], [895.0, 1766.0]]], "lines": ["さってるだけで神！！"]}, {"box": [799, 1558, 845, 1596], "vertical": false, "font_size": 27, "lines_coords": [[[799.0, 1570.0], [837.0, 1558.0], [845.0, 1584.0], [807.0, 1596.0]]], "lines": ["！？"]}, {"box": [541, 1652, 597, 1684], "vertical": false, "font_size": 32, "lines_coords": [[[541.0, 1652.0], [597.0, 1652.0], [597.0, 1684.0], [541.0, 1684.0]]], "lines": ["２０１６"]}, {"box": [611, 1926, 835, 1954], "vertical": false, "font_size": 26, "lines_coords": [[[611.0, 1928.0], [835.0, 1926.0], [835.0, 1952.0], [611.0, 1954.0]]], "lines": ["ＳＰｅｃｉａｌ．ｔｈａｎｋｓ！"]}, {"box": [279, 1956, 1165, 1984], "vertical": false, "font_size": 28, "lines_coords": [[[279.0, 1956.0], [1165.0, 1956.0], [1165.0, 1984.0], [279.0, 1984.0]]], "lines": ["編集で様、デザイナー情様、限わってくださった方々、全部手伝ってくれたり様、"]}, {"box": [397, 1986, 1049, 2020], "vertical": false, "font_size": 34, "lines_coords": [[[397.0, 1986.0], [1049.0, 1986.0], [1049.0, 2020.0], [397.0, 2020.0]]], "lines": ["いやる気の深さださったら、やろ気の流をくださいたら様、マッチにつく、エロイムの丁様、そして読者の皆様方と"]}, {"box": [199, 1302, 385, 1856], "vertical": true, "font_size": 40, "lines_coords": [[[343.0, 1302.0], [385.0, 1302.0], [381.0, 1778.0], [339.0, 1778.0]], [[297.0, 1302.0], [339.0, 1302.0], [335.0, 1584.0], [293.0, 1584.0]], [[247.0, 1302.0], [287.0, 1302.0], [285.0, 1778.0], [245.0, 1778.0]], [[199.0, 1304.0], [235.0, 1304.0], [237.0, 1856.0], [201.0, 1856.0]]], "lines": ["ではでは本当にありがとう", "ございました！", "そして気が合いました方！！", "また次巻でお会いしましょう！！"]}], "img_path": "165.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [167, 1099, 746, 1257], "vertical": false, "font_size": 21, "lines_coords": [[[315.0, 1100.0], [603.0, 1100.0], [603.0, 1124.0], [315.0, 1124.0]], [[213.0, 1128.0], [703.0, 1128.0], [703.0, 1152.0], [213.0, 1152.0]], [[173.0, 1164.0], [745.0, 1164.0], [745.0, 1182.0], [173.0, 1182.0]], [[233.0, 1192.0], [685.0, 1192.0], [685.0, 1216.0], [233.0, 1216.0]], [[279.0, 1234.0], [613.0, 1234.0], [613.0, 1258.0], [279.0, 1258.0]]], "lines": ["主人公、空港メイは高校の卒業式に", "片想いしていた友人に告白。．．．いようとするも失敗してしまう。", "そのため「大学でぜったい彼女をつくる」と意気込んで入学するのだが、", "なぜか次々とメイのもとに女の子たちがやってきて．．．！？", "恋が恋を呼ぶ百合物語！"]}, {"box": [396, 1320, 498, 1358], "vertical": false, "font_size": 19, "lines_coords": [[[399.0, 1318.0], [491.0, 1318.0], [491.0, 1342.0], [399.0, 1342.0]], [[399.0, 1340.0], [489.0, 1340.0], [489.0, 1358.0], [399.0, 1358.0]]], "lines": ["！ｄｏｎ＇ｔｋｍｏｗ．．．", "ｗｈｉｃｈｉｓｌｏｖｅ"]}], "img_path": "166.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [1337, 456, 1373, 496], "vertical": false, "font_size": 40, "lines_coords": [[[1337.0, 456.0], [1373.0, 456.0], [1373.0, 496.0], [1337.0, 496.0]]], "lines": ["奥"]}, {"box": [49, 696, 189, 724], "vertical": false, "font_size": 25, "lines_coords": [[[49.0, 696.0], [189.0, 696.0], [189.0, 724.0], [49.0, 724.0]]], "lines": ["奥たまむし"]}, {"box": [49, 770, 233, 912], "vertical": false, "font_size": 25, "lines_coords": [[[51.0, 770.0], [225.0, 770.0], [225.0, 796.0], [51.0, 796.0]], [[53.0, 800.0], [167.0, 800.0], [167.0, 822.0], [53.0, 822.0]], [[53.0, 828.0], [147.0, 828.0], [147.0, 850.0], [53.0, 850.0]], [[49.0, 856.0], [233.0, 856.0], [233.0, 882.0], [49.0, 882.0]], [[49.0, 884.0], [143.0, 884.0], [143.0, 912.0], [49.0, 912.0]]], "lines": ["作者の中の「面白い」と", "追求した結果か", "この漫画です", "（人間性を疑わないで！！", "虫だから！！"]}, {"box": [1297, 460, 1317, 638], "vertical": true, "font_size": 20, "lines_coords": [[[1297.0, 460.0], [1317.0, 460.0], [1317.0, 638.0], [1297.0, 638.0]]], "lines": ["ＯＫＡＴｅｍａｍｅｒは"]}, {"box": [570, 976, 740, 1112], "vertical": false, "font_size": 22, "lines_coords": [[[601.0, 974.0], [703.0, 974.0], [703.0, 1010.0], [601.0, 1010.0]], [[605.0, 1008.0], [697.0, 1008.0], [697.0, 1026.0], [605.0, 1026.0]], [[577.0, 1036.0], [739.0, 1036.0], [739.0, 1054.0], [577.0, 1054.0]], [[597.0, 1062.0], [711.0, 1062.0], [711.0, 1086.0], [597.0, 1086.0]], [[603.0, 1090.0], [703.0, 1090.0], [703.0, 1114.0], [603.0, 1114.0]]], "lines": ["・ｄｏｎ：ｋｎｏｗ", "ｗｈｔｈｉｓｔｏｖｅ", "．．．よくＯＷＥＳＥＲＩＥＸ", "どれが恋かが", "わからない"]}, {"box": [451, 892, 1502, 1720], "vertical": false, "font_size": 828, "lines_coords": [[[451.0, 892.0], [1502.0, 892.0], [1502.0, 1720.0], [451.0, 1720.0]]], "lines": ["．．．"]}, {"box": [45, 1532, 225, 1588], "vertical": false, "font_size": 16, "lines_coords": [[[57.0, 1552.0], [205.0, 1552.0], [205.0, 1570.0], [57.0, 1570.0]], [[59.0, 1570.0], [217.0, 1570.0], [217.0, 1588.0], [59.0, 1588.0]]], "lines": ["名和田捗平デザイン事務所", "各和田教えているので、名和田様子や小田県県東郡十津井優美"]}], "img_path": "167.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [], "img_path": "168.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [203, 504, 425, 571], "vertical": false, "font_size": 25, "lines_coords": [[[207.0, 502.0], [407.0, 502.0], [407.0, 532.0], [207.0, 532.0]], [[211.0, 544.0], [417.0, 544.0], [417.0, 568.0], [211.0, 568.0]]], "lines": ["ｌｄｏｎ＇ｔｋｎｏｗ", "ｗｈｉｃｈｉｓｌｏｖｅ"]}, {"box": [1397, 706, 1440, 1052], "vertical": true, "font_size": 40, "lines_coords": [[[1401.0, 706.0], [1440.0, 706.0], [1437.0, 1052.0], [1397.0, 1052.0]]], "lines": ["いちゃん、"]}, {"box": [1250, 1953, 1328, 2006], "vertical": false, "font_size": 58, "lines_coords": [[[1250.0, 1948.0], [1328.0, 1948.0], [1328.0, 2011.0], [1250.0, 2011.0]]], "lines": ["ハイ"]}], "img_path": "169.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [131, 132, 493, 172], "vertical": false, "font_size": 40, "lines_coords": [[[131.0, 132.0], [493.0, 132.0], [493.0, 172.0], [131.0, 172.0]]], "lines": ["ＭＦＣキューシシリーズ"]}, {"box": [129, 380, 485, 434], "vertical": false, "font_size": 54, "lines_coords": [[[129.0, 380.0], [485.0, 380.0], [485.0, 434.0], [129.0, 434.0]]], "lines": ["著者一奥たまむし"]}, {"box": [131, 214, 889, 312], "vertical": false, "font_size": 82, "lines_coords": [[[131.0, 230.0], [887.0, 214.0], [889.0, 296.0], [133.0, 312.0]]], "lines": ["どれが恋かがわからない１"]}, {"box": [135, 570, 421, 636], "vertical": false, "font_size": 28.0, "lines_coords": [[[135.0, 570.0], [421.0, 574.0], [421.0, 602.0], [135.0, 598.0]], [[137.0, 608.0], [233.0, 608.0], [233.0, 636.0], [137.0, 636.0]]], "lines": ["２０２２年４月２７日－発行", "ｖｅｒ．ＯＯ１"]}, {"box": [135, 678, 457, 704], "vertical": false, "font_size": 26, "lines_coords": [[[135.0, 678.0], [457.0, 678.0], [457.0, 704.0], [135.0, 704.0]]], "lines": ["ＧＯＫｕＴａｍａｍｕｃｈｉ２０２２"]}, {"box": [132, 740, 793, 854], "vertical": false, "font_size": 29, "lines_coords": [[[133.0, 750.0], [679.0, 750.0], [679.0, 782.0], [133.0, 782.0]], [[133.0, 784.0], [793.0, 784.0], [793.0, 816.0], [133.0, 816.0]], [[135.0, 820.0], [559.0, 820.0], [559.0, 850.0], [135.0, 850.0]]], "lines": ["本電子書籍は下記にもとづいて制作しました", "ＭＦＣキュキューンシリーズ『どれが恋かがわからない』", "２０２２年４月２７日初版第一刷発行"]}, {"box": [131, 890, 543, 1022], "vertical": false, "font_size": 28.0, "lines_coords": [[[135.0, 890.0], [351.0, 890.0], [351.0, 918.0], [135.0, 918.0]], [[133.0, 924.0], [517.0, 922.0], [517.0, 950.0], [133.0, 952.0]], [[131.0, 958.0], [543.0, 960.0], [543.0, 988.0], [131.0, 986.0]], [[133.0, 994.0], [461.0, 994.0], [461.0, 1022.0], [133.0, 1022.0]]], "lines": ["発行者一青柳昌行", "発行株式会社ＫＡＤＯＫＡＷＡ", "ｈｔｔｐｓ／／ｗｗｗ．ｋａｄｏｋａｗａｃｏ．ｊｐ／", "編集企画キューン編集部"]}, {"box": [133, 1098, 1015, 1268], "vertical": false, "font_size": 26.4, "lines_coords": [[[137.0, 1098.0], [319.0, 1098.0], [319.0, 1124.0], [137.0, 1124.0]], [[133.0, 1140.0], [1015.0, 1140.0], [1015.0, 1168.0], [133.0, 1168.0]], [[135.0, 1178.0], [685.0, 1178.0], [685.0, 1204.0], [135.0, 1204.0]], [[135.0, 1210.0], [669.0, 1210.0], [669.0, 1236.0], [135.0, 1236.0]], [[135.0, 1240.0], [381.0, 1242.0], [381.0, 1268.0], [135.0, 1266.0]]], "lines": ["●お問い合わせ", "ｈｔｔｐｓ／／ｗｗｗｋａｄｏｋａｖａ．ｃｏ．ｊｐ／《「お問い合わせ「へお進みください」", "＊＊内容によっては、お答えできない場合があります。", "☆サポートは日本国内のみとさせていただきます。", "Ｘ．ａｐａｎｅｓｅｔｅｘｔｏｒｌｙ"]}, {"box": [131, 1304, 1071, 1574], "vertical": false, "font_size": 24.666666666666668, "lines_coords": [[[133.0, 1304.0], [909.0, 1304.0], [909.0, 1330.0], [133.0, 1330.0]], [[131.0, 1332.0], [643.0, 1332.0], [643.0, 1358.0], [131.0, 1358.0]], [[135.0, 1366.0], [935.0, 1366.0], [935.0, 1392.0], [135.0, 1392.0]], [[131.0, 1396.0], [949.0, 1394.0], [949.0, 1420.0], [131.0, 1422.0]], [[131.0, 1428.0], [671.0, 1428.0], [671.0, 1454.0], [131.0, 1454.0]], [[135.0, 1462.0], [859.0, 1462.0], [859.0, 1482.0], [135.0, 1482.0]], [[133.0, 1490.0], [925.0, 1490.0], [925.0, 1516.0], [133.0, 1516.0]], [[135.0, 1520.0], [527.0, 1520.0], [527.0, 1546.0], [135.0, 1546.0]], [[137.0, 1554.0], [1071.0, 1554.0], [1071.0, 1574.0], [137.0, 1574.0]]], "lines": ["本電子書籍の全部または、一部を無断で複製、転載、配信、送信すること、", "あるいはウェブサイトヘヘの転載等を禁止します。", "また、本電子書籍の内容を無断で改変、改ざん等を行うことも禁止します。", "本電子書籍購入時にご承諾いいただいた規約により、有償・無償にかかわらず", "本電子書籍を第三者に譲渡することはできません。", "本電子書籍の内容は、底本発行時の取材・執筆内容にもとづきます。", "本電子書籍を示すサムネイルなどのイメージ画像は、再ダウンロード時に", "予告なく変更される場合があります。", "また、ご覧になるりーディングシステムにより、表示の差が認められることがあります。"]}, {"box": [135, 1652, 877, 1678], "vertical": false, "font_size": 26, "lines_coords": [[[135.0, 1652.0], [877.0, 1652.0], [877.0, 1678.0], [135.0, 1678.0]]], "lines": ["初出，月刊コミックキユーン２０２１年１０月号〜２０２２年４月号"]}], "img_path": "170.jpg"}, {"version": "0.2.4", "img_width": 1439, "img_height": 2048, "blocks": [{"box": [324, 716, 1115, 1030], "vertical": false, "font_size": 345, "lines_coords": [[[345.0, 685.0], [1115.0, 685.0], [1115.0, 1061.0], [345.0, 1061.0]]], "lines": ["．．．"]}, {"box": [178, 1076, 1253, 1264], "vertical": false, "font_size": 198, "lines_coords": [[[201.0, 1066.0], [1251.0, 1058.0], [1253.0, 1274.0], [203.0, 1282.0]]], "lines": ["ＴＯＯＫ＞＞ＷＡＬＫＥＲ"]}], "img_path": "171.jpg"}]}