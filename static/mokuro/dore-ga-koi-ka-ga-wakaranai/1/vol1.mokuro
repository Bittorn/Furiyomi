1.0, 168.0], [631.0, 542.0], [597.0, 542.0]], [[551.0, 172.0], [579.0, 172.0], [579.0, 538.0], [551.0, 538.0]], [[507.0, 170.0], [535.0, 170.0], [531.0, 438.0], [503.0, 438.0]]], "lines": ["１巻目！というわけで", "今回はこのお話を作った", "経緯などお話ししようか", "なーと思います！"]}, {"box": [97, 108, 501, 570], "vertical": true, "font_size": 404, "lines_coords": [[[97.0, 108.0], [501.0, 108.0], [501.0, 570.0], [97.0, 570.0]]], "lines": ["だって私の大友だっごくめられた欲しいって．．．"]}, {"box": [1225, 718, 1262, 1028], "vertical": true, "font_size": 34, "lines_coords": [[[1225.0, 718.0], [1259.0, 718.0], [1261.0, 1028.0], [1227.0, 1028.0]]], "lines": ["突、全ボツが続き．．．"]}, {"box": [1089, 688, 1195, 888], "vertical": true, "font_size": 33, "lines_coords": [[[1159.0, 688.0], [1195.0, 688.0], [1191.0, 856.0], [1155.0, 856.0]], [[1125.0, 690.0], [1159.0, 690.0], [1155.0, 856.0], [1121.0, 856.0]], [[1093.0, 694.0], [1121.0, 694.0], [1117.0, 888.0], [1089.0, 888.0]]], "lines": ["どういうの", "描いたら私", "いいですかね"]}, {"box": [871, 682, 991, 820], "vertical": true, "font_size": 46, "lines_coords": [[[949.0, 682.0], [991.0, 682.0], [991.0, 820.0], [949.0, 820.0]], [[911.0, 684.0], [955.0, 684.0], [955.0, 790.0], [911.0, 790.0]], [[871.0, 682.0], [923.0, 682.0], [923.0, 788.0], [871.0, 788.0]]], "lines": ["モテ期が", "くるとき", "とか．．．"]}, {"box": [799, 880, 909, 1022], "vertical": true, "font_size": 40, "lines_coords": [[[867.0, 880.0], [909.0, 880.0], [909.0, 1022.0], [867.0, 1022.0]], [[831.0, 882.0], [873.0, 882.0], [873.0, 1022.0], [831.0, 1022.0]], [[799.0, 886.0], [835.0, 886.0], [835.0, 1016.0], [799.0, 1016.0]]], "lines": ["えっいや", "そういう", "わけじゃ"]}, {"box": [651, 698, 771, 870], "vertical": true, "font_size": 45, "lines_coords": [[[723.0, 700.0], [771.0, 700.0], [771.0, 870.0], [723.0, 870.0]], [[655.0, 698.0], [705.0, 698.0], [701.0, 870.0], [651.0, 870.0]], [[689.0, 774.0], [727.0, 772.0], [731.0, 862.0], [693.0, 864.0]]], "lines": ["あ！百合", "ですね！", "レム"]}, {"box": [631, 921, 747, 1078], "vertical": true, "font_size": 39, "lines_coords": [[[699.0