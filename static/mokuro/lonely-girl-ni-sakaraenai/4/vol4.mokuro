, 816.0], [180.0, 816.0]]], "lines": ["えーと．．．"]}, {"box": [716, 1294, 752, 1394], "vertical": true, "font_size": 36, "lines_coords": [[[716.0, 1294.0], [752.0, 1294.0], [752.0, 1394.0], [716.0, 1394.0]]], "lines": ["もし．．"]}, {"box": [192, 1002, 224, 1160], "vertical": true, "font_size": 28, "lines_coords": [[[192.0, 1002.0], [220.0, 1002.0], [222.0, 1160.0], [194.0, 1160.0]]], "lines": ["しもたなぁ"]}, {"box": [906, 1556, 1022, 1755], "vertical": true, "font_size": 34, "lines_coords": [[[976.0, 1556.0], [1022.0, 1556.0], [1022.0, 1634.0], [976.0, 1634.0]], [[946.0, 1562.0], [974.0, 1562.0], [974.0, 1724.0], [946.0, 1724.0]], [[906.0, 1560.0], [934.0, 1560.0], [934.0, 1754.0], [906.0, 1754.0]]], "lines": ["あら", "そんなこと", "言ってたの？"]}, {"box": [168, 1449, 250, 1706], "vertical": true, "font_size": 30, "lines_coords": [[[206.0, 1450.0], [240.0, 1450.0], [240.0, 1642.0], [206.0, 1642.0]], [[170.0, 1450.0], [196.0, 1450.0], [196.0, 1706.0], [170.0, 1706.0]]], "lines": ["和奏が嫌じゃ", "なければだけど．．．"]}], "img_path": "_0078.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [1240, 126, 1324, 357], "vertical": true, "font_size": 39, "lines_coords": [[[1272.0, 126.0], [1322.0, 126.0], [1322.0, 236.0], [1272.0, 236.0]], [[1242.0, 132.0], [1270.0, 132.0], [1270.0, 356.0], [1242.0, 356.0]]], "lines": ["その話", "聞きたいなぁ．．．"]}, {"box": [768, 170, 823, 320], "vertical": true, "font_size": 42, "lines_coords": [[[768.0, 172.0], [810.0, 172.0], [810.0, 320.0], [768.0, 320.0]]], "lines": ["眩しい．．．"]}, {"box": [480, 190, 548, 316], "vertical": true, "font_size": 45, "lines_coords": [[[480.0, 198.0], [524.0, 190.0], [548.0, 308.0], [504.0, 316.0]]], "lines": ["にすけて"]}, {"box": [242, 190, 370, 392], "vertical": true, "font_size": 37, "lines_coords": [[[318.0, 190.0], [360.0, 190.0], [360.0, 392.0], [318.0, 392.0]], [[280.0, 196.0], [314.0, 196.0], [314.0, 388.0], [280.0, 388.0]], [[242.0, 192.0], [276.0, 192.0], [276.0, 388.0], [242.0, 388.0]]], "lines": ["．．．墓穴堀った", "のは自分