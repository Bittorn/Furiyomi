, 1506.0]], [[220.0, 1518.0], [692.0, 1518.0], [692.0, 1542.0], [220.0, 1542.0]], [[218.0, 1554.0], [694.0, 1554.0], [694.0, 1584.0], [218.0, 1584.0]], [[218.0, 1592.0], [436.0, 1592.0], [436.0, 1616.0], [218.0, 1616.0]], [[596.0, 1596.0], [684.0, 1596.0], [684.0, 1614.0], [596.0, 1614.0]], [[218.0, 1626.0], [454.0, 1626.0], [454.0, 1656.0], [218.0, 1656.0]], [[644.0, 1670.0], [688.0, 1670.0], [688.0, 1690.0], [644.0, 1690.0]], [[218.0, 1668.0], [532.0, 1668.0], [532.0, 1692.0], [218.0, 1692.0]], [[220.0, 1704.0], [474.0, 1704.0], [474.0, 1728.0], [220.0, 1728.0]], [[606.0, 1706.0], [692.0, 1706.0], [692.0, 1730.0], [606.0, 1730.0]]], "lines": ["Ｈ", "既刊好評発売中", "ＹＵＲＩＨＩＭＥＣＯＭＩＣ５", "．．．サブロウタ", "ｃｈｒｕｓ全®巻．．．", "ｃｉｔｒｕｓ＋＠〜＠巻．．．：", "．．．サブロウタ", "．．．漫画『蔵王大志原作＂影木栄貴", "春夏秋冬完全版．．．", "恋愛遺伝子ＸＸ完全版：．．．漫画・蔵王大志原作・影木栄賞・", "女どもだちと結婚してみた。＠巻．．．ｎ．．ｊ．．ｃ．．", "．．．．．．．雨水汐", "踊り場にスカートが鳴る『巻』．．．", "．．．うたたね游", "彩純ちゃんはレズ属俗に興味がありつます「○巻．．．．．．伊月クロ", "君と綴るうたかた＠～＠巻．．．：：：；：．．", "．．．ゆあま", "私の推しは悪役令嬢、○○○巻．．．．．．漫画：青乃下原作＂いのり。", "ふたりエスケーブ○〜の巻．．．", "・田口囁ー", "ナメられたくないナメカワさん＠〜＠巻．．．：：：", "．．．．．．阿東里枝", "ゆりづくしの教室で○〜２巻．．．", "樫風", "ロンリーガールに逆らえないＯ〜＠巻．．．．．．", "セメルバルスｓｅｍｅｌｐａｒｏｌｓ０〜３巻．．．．．．", "きたない君がいちばんかわいいの〜＠巻．．．．．．", "ささやくように恋を明うひとの巻．．．", "・竹嶋えく", "．．．．．．そめちめ", "ヒーローさんと元女幹部さんＱ～＠巻．．．．．．", "きみが死ぬまで恋をしたい＠〜＠巻．．．：．．", "．．．．．．あおのなち", "．．．未幡", "私の百合はお仕事です！（○＾＠巻．．．", "．．．様木ななっ", "私に天使が舞い降りた！Ｑ〜＠巻．．．．．．", "．．．伊藤ハチ", "月が綺麗ですね全Ｇ巻．．．！！", "．．．大沢やよい", "２ＤＫ、Ｇベン、目覚まし時計。全＠巻．．．！！", "２ＤＫ、Ｇペン、アフタータイム。大沢やよい短編集．．．．．．大沢ヤよい", "立花館ＴｏＬｅあんぐる全９巻．．．", "ゆるゆり（○～＠巻．．．", "ゆりゆり２．．．．．．", "．．．なもり", "大室家（００巻．．．", "．．．なもり", "転生したらあがりだけスライムだった作り巻く．漫画：水鳥なや原作：なもり", "マッチングアプリ百合アンソロジー・．．．あ．．ｃｈ．", "同人女百合アンソロジー．．．", "・アンソロジー", "今日はまだフツーになれない．．．", "雨水汐", "欠けた月とドーナツツＱ〜３巻．．．．．．", "それは、春の嵐のように『巻．．．", "．．．くるくる姫"]}, {"box": [40, 1490, 92, 1598], "vertical": true, "font_size": 52, "lines_coords": [[[40.0, 1490.0], [92.0, 1490.0], [92.0, 1598.0], [40.0, 1598.0]]], "lines": ["樫風"]}, {"box": [76, 1702, 96, 1722], "vertical": false, "font_size": 20, "lines_coords": [[[76.0, 1702.0], [96.0, 1702.0], [96.0, 1722.0], [76.0, 1722.0]]], "lines": ["社"]}, {"box": [520, 1926, 908, 1968], "vertical": false, "font_size": 42, "lines_coords": [[[520.0, 1926.0], [908.0, 1926.0], [908.0, 1968.0], [520.0, 1968.0]]], "lines": ["背表紙・カバー折り返し"]}, {"box": [480, 1992, 952, 2018], "vertical": false, "font_size": 26, "lines_coords": [[[480.0, 1992.0], [952.0, 1992.0], [952.0, 2018.0], [480.0, 2018.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}, {"box": [1282, 1478, 1321, 1650], "vertical": true, "font_size": 26, "lines_coords": [[[1282.0, 1480.0], [1308.0, 1478.0], [1320.0, 1642.0], [1294.0, 1644.0]]], "lines": ["明日の天気は．．"]}], "img_path": "_0168.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [551, 64, 888, 141], "vertical": false, "font_size": 59, "lines_coords": [[[564.0, 71.0], [872.0, 67.0], [872.0, 131.0], [564.0, 135.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [188, 842, 726, 896], "vertical": false, "font_size": 20.0, "lines_coords": [[[188.0, 842.0], [596.0, 842.0], [596.0, 862.0], [188.0, 862.0]], [[188.0, 876.0], [726.0, 876.0], [726.0, 896.0], [188.0, 896.0]]], "lines": ["ギクシャクしていた距離感に戸惑いながらも、", "「空のことをもっと知りたい」と向き合うことを決めた彩花。"]}, {"box": [184, 940, 656, 1070], "vertical": false, "font_size": 26.0, "lines_coords": [[[184.0, 940.0], [616.0, 942.0], [616.0, 968.0], [184.0, 966.0]], [[186.0, 976.0], [556.0, 976.0], [556.0, 1002.0], [186.0, 1002.0]], [[186.0, 1010.0], [656.0, 1010.0], [656.0, 1036.0], [186.0, 1036.0]], [[184.0, 1044.0], [578.0, 1044.0], [578.0, 1070.0], [184.0, 1070.0]]], "lines": ["やっと通じ合えたのかも、と二人が思った矢先、", "ずっと不在だった空の母親が戻ってくる。", "北海道にいる再婚相手と住むからと一方的に告げて、", "空を連れていくため、転校させようとする。"]}, {"box": [1103, 972, 1216, 1001], "vertical": false, "font_size": 29, "lines_coords": [[[1103.0, 972.0], [1216.0, 972.0], [1216.0, 1001.0], [1103.0, 1001.0]]], "lines": ["．．．"]}, {"box": [182, 1112, 702, 1284], "vertical": false, "font_size": 26.0, "lines_coords": [[[184.0, 1112.0], [696.0, 1112.0], [696.0, 1138.0], [184.0, 1138.0]], [[182.0, 1148.0], [596.0, 1148.0], [596.0, 1174.0], [182.0, 1174.0]], [[184.0, 1188.0], [490.0, 1188.0], [490.0, 1214.0], [184.0, 1214.0]], [[184.0, 1224.0], [696.0, 1224.0], [696.0, 1250.0], [184.0, 1250.0]], [[184.0, 1258.0], [702.0, 1258.0], [702.0, 1284.0], [184.0, 1284.0]]], "lines": ["納得できない彩花が、空の母親はご直談判するも門前払い。", "「ただのクラブスメイトの私には、", "何もできないのかな．．」", "諦めかけた彩花だったが、兄や和奏たちの後押しを受け、", "本当の想いを伝えるため、急ぎ二人がいる空港へ向かう。"]}, {"box": [188, 1328, 556, 1386], "vertical": false, "font_size": 23.0, "lines_coords": [[[190.0, 1328.0], [556.0, 1328.0], [556.0, 1348.0], [190.0, 1348.0]], [[188.0, 1360.0], [486.0, 1360.0], [486.0, 1386.0], [188.0, 1386.0]]], "lines": ["うかつな委員長とアンニュイ問題児（？）、", "二人の秘密な青森ラブコメディ！"]}, {"box": [680, 1934, 838, 1962], "vertical": false, "font_size": 28, "lines_coords": [[[680.0, 1934.0], [838.0, 1934.0], [838.0, 1962.0], [680.0, 1962.0]]], "lines": ["一・裏表紙"]}, {"box": [480, 1992, 946, 2018], "vertical": false, "font_size": 26, "lines_coords": [[[480.0, 1992.0], [946.0, 1992.0], [946.0, 2018.0], [480.0, 2018.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}], "img_path": "_0169.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [552, 64, 890, 142], "vertical": false, "font_size": 61, "lines_coords": [[[566.0, 69.0], [872.0, 69.0], [872.0, 135.0], [566.0, 135.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [244, 888, 609, 1028], "vertical": false, "font_size": 41, "lines_coords": [[[248.0, 902.0], [594.0, 888.0], [596.0, 928.0], [250.0, 942.0]], [[244.0, 948.0], [488.0, 944.0], [488.0, 984.0], [244.0, 988.0]], [[314.0, 986.0], [604.0, 972.0], [606.0, 1014.0], [316.0, 1028.0]]], "lines": ["ロンリーがルに逆らえないの", "お買い上げ頂き", "ありがとうございます。"]}, {"box": [702, 1034, 828, 1144], "vertical": false, "font_size": 35.333333333333336, "lines_coords": [[[728.0, 1034.0], [804.0, 1122.0], [778.0, 1144.0], [702.0, 1056.0]], [[762.0, 1052.0], [828.0, 1116.0], [808.0, 1138.0], [742.0, 1074.0]], [[764.0, 1052.0], [788.0, 1038.0], [810.0, 1074.0], [786.0, 1088.0]]],