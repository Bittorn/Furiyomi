77.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [1206, 202, 1285, 336], "vertical": true, "font_size": 39, "lines_coords": [[[1248.0, 204.0], [1284.0, 204.0], [1284.0, 336.0], [1248.0, 336.0]], [[1206.0, 202.0], [1248.0, 202.0], [1248.0, 336.0], [1206.0, 336.0]]], "lines": ["は．．．早く", "食べよ！"]}, {"box": [316, 144, 366, 298], "vertical": true, "font_size": 46, "lines_coords": [[[316.0, 144.0], [366.0, 144.0], [366.0, 298.0], [316.0, 298.0]]], "lines": ["うーん！"]}, {"box": [216, 324, 258, 506], "vertical": true, "font_size": 46, "lines_coords": [[[216.0, 324.0], [258.0, 324.0], [258.0, 506.0], [216.0, 506.0]]], "lines": ["美味しい！"]}, {"box": [1148, 841, 1321, 1132], "vertical": true, "font_size": 34, "lines_coords": [[[1284.0, 844.0], [1320.0, 844.0], [1320.0, 990.0], [1284.0, 990.0]], [[1240.0, 844.0], [1274.0, 844.0], [1274.0, 1096.0], [1240.0, 1096.0]], [[1194.0, 844.0], [1228.0, 844.0], [1228.0, 1132.0], [1194.0, 1132.0]], [[1148.0, 844.0], [1182.0, 844.0], [1182.0, 990.0], [1148.0, 990.0]]], "lines": ["私も空に", "料理作ってあげ", "られるようになり", "たいな．．．"]}, {"box": [205, 878, 327, 1140], "vertical": true, "font_size": 33, "lines_coords": [[[288.0, 878.0], [324.0, 878.0], [326.0, 1140.0], [290.0, 1140.0]], [[242.0, 882.0], [276.0, 882.0], [276.0, 1076.0], [242.0, 1076.0]], [[206.0, 882.0], [234.0, 882.0], [234.0, 1042.0], [206.0, 1042.0]]], "lines": ["り．．．料理初心者に", "対して過酷な", "注文では！？"]}, {"box": [440, 1118, 596, 1314], "vertical": true, "font_size": 33, "lines_coords": [[[564.0, 1120.0], [592.0, 1120.0], [592.0, 1278.0], [564.0, 1278.0]], [[520.0, 1120.0], [556.0, 1120.0], [556.0, 1314.0], [520.0, 1314.0]], [[480.0, 1118.0], [514.0, 1118.0], [514.0, 1282.0], [480.0, 1282.0]], [[440.0, 1118.0], [474.0, 1118.0], [474.0, 1282.0], [440.0, 1282.0]]], "lines": ["じゃあ和風", "ハンバーグと", "茶碗蒸しが", "食べたいな"]}, {"box": [1164, 1510, 1256, 1752], "vertical": true, "font_size": 42, "lines_coords": [[[1208.0, 1510.0], [1252.0, 1510.0], [1256.0, 1676.0], [1212.0, 1676.0]], [[1164.0, 1510.0], [1204.0, 1510.0], [1204.0, 1752.0], [1164.0, 1752.0]]], "lines": ["わたしも", "手伝うからさ"]}, {"box": [196, 1654, 260, 1824], "vertical": true, "font_size": 64, "lines_coords": [[[196.0, 1654.0], [260.0, 1654.0], [260.0, 1824.0], [196.0, 1824.0]]], "lines": ["お願い"]}], "img_path": "_0178.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [1186, 214, 1230, 340], "vertical": true, "font_size": 44, "lines_coords": [[[1186.0, 214.0], [1230.0, 214.0], [1230.0, 340.0], [1186.0, 340.0]]], "lines": ["もー．．．"]}, {"box": [724, 860, 830, 1146], "vertical": true, "font_size": 40, "lines_coords": [[[788.0, 862.0], [828.0, 862.0], [828.0, 1146.0], [788.0, 1146.0]], [[724.0, 860.0], [764.0, 860.0], [768.0, 1144.0], [728.0, 1144.0]]], "lines": ["空のお願いには", "逆らえないなぁ"]}, {"box": [238, 488, 288, 614], "vertical": true, "font_size": 50, "lines_coords": [[[238.0, 488.0], [288.0, 488.0], [288.0, 614.0], [238.0, 614.0]]], "lines": ["ホント"]}], "img_path": "_0179.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [74, 0, 1270, 1112], "vertical": false, "font_size": 768, "lines_coords": [[[452.0, 0.0], [1270.0, 432.0], [892.0, 1112.0], [74.0, 658.0]]], "lines": ["いいんじゃこうしていると思うか"]}], "img_path": "_0180.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [298, 518, 990, 862], "vertical": false, "font_size": 218, "lines_coords": [[[298.0, 648.0], [948.0, 518.0], [990.0, 732.0], [340.0, 862.0]]], "lines": ["あとがき"]}, {"box": [178, 804, 1204, 1822], "vertical": false, "font_size": 46.588235294117645, "lines_coords": [[[178.0, 910.0], [1078.0, 804.0], [1084.0, 858.0], [184.0, 964.0]], [[182.0, 960.0], [1100.0, 850.0], [1106.0, 898.0], [188.0, 1008.0]], [[192.0, 1006.0], [1060.0, 902.0], [1066.0, 950.0], [198.0, 1054.0]], [[196.0, 1052.0], [648.0, 1002.0], [654.0, 1044.0], [202.0, 1094.0]], [[204.0, 1094.0], [1088.0, 990.0], [1094.0, 1038.0], [210.0, 1142.0]], [[206.0, 1142.0], [1160.0, 1028.0], [1166.0, 1076.0], [212.0, 1190.0]], [[218.0, 1232.0], [1142.0, 1122.0], [1148.0, 1168.0], [224.0, 1278.0]], [[228.0, 1280.0], [1198.0, 1162.0], [1204.0, 1204.0], [234.0, 1322.0]], [[230.0, 1326.0], [1096.0, 1222.0], [1102.0, 1264.0], [236.0, 1368.0]], [[236.0, 1368.0], [1158.0, 1258.0], [1164.0, 1306.0], [242.0, 1416.0]], [[242.0, 1416.0], [518.0, 1388.0], [522.0, 1426.0], [246.0, 1454.0]], [[250.0, 1498.0], [1172.0, 1388.0], [1178.0, 1444.0], [256.0, 1554.0]], [[258.0, 1554.0], [856.0, 1482.0], [862.0, 1524.0], [264.0, 1596.0]], [[260.0, 1596.0], [1056.0, 1502.0], [1062.0, 1550.0], [266.0, 1644.0]], [[272.0, 1684.0], [1128.0, 1582.0], [1134.0, 1636.0], [278.0, 1738.0]], [[284.0, 1734.0], [482.0, 1714.0], [486.0, 1754.0], [288.0, 1774.0]], [[282.0, 1774.0], [810.0, 1716.0], [816.0, 1764.0], [288.0, 1822.0]]], "lines": ["連載開始から３年・ノ・チェームページ、ギリはご愛読ありがとうございました！！", "理戦用的バンツキー・私事ですがロンガルは、これからはこっこいよし。生物理事でして、漫画家を目指すようにしましたが、", "相手しましたロングループの専門学校や美大を出ていただけますが、ユーカ生戦として、夜回家としない私は右も左も分からない。", "特に、状態から出発いたしました。", "秋姫がン山赤いんでしょう３年という月日を越えて私は空と彩花と共に少しずつ、", "３年にいつか山を燃んではありますが成長できたのではユールバーバーノージョーだっています。", "そう言った意味では、この「ロン」リーガールに逆らえない」と", "という物語は、私の人生の中でも間違いなく特別な作品です。", "そんなロンガルを一緒に見守ってくださった読者の方で、たとえたちは一生ですよ", "そんなコンクルを組んでいたりとりひとりが私の恩人であり、作品を共有できた時間は", "しかし、一生の宝物です！", "作品には終わりというも、のが必ずありますが、空と彩花の", "「ＦｕｒｌｅｓＮｅｒ」「これから」は今後、も続いていきます。", "そんな空と彩花を、是非病援、してあげてください！", "それではまた、次の作品でご一緒できるのを楽しみに", "これにしています。", "していない。本当にありがとうございました！"]}, {"box": [928, 1748, 1224, 1876], "vertical": false, "font_size": 81, "lines_coords": [[[928.0, 1796.0], [1210.0, 1748.0], [1224.0, 1828.0], [942.0, 1876.0]]], "lines": ["えうれと．．．"]}, {"box": [1052, 1862, 1292, 1940], "vertical": false, "font_size": 56, "lines_coords": [[[1052.0, 1884.0], [1286.0, 1862.0], [1292.0, 1918.0], [1058.0, 1940.0]]], "lines": ["２０２２．Ｉ２．１６"]}], "img_path": "_0181.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [554, 67, 888, 140], "vertical": false, "font_size": 61, "lines_coords": [[[562.0, 71.0], [872.0, 67.0], [872.0, 133.0], [562.0, 137.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [342, 250, 1063, 304], "vertical": false, "font_size": 50, "lines_coords": [[[360.0, 250.0], [1036.0, 250.0], [1036.0, 304.0], [360.0, 304.0]]], "lines": ["ロンリーガールに逆らえない"]}, {"box": [460, 357, 779, 554], "vertical": false, "font_size": 39, "lines_coords": [[[533.0, 481.0], [718.0, 493.0], [716.0, 534.0], [531.0, 522.0]]], "lines": ["それを見つけて、"]}, {"box": [628, 1930, 808, 1964], "vertical": false, "font_size": 34, "lines_coords": [[[628.0, 1930.0], [808.0, 1930.0], [808.0, 1964.0], [628.0, 1964.0]]], "lines": ["本体・表紙"]}, {"box": [480, 1992, 948, 2018], "vertical": false, "font_size": 26, "lines_coords": [[[480.0, 1992.0], [948.0, 1992.0], [948.0, 2018.0], [480.0, 2018.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}, {"box": [1086, 1758, 1192, 1792], "vertical": false, "font_size": 34, "lines_coords": [[[1086.0, 1758.0], [1192.0, 1758.0], [1192.0, 1792.0], [1086.0, 1792.0]]], "lines": ["風樫"]}], "img_path": "_0182.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [552, 65, 888, 141], "vertical": false, "font_size": 59, "lines_coords": [[[564.0, 71.0], [872.0, 67.0], [872.0, 131.0], [564.0, 135.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [409, 805, 705, 937], "vertical": false, "font_size": 34, "lines_coords": [[[466.0, 849.0], [595.0, 811.0], [603.0, 846.0], [474.0, 884.0]]], "lines": ["し食したら"]}, {"box": [888, 466, 1142, 624], "vertical": false, "font_size": 41.0, "lines_coords": [[[970.0, 524.0], [1142.0, 590.0], [1128.0, 624.0], [956.0, 558.0]], [[900.0, 466.0], [1134.0, 530.0], [1122.0, 574.0], [888.0, 508.0]]], "lines": ["完食チャレンジ！", "ＢＩＧＩＮニートースに"]}, {"box": [922, 636, 1188, 723], "vertical": false, "font_size": 35, "lines_coords": [[[924.0, 635.0], [1076.0, 639.0], [1076.0, 681.0], [924.0, 677.0]], [[1028.0, 671.0], [1182.0, 677.0], [1182.0, 711.0], [1028.0, 705.0]]], "lines": ["空．．．なんか", "余裕とうだった"]}, {"box": [345, 1022, 590, 1099], "vertical": false, "font_size": 36, "lines_coords": [[[380.0, 1058.0], [512.0, 1050.0], [514.0, 1086.0], [382.0, 1094.0]]], "lines": ["来年も行っ"]}, {"box": [892, 1447, 1099, 1556], "vertical": false, "font_size": 35, "lines_coords": [[[903.0, 1445.0], [1040.0, 1473.0], [1034.0, 1506.0], [897.0, 1478.0]], [[927.0, 1477.0], [1094.0, 1519.0], [1086.0, 1558.0], [919.0, 1516.0]]], "lines": ["空のチョコは", "このフォンはいつもおいしい！！"]}, {"box": [610, 1928, 824, 1968], "vertical": false, "font_size": 36, "lines_coords": [[[610.0, 1928.0], [824.0, 1932.0], [824.0, 1968.0], [610.0, 1964.0]]], "lines": ["本体・裏表紙"]}, {"box": [480, 1987, 955, 2021], "vertical": false, "font_size": 26, "lines_coords": [[[480.0, 1992.0], [948.0, 1992.0], [948.0, 2018.0], [480.0, 2018.0]]], "lines": ["淡表記はコミックス発売当時のものになります"]}, {"box": [848, 1582, 1096, 1656], "vertical": false, "font_size": 31.0, "lines_coords": [[[848.0, 1596.0], [1030.0, 1582.0], [1032.0, 1610.0], [850.0, 1624.0]], [[854.0, 1622.0], [1094.0, 1604.0], [1096.0, 1638.0], [856.0, 1656.0]]], "lines": ["私のほうがちゃった．．．", "私のほかったらしい子たちバンジさせて〜〜っ"]}], "img_path": "_0183.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [215, 379, 593, 461], "vertical": false, "font_size": 29, "lines_coords": [[[222.0, 384.0], [574.0, 384.0], [574.0, 414.0], [222.0, 414.0]], [[218.0, 426.0], [438.0, 428.0], [438.0, 460.0], [218.0, 458.0]]], "lines": ["ＹＵＲＩＨＩＭＥＣＯＭＩＣＳ", "既刊好評発売中"]}, {"box": [552, 63, 888, 143], "vertical": false, "font_size": 59, "lines_coords": [[[566.0, 71.0], [872.0, 67.0], [872.0, 131.0], [566.0, 135.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [48, 454, 104, 1062], "vertical": true, "font_size": 48, "lines_coords": [[[48.0, 454.0], [96.0, 454.0], [104.0, 1062.0], [56.0, 1062.0]]], "lines": ["ロンリーガールに導くらえてい"]}, {"box": [1056, 508, 1154, 544], "vertical": false, "font_size": 28, "lines_coords": [[[1056.0, 508.0], [1154.0, 508.0], [1154.0, 544.0], [1056.0, 544.0]]], "lines": ["樫"]}, {"box": [978, 596, 1234, 752], "vertical": false, "font_size"