436.0, 1694.0], [220.0, 1694.0]], [[618.0, 1670.0], [694.0, 1670.0], [694.0, 1696.0], [618.0, 1696.0]]], "lines": ["ｖＨ", "ＹＵＲＩＨＩＭＥＣＯＭＩＣＳ", "・サブロウタ", "ｃｈｒｕｓ全®巻．．．", "ｏｉｔｒｕｓ＋．０～＠巻．．．", "．．．サブロウタ", "スピカをつかまえてＯ巻．．．", "．．．．．織日ちひろ", "君としらない夏になる『○○○巻．．．", "きぃやん", "甘えさせて藤森さん！○〜２巻．．．", "．．．．．．ｔｓｕｋｅ", "アンドロイドは経験人数に入りますか？？？○～２巻・焼肉定食", "今日はカノジョがいないからＯ〜＠巻．．．．．．お見樹代子", "女ともだちと結婚してみた。＠～＠巻．．．：：：；：：．．", "．．．うたたね游", "踊り場にスカートが鳴るＯ〜＠巻．．．", "彩純ちゃんはレズ風俗に興味があります！Ｏ～＠巻．．．伊月クロ", "君と綴るうたかた『〜の巻』．．．．．．いいいか．．", "私の推しは悪役令嬢、『○〜Ｇ巻．．．．．．漫画・青乃下原作・いのり。", "．．．田口囁一", "ふたりエスケーブ○〜の巻．．．", "ナメられたくないナメカワさん全て巻．．．", "ゆりづくしの教室で全®巻．．．．．．", "ロンリーガールに違うえない全６巻．．．", "樫風．．．", "セメルバルスｓｅｍｅｌｐａｒｏｌｓ『〜３巻．．．．．．", "きたない君がいちばんかわいい全§巻．．．．．．", "．．．竹嶋えく", "ささやくように恋を思うの〜〜も巻．．．", "ヒーローさんと元女韓部さん全Ｓ巻．．．", "きみが死ぬまで恋をしたい○○○巻．．．．．．．．", "私の百合はお仕事です！Ｃ～Ｏ巻．．．", "．．．未幡", "たとえとどかぬ糸だとしても全て巻．．．．．．！！", "それは、これからの", "．．．いや、椋木ななつ", "私に天使が舞い降りた！◯っぴ巻．．．", "２ＤＫ、Ｇペン、目覚まし時計。全８巻．．．あ．．．．．", "ゆるゆり『ひゃ』が巻．．．", "．．．はぁ．．", "．．．．．なもり", "ゆりゆり２．．．．．．．", "大室家○〜６巻．．．", "なもり", "転生したらあかりだけステイムだった件の巻、漫画：水鳥なや原作：なもり", "泣き顔百合アンソロジー・", "．．．アンソロジー", "きみと世界の終りを訪ねて．．．", "こるせ", "今日もひどつ屋根の下．．．", "．．．犬井あゆ"]}, {"box": [27, 1490, 108, 1723], "vertical": true, "font_size": 36, "lines_coords": [[[76.0, 1702.0], [96.0, 1702.0], [96.0, 1722.0], [76.0, 1722.0]], [[40.0, 1490.0], [92.0, 1490.0], [92.0, 1596.0], [40.0, 1596.0]]], "lines": ["社", "樫風"]}, {"box": [220, 1708, 442, 1728], "vertical": false, "font_size": 20, "lines_coords": [[[220.0, 1708.0], [442.0, 1708.0], [442.0, 1728.0], [220.0, 1728.0]]], "lines": ["欠けた月とドーナッツ全の巻、"]}, {"box": [518, 1924, 908, 1970], "vertical": false, "font_size": 42, "lines_coords": [[[518.0, 1924.0], [908.0, 1928.0], [908.0, 1970.0], [518.0, 1966.0]]], "lines": ["背表紙・カバー折り返し"]}, {"box": [480, 1992, 952, 2018], "vertical": false, "font_size": 26, "lines_coords": [[[480.0, 1992.0], [952.0, 1992.0], [952.0, 2018.0], [480.0, 2018.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}], "img_path": "_0184.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [551, 63, 888, 142], "vertical": false, "font_size": 59, "lines_coords": [[[564.0, 71.0], [872.0, 67.0], [872.0, 131.0], [564.0, 135.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [220, 710, 485, 765], "vertical": false, "font_size": 28, "lines_coords": [[[230.0, 722.0], [470.0, 722.0], [470.0, 750.0], [230.0, 750.0]]], "lines": ["．．．．．"]}, {"box": [186, 812, 780, 942], "vertical": false, "font_size": 25.5, "lines_coords": [[[188.0, 812.0], [778.0, 812.0], [778.0, 838.0], [188.0, 838.0]], [[192.0, 848.0], [780.0, 848.0], [780.0, 868.0], [192.0, 868.0]], [[186.0, 876.0], [598.0, 878.0], [598.0, 906.0], [186.0, 904.0]], [[188.0, 910.0], [744.0, 914.0], [744.0, 942.0], [188.0, 938.0]]], "lines": ["「空を好きになって、自分の気持ちを素直に出せるようになった」", "クリスマスそして初詣・・恋人としての想い小出を重ねていくなかで、", "自分の「やりたいこと」が明確になった彩花。", "そんな彩花を見て、空も自分の夢を考えるようになっていく。"]}, {"box": [186, 982, 766, 1152], "vertical": false, "font_size": 24.8, "lines_coords": [[[190.0, 982.0], [660.0, 982.0], [660.0, 1008.0], [190.0, 1008.0]], [[186.0, 1020.0], [618.0, 1020.0], [618.0, 1046.0], [186.0, 1046.0]], [[186.0, 1060.0], [766.0, 1060.0], [766.0, 1086.0], [186.0, 1086.0]], [[188.0, 1098.0], [718.0, 1098.0], [718.0, 1124.0], [188.0, 1124.0]], [[190.0, 1132.0], [450.0, 1132.0], [450.0, 1152.0], [190.0, 1152.0]]], "lines": ["そして、恋人として過ごしていくなかで彩花と空は、", "自分たちの関係を周りの人にも、", "知ってもらいたいと思うようになっていた。", "その第一歩として、穂波と千鶴の二人に伝えようとするが", "なかなか勇気が出せずにいた。"]}, {"box": [190, 1200, 534, 1254], "vertical": false, "font_size": 21.0, "lines_coords": [[[190.0, 1200.0], [466.0, 1202.0], [466.0, 1224.0], [190.0, 1222.0]], [[190.0, 1234.0], [534.0, 1234.0], [534.0, 1254.0], [190.0, 1254.0]]], "lines": ["そんな時、和奏が提案したのは", "修学旅行で伝えるというアイデアで．．．。"]}, {"box": [190, 1306, 566, 1362], "vertical": false, "font_size": 23.0, "lines_coords": [[[192.0, 1306.0], [566.0, 1306.0], [566.0, 1326.0], [192.0, 1326.0]], [[190.0, 1336.0], [546.0, 1336.0], [546.0, 1362.0], [190.0, 1362.0]]], "lines": ["うかつな委員長とアンニユイ間題児（？）、", "二人の青春ラブコメディ、ついに完結！"]}, {"box": [678, 1932, 840, 1966], "vertical": false, "font_size": 34, "lines_coords": [[[678.0, 1932.0], [840.0, 1932.0], [840.0, 1966.0], [678.0, 1966.0]]], "lines": ["一・裏表紙"]}, {"box": [480, 1992, 946, 2018], "vertical": false, "font_size": 26, "lines_coords": [[[480.0, 1992.0], [946.0, 1992.0], [946.0, 2018.0], [480.0, 2018.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}], "img_path": "_0185.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [550, 64, 892, 142], "vertical": false, "font_size": 61, "lines_coords": [[[566.0, 69.0], [872.0, 69.0], [872.0, 135.0], [566.0, 135.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [66, 1440, 497, 1477], "vertical": false, "font_size": 37, "lines_coords": [[[66.0, 1440.0], [497.0, 1440.0], [497.0, 1477.0], [66.0, 1477.0]]], "lines": ["６階風の一世社としとロンリーガールに逆らえないつも購入特典ＡＮＯＴＥＣＡＳＩに"]}, {"box": [958, 1034, 1262, 1214], "vertical": false, "font_size": 45.333333333333336, "lines_coords": [[[960.0, 1068.0], [1256.0, 1034.0], [1262.0, 1078.0], [966.0, 1112.0]], [[984.0, 1112.0], [1166.0, 1098.0], [1168.0, 1140.0], [988.0, 1152.0]], [[958.0, 1164.0], [1210.0, 1128.0], [1218.0, 1178.0], [966.0, 1214.0]]], "lines": ["ツーガールに対与えないと", "お買い上げ", "ありがとうございます。"]}, {"box": [919, 1338, 1280, 1413], "vertical": false, "font_size": 82, "lines_coords": [[[919.0, 1331.0], [1280.0, 1331.0], [1280.0, 1420.0], [919.0, 1420.0]]], "lines": ["この時間は、"]}, {"box": [510, 1932, 918, 1960], "vertical": false, "font_size": 28, "lines_coords": [[[510.0, 1932.0], [918.0, 1932.0], [918.0, 1960.0], [510.0, 1960.0]]], "lines": ["電子特別版おまけイラスト"]}], "img_path": "_0186.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [1176, 108, 1334, 312], "vertical": false, "font_size": 113, "lines_coords": [[[1176.0, 108.0], [1334.0, 108.0], [1334.0, 270.0], [1176.0, 270.0]], [[1200.0, 248.0], [1302.0, 248.0], [1302.0, 312.0], [1200.0, 312.0]]], "lines": ["．．．", "ＹＵＲＩＨＩＭＥＣＯＭＩＣＳ"]}, {"box": [1128, 776, 1302, 814], "vertical": false, "font_size": 26, "lines_coords": [[[1128.0, 776.0], [1302.0, 780.0], [1302.0, 814.0], [1128.0, 810.0]]], "lines": ["著者：樫原"]}, {"box": [1076, 860, 1304, 888], "vertical": false, "font_size": 26, "lines_coords": [[[1076.0, 860.0], [1304.0, 860.0], [1304.0, 888.0], [1076.0, 888.0]]], "lines": ["発行人：野内雅宏"]}, {"box": [986, 918, 1304, 946], "vertical": false, "font_size": 26, "lines_coords": [[[986.0, 918.0], [1304.0, 918.0], [1304.0, 946.0], [986.0, 946.0]]], "lines": ["発行所・株式会社一迅社"]}, {"box": [520, 554, 1292, 600], "vertical": false, "font_size": 46, "lines_coords": [[[520.0, 554.0], [1292.0, 554.0], [1292.0, 600.0], [520.0, 600.0]]], "lines": ["ロンリーガールに逆らえない。"]}, {"box": [880, 978, 1306, 1194], "vertical": false, "font_size": 26, "lines_coords": [[[1082.0, 1024.0], [1304.0, 1022.0], [1304.0, 1044.0], [1082.0, 1046.0]], [[880.0, 978.0], [1304.0, 978.0], [1304.0, 998.0], [880.0, 998.0]], [[970.0, 1070.0], [1306.0, 1070.0], [1306.0, 1096.0], [970.0, 1096.0]], [[1030.0, 1118.0], [1306.0, 1118.0], [1306.0, 1144.0], [1030.0, 1144.0]], [[946.0, 1166.0], [1300.0, 1168.0], [1300.0, 1194.0], [946.0, 1192.0]]], "lines": ["京王新宿追分ビル５Ｆ", "〒１６０－００２２東京都新宿区新宿３－１－１３", "電話０３－５３１２－７４２７（編集部）", "Ｄ３－５３１２－６１５０（販売部）", "わｔｔｐｓ：／／ｗｗｗ．ｉｃｈｉｎｓｈａ．ｃｏｊｐ"]}, {"box": [1032, 1346, 1304, 1372], "vertical": false, "font_size": 26, "lines_coords": [[[1032.0, 1346.0], [1304.0, 1346.0], [1304.0, 1372.0], [1032.0, 1372.0]]], "lines": ["製本：フォーネット社"]}, {"box": [748, 1226, 1306, 1254], "vertical": false, "font_size": 26, "lines_coords": [[[748.0, 1226.0], [1306.0, 1226.0], [1306.0, 1254.0], [748.0, 1254.0]]], "lines": ["発売元：株式会社講談社（講談社・一迅社"]}, {"box": [1132, 1464, 1302, 1490], "vertical": false, "font_size": 26, "lines_coords": [[[1132.0, 1464.0], [1302.0, 1464.0], [1302.0, 1490.0], [1132.0, 1490.0]]], "lines": ["編集：内藤望"]}, {"box": [700, 1402, 1300, 1432], "vertical": false, "font_size": 26, "lines_coords": [[[700.0, 1402.0], [1300.0, 1404.0], [1300.0, 1432.0], [700.0, 1430.0]]], "lines": ["デザイン：菅原悠里（バナナグローブスタジオ"]}, {"box": [644, 1862, 1314, 1964], "vertical": false, "font_size": 22, "lines_coords": [[[932.0, 1860.0], [1304.0, 1860.0], [1304.0, 1884.0], [932.0, 1884.0]], [[932.0, 1896.0], [1304.0, 1896.0], [1304.0, 1920.0], [932.0, 1920.0]], [[644.0, 1932.0], [1306.0, 1932.0], [1306.0, 1956.0], [644.0, 1956.0]]], "lines": ["ＩＤコミックス，ＩＳＢＮ９７８４－７５８０．２４８０－８", "◎樫風ノー迅社２０２３Ｐｒｉｎｔｅｄｉｎ．ＪＡＰＡＮ", "☆この作品はフィクションです。実際の人物・団体・事件などには関係ありません。"]}], "img_path": "_0187.jpg"}]}