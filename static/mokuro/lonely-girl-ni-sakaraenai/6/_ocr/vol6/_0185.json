{"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [551, 63, 888, 142], "vertical": false, "font_size": 59, "lines_coords": [[[564.0, 71.0], [872.0, 67.0], [872.0, 131.0], [564.0, 135.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [220, 710, 485, 765], "vertical": false, "font_size": 28, "lines_coords": [[[230.0, 722.0], [470.0, 722.0], [470.0, 750.0], [230.0, 750.0]]], "lines": ["．．．．．"]}, {"box": [186, 812, 780, 942], "vertical": false, "font_size": 25.5, "lines_coords": [[[188.0, 812.0], [778.0, 812.0], [778.0, 838.0], [188.0, 838.0]], [[192.0, 848.0], [780.0, 848.0], [780.0, 868.0], [192.0, 868.0]], [[186.0, 876.0], [598.0, 878.0], [598.0, 906.0], [186.0, 904.0]], [[188.0, 910.0], [744.0, 914.0], [744.0, 942.0], [188.0, 938.0]]], "lines": ["「空を好きになって、自分の気持ちを素直に出せるようになった」", "クリスマスそして初詣・・恋人としての想い小出を重ねていくなかで、", "自分の「やりたいこと」が明確になった彩花。", "そんな彩花を見て、空も自分の夢を考えるようになっていく。"]}, {"box": [186, 982, 766, 1152], "vertical": false, "font_size": 24.8, "lines_coords": [[[190.0, 982.0], [660.0, 982.0], [660.0, 1008.0], [190.0, 1008.0]], [[186.0, 1020.0], [618.0, 1020.0], [618.0, 1046.0], [186.0, 1046.0]], [[186.0, 1060.0], [766.0, 1060.0], [766.0, 1086.0], [186.0, 1086.0]], [[188.0, 1098.0], [718.0, 1098.0], [718.0, 1124.0], [188.0, 1124.0]], [[190.0, 1132.0], [450.0, 1132.0], [450.0, 1152.0], [190.0, 1152.0]]], "lines": ["そして、恋人として過ごしていくなかで彩花と空は、", "自分たちの関係を周りの人にも、", "知ってもらいたいと思うようになっていた。", "その第一歩として、穂波と千鶴の二人に伝えようとするが", "なかなか勇気が出せずにいた。"]}, {"box": [190, 1200, 534, 1254], "vertical": false, "font_size": 21.0, "lines_coords": [[[190.0, 1200.0], [466.0, 1202.0], [466.0, 1224.0], [190.0, 1222.0]], [[190.0, 1234.0], [534.0, 1234.0], [534.0, 1254.0], [190.0, 1254.0]]], "lines": ["そんな時、和奏が提案したのは", "修学旅行で伝えるというアイデアで．．．。"]}, {"box": [190, 1306, 566, 1362], "vertical": false, "font_size": 23.0, "lines_coords": [[[192.0, 1306.0], [566.0, 1306.0], [566.0, 1326.0], [192.0, 1326.0]], [[190.0, 1336.0], [546.0, 1336.0], [546.0, 1362.0], [190.0, 1362.0]]], "lines": ["うかつな委員長とアンニユイ間題児（？）、", "二人の青春ラブコメディ、ついに完結！"]}, {"box": [678, 1932, 840, 1966], "vertical": false, "font_size": 34, "lines_coords": [[[678.0, 1932.0], [840.0, 1932.0], [840.0, 1966.0], [678.0, 1966.0]]], "lines": ["一・裏表紙"]}, {"box": [480, 1992, 946, 2018], "vertical": false, "font_size": 26, "lines_coords": [[[480.0, 1992.0], [946.0, 1992.0], [946.0, 2018.0], [480.0, 2018.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}]}