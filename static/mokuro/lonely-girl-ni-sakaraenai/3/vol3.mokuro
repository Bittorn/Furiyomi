], [420.0, 1588.0], [420.0, 1618.0], [218.0, 1618.0]], [[602.0, 1592.0], [692.0, 1592.0], [692.0, 1616.0], [602.0, 1616.0]], [[644.0, 1628.0], [690.0, 1628.0], [690.0, 1654.0], [644.0, 1654.0]], [[218.0, 1626.0], [428.0, 1626.0], [428.0, 1656.0], [218.0, 1656.0]], [[626.0, 1668.0], [690.0, 1664.0], [692.0, 1690.0], [628.0, 1694.0]], [[218.0, 1668.0], [484.0, 1668.0], [484.0, 1692.0], [218.0, 1692.0]], [[218.0, 1704.0], [450.0, 1704.0], [450.0, 1728.0], [218.0, 1728.0]], [[618.0, 1704.0], [694.0, 1704.0], [694.0, 1730.0], [618.0, 1730.0]]], "lines": ["ＹＵＲＩＨＩＭＥＣｏＭＩＣＳ", "既刊好評発売中", "ＹＵＲＩＨＩＭＥＣＯＭＩＣＳ", "・サブロウタ", "ｃｉｔｒｕｓ全®巻．．．", "ｃｉｔｒｕｓ＋『○～＠巻．．．＂", "．．．サブロウタ", "・阿東里枝", "ナメられたくないナメカワさん『巻", "ゆりづくしの教室で◯巻．．．", "ふたごわずらい○巻．．．", "・桜野いつき", "ロンリーガールに逆らえない○○を", "・荻野純", "セメルバルスｓｅｍｅｐｐａｒａｃｏｒｉｓ＂．．．", "ぼちゃクライムに全２巻．．．", "．．．みんたろう", "きたない君がいちばんかわいいひ〜っと巻．．．", "ゆめぐりゆりめくりひっぺ☉巻．．．", "割り切った関係ですから。○○○さき、．．．．．．ＦＬＯＷＥＲＧＨＩＤ", "ささやくように恋を唄うのっその巻．．．。", "．．．そめちめ", "ヒーローさんと元女幹部さん０〜３巻．．．", "きみが死ぬまで恋をしたい○○巻。．．．", "羽山先生と宇野先生は付き合っている○〜３巻．．．黄井びかち", "・玉崎たま", "行進子犬に恋文を全５巻．．．", "．．．．．．．．未幡", "私の百合はお仕事です！のへの巻．．．．．．！！", "たとえとどかぬ糸だとしでも、『〜＠巻．．．", "．．．ｔｈｏｎＲ", "私に天使が舞い降りた！◯へ＠巻．．．．．．", "．．．．．．伊藤八チ", "月が綺麗ですね全も巻．．．！！", "２ＤＫ、Ｇベン、目覚まし時計。全８巻．．．．．．", "ハロー、メランコリック！？？？巻．．．", "．．．はぁ．．", "．．．．．．コダマナオコ", "海猫荘は１９８全３巻．．．．．．", "立花館ＴｏＬｉｅあんぐる全＠巻．．．", "ゆるゆり『〜®』．．．", "なもり", "ゆりゆり２．．．．．．", "．．．なもり", "大室家の〜３巻．．．", "．．．なもり", "ゆるゆり資料集．．．．．．", "．．．ゆるゆり資料集編集室", "終末世界百合アンソロジー．．．", "．．．はぁ．．", "魔女が恋する５秒前．．．．．．", "．．．澄谷ゼニコ", "雨水汐", "欠けた月とドーナッツ○巻・", "くるくる姫", "それは、春の嵐のように『巻．．．", "月と恋は満ちれば欠ける。○巻", "・トクラツム"]}, {"box": [40, 1490, 92, 1598], "vertical": true, "font_size": 52, "lines_coords": [[[40.0, 1490.0], [92.0, 1490.0], [92.0, 1598.0], [40.0, 1598.0]]], "lines": ["樫風"]}, {"box": [76, 1702, 96, 1722], "vertical": false, "font_size": 20, "lines_coords": [[[76.0, 1702.0], [96.0, 1702.0], [96.0, 1722.0], [76.0, 1722.0]]], "lines": ["社"]}, {"box": [518, 1924, 908, 1970], "vertical": false, "font_size": 42, "lines_coords": [[[518.0, 1924.0], [908.0, 1928.0], [908.0, 1970.0], [518.0, 1966.0]]], "lines": ["背表紙・カバー折り返し"]}, {"box": [480, 1992, 950, 2018], "vertical": false, "font_size": 26, "lines_coords": [[[480.0, 1992.0], [950.0, 1992.0], [950.0, 2018.0], [480.0, 2018.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}, {"box": [1221, 1576, 1298, 1608], "vertical": false, "font_size": 33, "lines_coords": [[[1224.0, 1575.0], [1292.0, 1575.0], [1292.0, 1611.0], [1224.0, 1611.0]]], "lines": ["●ＲＥＣ"]}], "img_path": "_0168.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [552, 64, 887, 142], "vertical": false, "font_size": 59, "lines_coords": [[[566.0, 71.0], [870.0, 67.0], [870.0, 131.0], [566.0, 135.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [180, 837, 660, 938], "vertical": false, "font_size": 25, "lines_coords": [[[184.0, 840.0], [554.0, 840.0], [554.0, 866.0], [184.0, 866.0]], [[184.0, 876.0], [634.0, 876.0], [634.0, 902.0], [184.0, 902.0]], [[184.0, 912.0], [412.0, 914.0], [412.0, 936.0], [184.0, 934.0]]], "lines": ["転校生・守永和奏の協力（？）もあって", "体育祭の二人三脚に出場した桜井彩花と本田空は", "晴れて「友達」になった。"]}, {"box": [920, 956, 1015, 978], "vertical": false, "font_size": 22, "lines_coords": [[[920.0, 956.0], [1015.0, 956.0], [1015.0, 978.0], [920.0, 978.0]]], "lines": ["．．．"]}, {"box": [1122, 956, 1233, 982], "vertical": false, "font_size": 22, "lines_coords": [[[1124.0, 960.0], [1224.0, 960.0], [1224.0, 982.0], [1124.0, 982.0]]], "lines": ["．．．"]}, {"box": [184, 984, 706, 1120], "vertical": false, "font_size": 26.0, "lines_coords": [[[188.0, 984.0], [676.0, 984.0], [676.0, 1010.0], [188.0, 1010.0]], [[184.0, 1020.0], [706.0, 1020.0], [706.0, 1046.0], [184.0, 1046.0]], [[186.0, 1058.0], [682.0, 1058.0], [682.0, 1084.0], [186.0, 1084.0]], [[184.0, 1092.0], [536.0, 1094.0], [536.0, 1120.0], [184.0, 1118.0]]], "lines": ["しかし、休日に彩花の部屋で二人っきりになった空は、", "「お願い」と言ってキスをしようとするが、やめてしまう。", "そんな空を見た彩花も、自分の中のモヤモヤに戸惑い、", "なんだか以前よリも関係がギクシャク。"]}, {"box": [182, 1168, 758, 1282], "vertical": false, "font_size": 27.333333333333332, "lines_coords": [[[184.0, 1168.0], [574.0, 1170.0], [574.0, 1198.0], [184.0, 1196.0]], [[182.0, 1212.0], [672.0, 1210.0], [672.0, 1238.0], [182.0, 1240.0]], [[182.0, 1254.0], [758.0, 1256.0], [758.0, 1282.0], [182.0, 1280.0]]], "lines": ["「．．．もう『友達』なんだから、", "しないのが当たり前．．・そうだよね？」", "「お願い」で繋がっていた彩花と空、二人の関係が向かう先は．．．"]}, {"box": [188, 1328, 558, 1388], "vertical": false, "font_size": 26.0, "lines_coords": [[[188.0, 1328.0], [558.0, 1328.0], [558.0, 1354.0], [188.0, 1354.0]], [[188.0, 1362.0], [482.0, 1362.0], [482.0, 1388.0], [188.0, 1388.0]]], "lines": ["うかつな委員長とアンニユイ問題児（？）、", "二人の秘密な青春ラブコメディ！"]}, {"box": [680, 1934, 838, 1962], "vertical": false, "font_size": 28, "lines_coords": [[[680.0, 1934.0], [838.0, 1934.0], [838.0, 1962.0], [680.0, 1962.0]]], "lines": ["一・裏表紙"]}, {"box": [480, 1992, 946, 2018], "vertical": false, "font_size": 26, "lines_coords": [[[480.0, 1992.0], [946.0, 1992.0], [946.0, 2018.0], [480.0, 2018.0]]], "lines": ["☆表記はコミックス発売当時のものになります。"]}], "img_path": "_0169.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [553, 66, 887, 141], "vertical": false, "font_size": 59, "lines_coords": [[[566.0, 71.0], [870.0, 67.0], [870.0, 131.0], [566.0, 135.0]]], "lines": ["ＥＸＴＲＡＰＡＧＥＳ"]}, {"box": [242, 308, 956, 450], "vertical": false, "font_size": 51, "lines_coords": [[[246.0, 326.0], [956.0, 308.0], [956.0, 362.0], [246.0, 380.0]], [[242.0, 402.0], [806.0, 390.0], [806.0, 438.0], [242.0, 450.0]]], "lines": ["ロンリーがールに逆らえないと", "お買い上げよりかとうございます！"]}, {"box": [270, 1752, 370, 1772], "vertical": false, "font_size": 20, "lines_coords": [[[270.0, 1752.0], [370.0, 1752.0], [370.0, 1772.0], [270.0, 1772.0]]], "lines": ["迅社２０２１"]}, {"box": [510, 1932, 920, 1960], "vertical": false, "font_size": 28, "lines_coords": [[[510.0, 1932.0], [920.0, 1932.0], [920.0, 1960.0], [510.0, 1960.0]]], "lines": ["電子特別版おまけイラスト"]}], "img_path": "_0170.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [1164, 96, 1344, 338], "vertic