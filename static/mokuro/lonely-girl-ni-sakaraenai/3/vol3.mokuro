.0, 742.0], [682.0, 770.0], [484.0, 708.0]]], "lines": ["空の為に何か出来る事が", "無いか話し合うの！"]}, {"box": [452, 766, 618, 846], "vertical": false, "font_size": 30, "lines_coords": [[[460.0, 766.0], [618.0, 816.0], [608.0, 846.0], [452.0, 794.0]]], "lines": ["彩花来れない？"]}, {"box": [406, 878, 652, 1018], "vertical": false, "font_size": 28.0, "lines_coords": [[[426.0, 878.0], [650.0, 956.0], [642.0, 982.0], [416.0, 904.0]], [[414.0, 910.0], [652.0, 992.0], [642.0, 1018.0], [406.0, 938.0]]], "lines": ["空と一番仲が良かった", "彩花の意見が聞きたい。"]}, {"box": [188, 400, 319, 730], "vertical": true, "font_size": 37, "lines_coords": [[[282.0, 406.0], [316.0, 406.0], [316.0, 584.0], [282.0, 584.0]], [[230.0, 400.0], [272.0, 400.0], [276.0, 730.0], [234.0, 730.0]], [[192.0, 402.0], [228.0, 402.0], [224.0, 658.0], [188.0, 658.0]]], "lines": ["あたしらの", "グループメッセージ", "見てないだろ！"]}, {"box": [1186, 1048, 1268, 1338], "vertical": true, "font_size": 37, "lines_coords": [[[1228.0, 1048.0], [1268.0, 1048.0], [1268.0, 1338.0], [1228.0, 1338.0]], [[1186.0, 1050.0], [1220.0, 1050.0], [1220.0, 1298.0], [1186.0, 1298.0]]], "lines": ["わたしたちだって", "空の友達だもの"]}, {"box": [1069, 1537, 1219, 1902], "vertical": true, "font_size": 39, "lines_coords": [[[1176.0, 1540.0], [1218.0, 1540.0], [1218.0, 1662.0], [1176.0, 1662.0]], [[1116.0, 1540.0], [1158.0, 1540.0], [1158.0, 1902.0], [1116.0, 1902.0]], [[1070.0, 1540.0], [1104.0, 1540.0], [1104.0, 1780.0], [1070.0, 1780.0]]], "lines": ["放課後", "和奏の家に集まって", "話してたのよ"]}, {"box": [632, 1480, 769, 1749], "vertical": true, "font_size": 34, "lines_coords": [[[728.0, 1482.0], [762.0, 1482.0], [762.0, 1708.0], [728.0, 1708.0]], [[682.0, 1484.0], [716.0, 1484.0], [716.0, 1748.0], [682.0, 1748.0]], [[632.0, 1480.0], [666.0, 1480.0], [666.0, 1708.0], [632.0, 1708.0]]], "lines": ["他人やない！", "ウチらは立派な", "空の友達や！"]}, {"box": [182, 1538, 339, 1863], "vertical": true, "font_size": 44, "lines_coords": [[[296.0, 1538.0], [336.0, 1538.0], [336.0, 1784.0], [296.0, 1784.0]], [[234.0, 1540.0], [276.0, 1540.0], [276.0