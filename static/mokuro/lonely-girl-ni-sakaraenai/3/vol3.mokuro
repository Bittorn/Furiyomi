 ["でもこの慎重さが思春期の", "女子メダ子のリアルなどめざ合い", "なのかな？とも思うのです。"]}, {"box": [758, 1250, 886, 1664], "vertical": true, "font_size": 30, "lines_coords": [[[846.0, 1250.0], [880.0, 1250.0], [884.0, 1646.0], [850.0, 1646.0]], [[806.0, 1256.0], [834.0, 1256.0], [834.0, 1664.0], [806.0, 1664.0]], [[758.0, 1254.0], [786.0, 1254.0], [788.0, 1574.0], [760.0, 1574.0]]], "lines": ["「空の母上が出て来て、波乱の予感を", "ですが、どうか私を信じて次者も", "楽しみにしていて下さい！！"]}, {"box": [114, 1072, 194, 1204], "vertical": true, "font_size": 39, "lines_coords": [[[156.0, 1072.0], [190.0, 1072.0], [194.0, 1204.0], [160.0, 1204.0]], [[114.0, 1072.0], [158.0, 1072.0], [158.0, 1166.0], [114.0, 1166.0]]], "lines": ["わたしも", "ですっ"]}, {"box": [174, 1320, 374, 1386], "vertical": false, "font_size": 52, "lines_coords": [[[174.0, 1334.0], [370.0, 1320.0], [374.0, 1372.0], [178.0, 1386.0]]], "lines": ["Ｓｐｅｃｉａｌ"]}, {"box": [1176, 1780, 1309, 1900], "vertical": true, "font_size": 38, "lines_coords": [[[1270.0, 1782.0], [1308.0, 1782.0], [1308.0, 1872.0], [1270.0, 1872.0]], [[1208.0, 1780.0], [1244.0, 1780.0], [1248.0, 1900.0], [1212.0, 1900.0]], [[1176.0, 1784.0], [1216.0, 1784.0], [1216.0, 1848.0], [1176.0, 1848.0]]], "lines": ["余談", "引っ越しを", "した"]}, {"box": [753, 1783, 816, 1885], "vertical": true, "font_size": 63, "lines_coords": [[[753.0, 1783.0], [816.0, 1783.0], [816.0, 1885.0], [753.0, 1885.0]]], "lines": ["めっちゃ大変だった"]}, {"box": [482, 1694, 670, 1794], "vertical": false, "font_size": 45, "lines_coords": [[[482.0, 1694.0], [660.0, 1698.0], [660.0, 1740.0], [482.0, 1736.0]], [[484.0, 1740.0], [670.0, 1746.0], [668.0, 1794.0], [482.0, 1788.0]]], "lines": ["ありがとう", "ございます！"]}, {"box": [185, 1482, 655, 1676], "vertical": false, "font_size": 80, "lines_coords": [[[246.0, 1494.0], [622.0, 1482.0], [624.0, 1566.0], [248.0, 1578.0]], [[250.0, 1600.0], [630.0, 1556.0], [638.0, 1632.0], [258.0, 1676.0]]], "lines": ["担当の内藤様", "テザインの音原様"]}], "img_path": "_0165.jpg"}, {"version": "0.2.4", "img_width": 1441, "img_height": 2048, "blocks": [{"box": [553