package pages

import "github.com/Bittorn/Furiyomi/db"
import "github.com/Bittorn/Furiyomi/components"

templ reader_css() {
    <style>
	:root {
		overflow: hidden;
		padding: 0 !important;
		margin: 0 !important;
	}

    /* this seems unnecessary */
    body {
        overflow: hidden;
        padding: 0 !important;
        margin: 0 !important;
    }

    #body {
        height: 100vh !important;
        width: 100vw !important;
    }

    #pages-container {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        width: 100vw;
        overflow: hidden;
        transform-origin: 0px 0px 0px !important;
    }

    #left-page,
    #right-page {
        z-index: 1;
        background-color: var(--button-color);
        display: inline-block;
        opacity: 0;
        position: absolute;
        top: -5%;
        width: 5%;
        height: 110%;
        transition: opacity ease 1;
        cursor: pointer;
    }

    #left-page:hover,
    #right-page:hover {
        opacity: 1;
    }

    #left-page {
        left: 0;
    }

    #right-page {
        right: 0;
    }
    </style>
}

templ Reader(dark bool, manga db.Manga, mokuro db.Mokuro, volume string) {
    @Base("Reader", dark) {
        @reader_css()
        <div id="body">
            <div id="pages-container">
                for idx, page := range mokuro.Pages {
                    @components.ReaderPage(page, idx)
                }

                <a id="left-page" onclick={templ.JSFuncCall("nextPage")} title="Go left a page"></a>
                <a id="right-page" onclick={templ.JSFuncCall("prevPage")} title="Go right a page"></a>
            </div>
        </div>
        <script defer>
            let curPageIndex = 0;
            let curPage2Index = -1;
            let mokuro = JSON.parse('{{ mokuro }}')

            async function getImage(imagePath) {
                const response = await fetch(`/api/image/{{ manga.Ref }}%2F{{ volume }}%2F${imagePath}`, {});

                return await response.json();
            }

            async function updateImages() {
                for (let i = curPageIndex - 5; i <= curPageIndex + 5; i++) {
                    if (i >= 0 && i <= pages.length - 2) {
                        const page = pages[i].getElementsByTagName('div')[0];
                        if (!page.style.backgroundImage.includes('.svg')) {
                            page.style.backgroundImage = `url('${await getImage(mokuro.pages[i].img_path)}')`;
                        }
                    }
                }
            }

            function updateTransform() {
                const scale = Math.min(
                    window.innerWidth / pagesContainer.offsetWidth,
                    window.innerHeight / pagesContainer.offsetHeight
                );

                const scaledWidth = pagesContainer.offsetWidth * scale;
                const translateX = (window.innerWidth - scaledWidth) / 2;

                pagesContainer.style.transform =
                    `translateX(${translateX}px) scale(${scale})`;
            }

            function keyDown(e) {
                switch (e.key) {
                    case 'ArrowRight':
                    case 'Right':
                        prevPage();
                        break;

                    case 'ArrowLeft':
                    case 'Left':
                        nextPage();
                        break;

                    case 'Home':
                        firstPage();
                        break;

                    case 'End':
                        lastPage();
                        break;

                    case ' ':
                        nextPage();
                        break;
                }
            }

            function isPageFirstOfPair(pageIndex) {
                return pageIndex === 0 || pageIndex % 2 === 1;
            }

            function firstPage() {
                updatePage(0);
            }

            function lastPage() {
                updatePage(pages.length - 1);
            }

            function prevPage() {
                if (curPageIndex === 1) {
                    updatePage(0);
                } else {
                    updatePage(curPageIndex - 2);
                }
            }

            function nextPage() {
                if (curPageIndex === 0) {
                    updatePage(1);
                } else {
                    updatePage(curPageIndex + 2);
                }
            }

            function updatePage(pageIndex) {
                pageIndex = Math.min(Math.max(pageIndex, 0), pages.length - 1);

                // console.log(`Updating page to: ${pageIndex}`);

                pages[curPageIndex].style.display = 'none';

                if (curPage2Index >= 0) {
                    pages[curPage2Index].style.display = 'none';
                }

                if (isPageFirstOfPair(pageIndex)) {
                    curPageIndex = pageIndex;
                    // console.log(`Page is first of pair, curPageIndex = ${curPageIndex}`);
                } else {
                    curPageIndex = pageIndex - 1;
                    // console.log(`curPageIndex = ${curPageIndex}`);
                }

                pages[curPageIndex].style.display = 'inline-block';
                pages[curPageIndex].style.order = 2;

                if (curPageIndex === 0) {
                    // cover is shown by itself
                    curPage2Index = -1;
                } else if (curPageIndex + 1 < pages.length) {
                    curPage2Index = curPageIndex + 1;
                    pages[curPage2Index].style.display = 'inline-block';
                    pages[curPage2Index].style.order = '1';
                } else {
                    curPage2Index = -1;
                }

                updateTransform();
                updateImages();
            }
            
            let pagesContainer = document.getElementById("pages-container")
            let leftPage = document.getElementById("left-page")
            let rightPage = document.getElementById("right-page")

            const loader = `url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 284"><circle fill="%23F26E84" stroke="%23F26E84" stroke-width="7" r="15" cx="40" cy="142"><animate attributeName="opacity" calcMode="spline" dur="1.2" values="1;0;1;" keySplines=".5 0 .5 1;.5 0 .5 1" repeatCount="indefinite" begin="-.4"></animate></circle><circle fill="%23F26E84" stroke="%23F26E84" stroke-width="7" r="15" cx="100" cy="142"><animate attributeName="opacity" calcMode="spline" dur="1.2" values="1;0;1;" keySplines=".5 0 .5 1;.5 0 .5 1" repeatCount="indefinite" begin="-.2"></animate></circle><circle fill="%23F26E84" stroke="%23F26E84" stroke-width="7" r="15" cx="160" cy="142"><animate attributeName="opacity" calcMode="spline" dur="1.2" values="1;0;1;" keySplines=".5 0 .5 1;.5 0 .5 1" repeatCount="indefinite" begin="0"></animate></circle></svg>')`;

            let pages = document.getElementsByClassName("page")

            for (let i = 0; i < pages.length; i++) {
                pages[i].style.backgroundImage = loader
            }

            updatePage(curPageIndex);

            window.onresize = updateTransform
            window.onkeydown = keyDown
        </script>
    }
}