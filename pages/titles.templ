package pages

import "github.com/Bittorn/Furiyomi/db"
import "github.com/Bittorn/Furiyomi/components"

templ titles_css() {
	<style>
    .searchbar {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 3rem;
        margin-top: -1rem;
    }

    .searchbar .searchicon {
		background-image: url('data:image/svg+xml;base64,');
		filter: invert(96%) sepia(20%) saturate(43%) hue-rotate(228deg) brightness(65%) contrast(80%);
		background-size: cover;
		width: 24px;
		height: 24px;
		transition: filter 0.1s ease;
    }

    .searchbar .searchicon:hover {
        filter: invert(96%) sepia(20%) saturate(43%) hue-rotate(228deg) brightness(95%) contrast(80%);
    }

    .searchbar input {
		color: var(--font-color);
		background-color: var(--header-bg-color);
		width: 8rem;
		margin-left: 8px;
		padding: 6px;
		border-radius: 6px;
		border-style: solid;
		border-color: var(--link-unfocused-color);
		transition: border-color 0.1s ease;
    }
    .searchbar input:hover {
        border-color: var(--button-hover-color);
    }

    .searchbar input:focus {
        outline: 0;
        border-color: var(--button-color);
    }

    .mangalist {
        display: grid;
        grid-template-columns: auto auto auto auto;
        gap: 1rem;
        padding: 8px;
    }

    @media only screen and (max-width: 2000px) {
        .mangalist {
            grid-template-columns: auto auto auto;
        }
    }

    @media only screen and (max-width: 1500px) {
        .mangalist {
            grid-template-columns: auto auto;
        }
    }

    @media only screen and (max-width: 1100px) {
        .mangalist {
            grid-template-columns: auto;
        }
    }
    </style>
}

templ Titles(dark bool, mangaList []db.Manga) {
	@Base("Titles", dark) {
        @titles_css()
		<h1>Titles</h1>
		<div class="searchbar">
			<div class="searchicon"></div>
			<input type="text" id="searchBar" placeholder="Search manga..."/>
		</div>

        <div class="mangalist">
            for _, manga := range mangaList {
                @components.MangaEntry(manga)
            }
        </div>

        if len(mangaList) == 0 {
            // TODO replace with better image
            <img src="/static/notfound.png" style="height: 350px"/>
            <h2>No manga found</h2>
        }
	}
}